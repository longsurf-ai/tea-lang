{
  "name": "tea-lang",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.3.10",
  "engines": {
    "bun": ">=1.3.10 <2",
    "node": ">=20"
  },
  "files": [
    "docs",
    "src",
    "website",
    "website/build",
    "README.md"
  ],
  "bin": {
    "tea": "./src/main.ts"
  },
  "exports": {
    "./codegen/wgsl": "./src/codegen/wgsl/index.ts",
    "./execution": "./src/execution/index.ts",
    "./reporting": "./src/reporting/index.ts",
    "./runtime/batch": "./src/runtime/batch/index.ts",
    "./runtime/gpu": "./src/runtime/gpu/index.ts",
    "./visualization": "./src/visualization/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "check": "bun run typecheck && bun test && bun run docs:check",
    "docs:build": "bun run docs:generate && node node_modules/@docusaurus/core/bin/docusaurus.mjs build website",
    "docs:check": "bun run docs:check:generated && bun run docs:typecheck && node node_modules/@docusaurus/core/bin/docusaurus.mjs build website",
    "docs:check:generated": "bun run website/scripts/generate-reference.ts --check",
    "docs:dev": "bun run docs:generate && node node_modules/@docusaurus/core/bin/docusaurus.mjs start website",
    "docs:generate": "bun run website/scripts/generate-reference.ts",
    "docs:serve": "node node_modules/@docusaurus/core/bin/docusaurus.mjs serve website",
    "docs:typecheck": "tsc --noEmit -p website/tsconfig.json",
    "prepack": "bun run docs:build",
    "test:gpu": "node --import tsx --test --test-concurrency=1 src/runtime/gpu/dawn.integration.ts tests/examples.gpu.integration.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "commander": "14.0.2",
    "open": "10.0.0",
    "plotly.js-gl3d-dist-min": "3.7.0",
    "tsx": "4.23.10",
    "yaml": "2.9.0"
  },
  "optionalDependencies": {
    "webgpu": "0.4.0"
  },
  "devDependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@mdx-js/react": "3.1.1",
    "@types/bun": "1.3.5",
    "@types/node": "25.0.10",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@webgpu/types": "0.1.71",
    "acorn": "8.18.0",
    "prettier": "3.8.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "5.8.3",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
