//@version=1
// Clean-room execution model of the published Turtle System strategy profile.
// It intentionally uses a strategy-local account because the published rules
// require risk-sized units, pyramiding, and same-close fills.
strategy("Turtle system", shorttitle="Turtle", overlay=true)

import broker

type TurtleAccount
	float initialCash
	float cash
	float positionQuantity = 0.0
	float averagePrice = na
	float realizedPnl = 0.0
	float equityValue
	float peakEquity
	float maxDrawdownValue = 0.0
	int fillCount = 0
	int roundTrips = 0
	int nextOrderId = 1
	int nextFillId = 1

	int buy(float price, float quantity, int barIndex, string commandId) =>
		if quantity > 0.0
			oldQuantity = this.positionQuantity
			newQuantity = oldQuantity + quantity
			oldCost = oldQuantity > 0.0 ? oldQuantity * this.averagePrice : 0.0
			this.averagePrice := (oldCost + quantity * price) / newQuantity
			this.positionQuantity := newQuantity
			this.cash := this.cash - quantity * price
			execution = broker.Fill.new(
				this.nextFillId,
				this.nextOrderId,
				commandId,
				broker.Side.buy,
				barIndex,
				price,
				price,
				quantity,
				quantity * price,
				0.0
			)
			effect.emit(broker.FillExecuted.new(execution))
			this.nextOrderId := this.nextOrderId + 1
			this.nextFillId := this.nextFillId + 1
			this.fillCount := this.fillCount + 1
		this.fillCount

	int close(float price, int barIndex, string commandId) =>
		quantity = this.positionQuantity
		if quantity > 0.0
			notional = quantity * price
			this.cash := this.cash + notional
			this.realizedPnl := this.realizedPnl + quantity * (price - this.averagePrice)
			execution = broker.Fill.new(
				this.nextFillId,
				this.nextOrderId,
				commandId,
				broker.Side.sell,
				barIndex,
				price,
				price,
				quantity,
				notional,
				0.0
			)
			effect.emit(broker.FillExecuted.new(execution))
			this.nextOrderId := this.nextOrderId + 1
			this.nextFillId := this.nextFillId + 1
			this.fillCount := this.fillCount + 1
			this.roundTrips := this.roundTrips + 1
			this.positionQuantity := 0.0
			float missing = na
			this.averagePrice := missing
		this.fillCount

	float mark(float price) =>
		this.equityValue := this.cash + this.positionQuantity * price
		if this.equityValue > this.peakEquity
			this.peakEquity := this.equityValue
		drawdown = this.peakEquity == 0.0 ? 0.0 : (this.peakEquity - this.equityValue) / this.peakEquity
		if drawdown > this.maxDrawdownValue
			this.maxDrawdownValue := drawdown
		this.equityValue

	float total_return() const =>
		(this.equityValue - this.initialCash) / this.initialCash

stop_n = input.float(2.0, "Stop distance in N", minval=0.1, maxval=10.0)
risk_percent = input.float(0.01, "Risk fraction of capital", minval=0.0001, maxval=0.25)
pyramid_n = input.float(0.5, "Pyramid spacing in N", minval=0.05, maxval=10.0)
max_units = input.int(5, "Maximum units", minval=1, maxval=20)
atr_length = input.int(14, "ATR length", minval=2, maxval=200)
l1_entry_length = input.int(20, "System 1 entry length", minval=2, maxval=300)
l2_entry_length = input.int(55, "System 2 entry length", minval=2, maxval=300)
l1_exit_length = input.int(10, "System 1 exit length", minval=2, maxval=300)
l2_exit_length = input.int(20, "System 2 exit length", minval=2, maxval=300)
initial_cash = input.float(100000.0, "Initial cash", minval=1.0)

var account = TurtleAccount.new(
	initialCash = initial_cash,
	cash = initial_cash,
	equityValue = initial_cash,
	peakEquity = initial_cash
)

previous_close = close[1]
true_range = na(previous_close) ? high - low : math.max(high - low, math.max(math.abs(high - previous_close), math.abs(low - previous_close)))
atr_seed = ta.sma(true_range, atr_length)
var float n_value = na
if na(n_value)
	n_value := atr_seed
else
	n_value := (n_value * (atr_length - 1) + true_range) / atr_length

l1_entry = ta.highest(high, l1_entry_length)
l2_entry = ta.highest(high, l2_entry_length)
l1_exit = ta.lowest(low, l1_exit_length)
l2_exit = ta.lowest(low, l2_exit_length)

valid_parameters = stop_n > 0.0 and pyramid_n > 0.0 and risk_percent > 0.0 and l1_entry_length < l2_entry_length and l1_exit_length < l2_exit_length

var bool virtual_long = false
var bool fake_trade = false
var bool last_trade_won = false
var float fake_entry_price = 0.0
var float stop_price = na
var float next_buy_price = na
var int unit_count = 0
var int system_mode = 1

was_virtual_long = virtual_long
was_fake = fake_trade
previous_mode = system_mode

l1_break = high > l1_entry[1]
l2_break = high > l2_entry[1]

if not was_virtual_long and (l1_break or l2_break)
	virtual_long := true
else
	stop_hit = was_virtual_long and low < stop_price
	l1_exit_hit = was_virtual_long and previous_mode == 1 and low < l1_exit[1]
	l2_exit_hit = was_virtual_long and previous_mode == 2 and low < l2_exit[1]
	if stop_hit or l1_exit_hit or l2_exit_hit
		virtual_long := false

if not was_virtual_long and l1_break and last_trade_won
	fake_trade := true
	fake_entry_price := close

if was_fake and was_virtual_long and not virtual_long
	fake_trade := false
	last_trade_won := close >= fake_entry_price

if l2_break
	fake_trade := false

// 0 none, 1 System 1 entry, 2 System 2 entry, 3 pyramid,
// 4 profitable exit, 5 losing exit.
level = 0
if not was_virtual_long and l1_break
	level := 1
if (not was_virtual_long or (was_virtual_long and was_fake)) and l2_break
	level := 2

if level == 1 or level == 2
	system_mode := level
	unit_count := 1
	stop_price := close - stop_n * n_value
	next_buy_price := close + pyramid_n * n_value

if level == 0 and was_virtual_long and high > next_buy_price and unit_count < max_units
	level := 3
	unit_count := unit_count + 1
	stop_price := close - stop_n * n_value
	next_buy_price := close + pyramid_n * n_value

real_position = account.positionQuantity > 0.0
if level == 0 and was_virtual_long and not fake_trade and real_position
	stop_exit = low < stop_price
	channel_exit = previous_mode == 1 ? low < l1_exit[1] : low < l2_exit[1]
	if stop_exit or channel_exit
		level := close >= account.averagePrice ? 4 : 5

if level == 4
	last_trade_won := true
if level == 5
	last_trade_won := false

risk_capital = (account.initialCash + account.realizedPnl) * risk_percent
// The published position-sizing rule defines one unit as risk capital / N.
// stop_n controls the protective exit distance, not the unit quantity.
unit_risk = n_value
shares = unit_risk > 0.0 ? math.floor(risk_capital / unit_risk) : 0.0
invested_capital = account.positionQuantity > 0.0 ? account.positionQuantity * account.averagePrice : 0.0
capital_left = account.initialCash + account.realizedPnl - invested_capital
if shares * close > capital_left
	shares := math.max(0.0, math.floor(capital_left / close))

enter_long = valid_parameters and not fake_trade and (level == 1 or level == 2 or level == 3)
exit_long = valid_parameters and (level == 4 or level == 5)

if enter_long and shares > 0.0
	command = level == 1 ? "System 1 Open" : level == 2 ? "System 2 Open" : "Pyramid Add"
	account.buy(close, shares, bar_index, command)

if exit_long
	command = level == 4 ? "Winning Close" : "Losing Close"
	account.close(close, bar_index, command)

account.mark(close)

plot(close, "close")
plot(l1_entry[1], "system 1 entry")
plot(l2_entry[1], "system 2 entry")
plot(l1_exit[1], "system 1 exit")
plot(l2_exit[1], "system 2 exit")
plot(n_value, "N")
plot(stop_price, "stop")
plot(next_buy_price, "next pyramid")
plot(fake_trade ? 1.0 : 0.0, "fake trade")
plot(account.positionQuantity, "position quantity")
plot(account.averagePrice, "average price")
plot(account.equityValue, "equity")
plot(account.realizedPnl, "realized pnl")
plot(account.fillCount, "fill count")
plot(account.roundTrips, "round trips")
plot(account.maxDrawdownValue, "maximum drawdown")
plot(account.total_return(), "total return")
