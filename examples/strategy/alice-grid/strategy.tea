//@version=1
// Clean-room historical CPU implementation of the public AliceTears Grid.
// The canonical bounded-lot portfolio makes its per-entry exits explicit.
strategy("AliceTears Grid", shorttitle="Alice Grid", overlay=true)

import broker
import portfolio
import strategy

entry_reversal_mode = input.int(1, "Entry reversal: 0 off, 1 on", minval=0, maxval=1)
grid_step_percent = input.float(1.0, "Grid step percent", minval=0.1, maxval=20.0)
maximum_steps = input.int(20, "Maximum levels per side", minval=1, maxval=100)
maximum_open_trades = input.int(100, "Maximum simultaneous open trades", minval=1, maxval=1000)
tp_reversal_mode = input.int(1, "Target reversal: 0 off, 1 on", minval=0, maxval=1)
use_trailing = input.int(1, "Trailing target: 0 off, 1 on", minval=0, maxval=1)
trailing_offset_percent = input.float(1.0, "Trailing offset percent", minval=0.1, maxval=20.0)
use_stop_loss = input.int(0, "Manual stop: 0 off, 1 on", minval=0, maxval=1)
stop_loss_multiplier = input.float(2.0, "Stop grid multiplier", minval=0.1, maxval=20.0)
use_date_filter = input.int(0, "Date filter: 0 off, 1 on", minval=0, maxval=1)
start_time = input.time(1704067200000, "Start time")
end_time = input.time(1893456000000, "End time")
cash_per_order = input.float(10.0, "Cash per grid order", minval=0.01)
initial_cash = input.float(1000.0, "Initial cash", minval=1.0)
fee_rate = input.float(0.00025, "Fee rate", minval=0.0, maxval=0.05)

var strat = strategy.configure(
	broker = broker.new(
		commission = broker.commissionRate(fee_rate)
	),
	portfolio = portfolio.lots(
		initialCash = initial_cash,
		maxOpenTrades = maximum_open_trades,
		marginLong = 0.0,
		marginShort = 0.0
	)
)
var triggered_longs = array.new<bool>(maximum_steps + 1, false)
var triggered_shorts = array.new<bool>(maximum_steps + 1, false)
var breached_longs = array.new<bool>(maximum_steps + 1, false)
var breached_shorts = array.new<bool>(maximum_steps + 1, false)
var float session_base = na
var float prior_day = na

strat.begin_immediate(bar_index)

day_key = math.floor(time / 86400000.0)
new_session = na(prior_day) or day_key != prior_day
if new_session
	session_base := open
	prior_day := day_key
	for i = 0 to maximum_steps
		triggered_longs.set(i, false)
		triggered_shorts.set(i, false)
		breached_longs.set(i, false)
		breached_shorts.set(i, false)

// Manage every per-entry lot independently. Iterating backwards makes pop
// removal deterministic and keeps array indices valid.
lot_index = strat.open_trade_count() - 1
while lot_index >= 0
	lot = strat.open_trade(lot_index)
	is_long = lot.entrySide == broker.Side.buy
	close_now = false
	policy_changed = false
	float close_price = na
	if use_stop_loss == 1 and not na(lot.stopPrice)
		stop_hit = is_long ? close <= lot.stopPrice : close >= lot.stopPrice
		if stop_hit
			close_now := true
			close_price := close
	if not close_now and use_trailing == 0
		if tp_reversal_mode == 1
			target_reversal = is_long ? close[1] > lot.targetPrice and close < lot.targetPrice : close[1] < lot.targetPrice and close > lot.targetPrice
			if target_reversal
				close_now := true
				close_price := close
		else
			target_hit = is_long ? close >= lot.targetPrice : close <= lot.targetPrice
			if target_hit
				close_now := true
				close_price := close
	if not close_now and use_trailing == 1
		if lot.trailingArmed
			lot.trailExtreme := is_long ? math.max(lot.trailExtreme, high) : math.min(lot.trailExtreme, low)
			policy_changed := true
			trail_stop = is_long ? lot.trailExtreme - lot.trailDistance : lot.trailExtreme + lot.trailDistance
			trail_hit = is_long ? low <= trail_stop : high >= trail_stop
			if trail_hit
				close_now := true
				close_price := is_long ? (open <= trail_stop ? open : trail_stop) : (open >= trail_stop ? open : trail_stop)
		else
			activation = tp_reversal_mode == 1 ? (is_long ? close[1] > lot.targetPrice and close < lot.targetPrice : close[1] < lot.targetPrice and close > lot.targetPrice) : (is_long ? high >= lot.targetPrice : low <= lot.targetPrice)
			if activation
				lot.trailingArmed := true
				lot.trailExtreme := close
				lot.trailDistance := close * trailing_offset_percent / 100.0
				policy_changed := true
	if close_now
		strat.close_trade(is_long ? "Alice long close" : "Alice short cover", lot_index, close_price)
	else if policy_changed
		strat.update_open_trade(lot_index, lot)
	lot_index := lot_index - 1

in_date_range = use_date_filter == 0 or time >= start_time and time <= end_time

for level = 1 to maximum_steps
	short_entry = session_base * (1.0 + grid_step_percent / 100.0 * level)
	short_target = session_base * (1.0 + grid_step_percent / 100.0 * (level - 1))
	short_stop = use_stop_loss == 1 ? short_entry + short_entry * grid_step_percent / 100.0 * stop_loss_multiplier : na
	if not triggered_shorts.get(level) and in_date_range
		if entry_reversal_mode == 1
			if close[1] > short_entry
				breached_shorts.set(level, true)
			if breached_shorts.get(level) and close < short_entry
				strat.entry_now("Alice short open", "Alice long close", strategy.Direction.short, close, notional = cash_per_order, tag = level, target = short_target, stop = short_stop)
				triggered_shorts.set(level, true)
		else if ta.crossover(close, short_entry)
			strat.entry_now("Alice short open", "Alice long close", strategy.Direction.short, close, notional = cash_per_order, tag = level, target = short_target, stop = short_stop)
			triggered_shorts.set(level, true)

	long_entry = session_base * (1.0 - grid_step_percent / 100.0 * level)
	long_target = session_base * (1.0 - grid_step_percent / 100.0 * (level - 1))
	long_stop = use_stop_loss == 1 ? long_entry - long_entry * grid_step_percent / 100.0 * stop_loss_multiplier : na
	if not triggered_longs.get(level) and in_date_range
		if entry_reversal_mode == 1
			if close[1] < long_entry
				breached_longs.set(level, true)
			if breached_longs.get(level) and close > long_entry
				strat.entry_now("Alice long open", "Alice short cover", strategy.Direction.long, close, notional = cash_per_order, tag = level, target = long_target, stop = long_stop)
				triggered_longs.set(level, true)
		else if ta.crossunder(close, long_entry)
			strat.entry_now("Alice long open", "Alice short cover", strategy.Direction.long, close, notional = cash_per_order, tag = level, target = long_target, stop = long_stop)
			triggered_longs.set(level, true)

strat.mark(close)
metrics = strat.snapshot()

plot(close, "close")
plot(session_base, "session base")
plot(metrics.positionQuantity, "position quantity")
plot(metrics.openTradeCount, "open lots")
plot(metrics.maxLongStack, "maximum long stack")
plot(metrics.maxShortStack, "maximum short stack")
plot(metrics.equity, "equity")
plot(metrics.realizedPnl, "realized pnl")
plot(metrics.totalFees, "total fees")
plot(metrics.fillCount, "fill count")
plot(metrics.roundTripCount, "round trips")
plot(metrics.maxDrawdown, "maximum drawdown")
plot(metrics.totalReturn, "total return")
