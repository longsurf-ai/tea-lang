//@version=1
// Clean-room historical CPU implementation of the public AliceTears Grid.
// The canonical bounded-lot portfolio owns accounting; GridPosition owns the
// strategy-specific per-entry exit policy keyed by broker fill trade id.


import broker
import portfolio
import trade

type GridPosition
	int tradeId
	broker.Side entrySide
	int tag
	float targetPrice
	float stopPrice
	bool trailingArmed = false
	float trailExtreme = na
	float trailDistance = na

entry_reversal_mode = input.int(1, "Entry reversal: 0 off, 1 on", minval=0, maxval=1)
grid_step_percent = input.float(1.0, "Grid step percent", minval=0.1, maxval=20.0)
maximum_steps = input.int(20, "Maximum levels per side", minval=1, maxval=100)
maximum_open_trades = input.int(100, "Maximum simultaneous open trades", minval=1, maxval=1000)
tp_reversal_mode = input.int(1, "Target reversal: 0 off, 1 on", minval=0, maxval=1)
use_trailing = input.int(1, "Trailing target: 0 off, 1 on", minval=0, maxval=1)
trailing_offset_percent = input.float(1.0, "Trailing offset percent", minval=0.1, maxval=20.0)
use_stop_loss = input.int(0, "Manual stop: 0 off, 1 on", minval=0, maxval=1)
stop_loss_multiplier = input.float(2.0, "Stop grid multiplier", minval=0.1, maxval=20.0)
use_date_filter = input.int(0, "Date filter: 0 off, 1 on", minval=0, maxval=1)
start_time = input.time(1704067200000, "Start time")
end_time = input.time(1893456000000, "End time")
cash_per_order = input.float(10.0, "Cash per grid order", minval=0.01)
initial_cash = input.float(1000.0, "Initial cash", minval=1.0)
fee_rate = input.float(0.00025, "Fee rate", minval=0.0, maxval=0.05)

var strat = trade.lots(
	broker = broker.new(
		commission = broker.commissionRate(fee_rate)
	),
	portfolio = portfolio.lots(
		initialCash = initial_cash,
		maxOpenTrades = maximum_open_trades,
		marginLong = 0.0,
		marginShort = 0.0
	)
)
var triggered_longs = array.new<bool>(maximum_steps + 1, false)
var triggered_shorts = array.new<bool>(maximum_steps + 1, false)
var breached_longs = array.new<bool>(maximum_steps + 1, false)
var breached_shorts = array.new<bool>(maximum_steps + 1, false)
var grid_positions = array.new<GridPosition>()
var float session_base = na
var float prior_day = na

strat.begin_bar(close, bar_index)

day_key = math.floor(time / 86400000.0)
new_session = na(prior_day) or day_key != prior_day
if new_session
	session_base := open
	prior_day := day_key
	for i = 0 to maximum_steps
		triggered_longs.set(i, false)
		triggered_shorts.set(i, false)
		breached_longs.set(i, false)
		breached_shorts.set(i, false)

// Policy state mirrors the lot portfolio's push/swap-pop order, but owns no
// accounting fields. Every mutation is confirmed by a returned broker fill.
position_index = grid_positions.size() - 1
while position_index >= 0
	grid_position = grid_positions.get(position_index)
	is_long = grid_position.entrySide == broker.Side.buy
	close_now = false
	policy_changed = false
	broker.Fill close_fill = na
	if use_stop_loss == 1 and not na(grid_position.stopPrice)
		stop_hit = is_long ? close <= grid_position.stopPrice : close >= grid_position.stopPrice
		if stop_hit
			close_now := true
	if not close_now and use_trailing == 0
		if tp_reversal_mode == 1
			target_reversal = is_long ? close[1] > grid_position.targetPrice and close < grid_position.targetPrice : close[1] < grid_position.targetPrice and close > grid_position.targetPrice
			if target_reversal
				close_now := true
		else
			target_hit = is_long ? close >= grid_position.targetPrice : close <= grid_position.targetPrice
			if target_hit
				close_now := true
	if not close_now and use_trailing == 1
		if grid_position.trailingArmed
			grid_position.trailExtreme := is_long ? math.max(grid_position.trailExtreme, high) : math.min(grid_position.trailExtreme, low)
			policy_changed := true
			trail_stop = is_long ? grid_position.trailExtreme - grid_position.trailDistance : grid_position.trailExtreme + grid_position.trailDistance
			close_fill := strat.close_trade_at_stop(is_long ? "Alice long close" : "Alice short cover", grid_position.tradeId, grid_position.entrySide, open, high, low, trail_stop)
		else
			activation = tp_reversal_mode == 1 ? (is_long ? close[1] > grid_position.targetPrice and close < grid_position.targetPrice : close[1] < grid_position.targetPrice and close > grid_position.targetPrice) : (is_long ? high >= grid_position.targetPrice : low <= grid_position.targetPrice)
			if activation
				grid_position.trailingArmed := true
				grid_position.trailExtreme := close
				grid_position.trailDistance := close * trailing_offset_percent / 100.0
				policy_changed := true
	if close_now
		close_fill := strat.close_trade(is_long ? "Alice long close" : "Alice short cover", grid_position.tradeId)
	if not na(close_fill) and close_fill.tradeId == grid_position.tradeId
		last_position = grid_positions.pop()
		if position_index < grid_positions.size()
			grid_positions.set(position_index, last_position)
	else if policy_changed
		grid_positions.set(position_index, grid_position)
	position_index := position_index - 1

in_date_range = use_date_filter == 0 or time >= start_time and time <= end_time

for level = 1 to maximum_steps
	short_entry = session_base * (1.0 + grid_step_percent / 100.0 * level)
	short_target = session_base * (1.0 + grid_step_percent / 100.0 * (level - 1))
	short_stop = use_stop_loss == 1 ? short_entry + short_entry * grid_step_percent / 100.0 * stop_loss_multiplier : na
	short_signal = false
	if not triggered_shorts.get(level) and in_date_range
		if entry_reversal_mode == 1
			if close[1] > short_entry
				breached_shorts.set(level, true)
			if breached_shorts.get(level) and close < short_entry
				short_signal := true
		else if ta.crossover(close, short_entry)
			short_signal := true
	if short_signal
		short_reversal_valid = true
		short_reverse_index = grid_positions.size() - 1
		while short_reverse_index >= 0 and short_reversal_valid
			short_reverse_position = grid_positions.get(short_reverse_index)
			if short_reverse_position.entrySide != broker.Side.sell
				short_reverse_fill = strat.close_trade("Alice long close", short_reverse_position.tradeId)
				if not na(short_reverse_fill) and short_reverse_fill.tradeId == short_reverse_position.tradeId
					short_last_position = grid_positions.pop()
					if short_reverse_index < grid_positions.size()
						grid_positions.set(short_reverse_index, short_last_position)
				else
					short_reversal_valid := false
			short_reverse_index := short_reverse_index - 1
		if short_reversal_valid
			short_fill = strat.entry("Alice short open", "Alice long close", trade.Direction.short, notional = cash_per_order)
			if not na(short_fill) and short_fill.tradeId > 0
				grid_positions.push(GridPosition.new(short_fill.tradeId, broker.Side.sell, level, short_target, short_stop))
		triggered_shorts.set(level, true)

	long_entry = session_base * (1.0 - grid_step_percent / 100.0 * level)
	long_target = session_base * (1.0 - grid_step_percent / 100.0 * (level - 1))
	long_stop = use_stop_loss == 1 ? long_entry - long_entry * grid_step_percent / 100.0 * stop_loss_multiplier : na
	long_signal = false
	if not triggered_longs.get(level) and in_date_range
		if entry_reversal_mode == 1
			if close[1] < long_entry
				breached_longs.set(level, true)
			if breached_longs.get(level) and close > long_entry
				long_signal := true
		else if ta.crossunder(close, long_entry)
			long_signal := true
	if long_signal
		long_reversal_valid = true
		long_reverse_index = grid_positions.size() - 1
		while long_reverse_index >= 0 and long_reversal_valid
			long_reverse_position = grid_positions.get(long_reverse_index)
			if long_reverse_position.entrySide != broker.Side.buy
				long_reverse_fill = strat.close_trade("Alice short cover", long_reverse_position.tradeId)
				if not na(long_reverse_fill) and long_reverse_fill.tradeId == long_reverse_position.tradeId
					long_last_position = grid_positions.pop()
					if long_reverse_index < grid_positions.size()
						grid_positions.set(long_reverse_index, long_last_position)
				else
					long_reversal_valid := false
			long_reverse_index := long_reverse_index - 1
		if long_reversal_valid
			long_fill = strat.entry("Alice long open", "Alice short cover", trade.Direction.long, notional = cash_per_order)
			if not na(long_fill) and long_fill.tradeId > 0
				grid_positions.push(GridPosition.new(long_fill.tradeId, broker.Side.buy, level, long_target, long_stop))
		triggered_longs.set(level, true)

strat.mark()
metrics = strat.snapshot()

plot("close", close, "close")
plot("session base", session_base, "session base")
plot("position quantity", metrics.positionQuantity, "position quantity")
plot("open lots", metrics.openTradeCount, "open lots")
plot("maximum long stack", metrics.maxLongStack, "maximum long stack")
plot("maximum short stack", metrics.maxShortStack, "maximum short stack")
plot("equity", metrics.equity, "equity")
plot("realized pnl", metrics.realizedPnl, "realized pnl")
plot("total fees", metrics.totalFees, "total fees")
plot("fill count", metrics.fillCount, "fill count")
plot("round trips", metrics.roundTripCount, "round trips")
plot("maximum drawdown", metrics.maxDrawdown, "maximum drawdown")
plot("total return", metrics.totalReturn, "total return")
