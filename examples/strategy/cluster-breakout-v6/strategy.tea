//@version=1
// Clean-room implementation pinned to the publication's original v6 logic.
// Fixed-size long/short positions and persistent stop orders run through Tea's
// canonical trade, broker, and portfolio components.


import broker
import portfolio
import trade

pine_rma(float source, int length) =>
	seed = ta.sma(source, length)
	var float value = na
	if na(value)
		value := seed
	else
		value := (value * (length - 1) + source) / length
	value

pine_atr(int length) =>
	previous_close = close[1]
	true_range = na(previous_close) ? high - low : math.max(high - low, math.max(math.abs(high - previous_close), math.abs(low - previous_close)))
	pine_rma(true_range, length)

cluster_length = input.int(10, "Cluster lookback", minval=2, maxval=200)
cluster_atr_length = input.int(14, "Cluster ATR length", minval=2, maxval=200)
tightness_atr = input.float(2.0, "Cluster tightness ATR multiple", minval=0.1, maxval=20.0)
require_contraction_mode = input.int(1, "Require contraction: 0 off, 1 on", minval=0, maxval=1)
contraction_lookback = input.int(20, "Contraction lookback", minval=1, maxval=300)
break_buffer_atr = input.float(0.1, "Breakout buffer ATR multiple", minval=0.0, maxval=10.0)
strong_close_mode = input.int(1, "Strong close filter: 0 off, 1 on", minval=0, maxval=1)
strong_close_percent = input.float(0.6, "Strong close threshold", minval=0.0, maxval=1.0)
volume_confirm_mode = input.int(1, "Volume confirmation: 0 off, 1 on", minval=0, maxval=1)
volume_multiple = input.float(1.3, "Volume multiple", minval=0.0, maxval=20.0)
volume_average_length = input.int(20, "Volume average length", minval=1, maxval=300)
// The checked-in daily-data profile explicitly selects the publication's
// session-off and EOD-flat-off options. Other values are rejected below.
session_mode = input.int(0, "Session profile: 0 disabled", minval=0, maxval=1)
exit_eod_mode = input.int(0, "EOD flat profile: 0 disabled", minval=0, maxval=1)
max_trades_per_day = input.int(3, "Maximum entries per day", minval=1, maxval=100)
order_size = input.float(1.0, "Order size", minval=0.000001, maxval=1000000.0)
risk_reward = input.float(2.0, "Initial target R multiple", minval=0.1, maxval=20.0)
trail_multiple = input.float(2.0, "Trailing R multiple", minval=0.1, maxval=20.0)
cooldown_bars = input.int(5, "Cooldown bars", minval=0, maxval=1000)
time_stop_mode = input.int(1, "Time stop: 0 off, 1 on", minval=0, maxval=1)
time_stop_bars = input.int(20, "Time stop bars", minval=1, maxval=1000)
trend_filter_mode = input.int(0, "Trend filter: 0 off, 1 on", minval=0, maxval=1)
ema_length = input.int(200, "Trend EMA length", minval=1, maxval=1000)
adx_length = input.int(14, "ADX length", minval=2, maxval=200)
adx_minimum = input.float(20.0, "Minimum ADX", minval=0.0, maxval=100.0)
initial_cash = input.float(100000.0, "Initial cash", minval=1.0)

var strat = trade.ohlc(
	broker = broker.new(
		commission = broker.commissionRate(0.0),
		slippage = broker.slippageRate(0.0),
		processOrdersOnClose = true
	),
	portfolio = portfolio.new(
		initialCash = initial_cash,
		pyramiding = 1,
		marginLong = 0.0,
		marginShort = 0.0
	)
)
float missing_value = na

var float box_top = na
var float box_bottom = na
var bool box_active = false
var float current_stop = na
var float target_line = na
var float strategy_entry_price = na
var float initial_risk = na
var int stage = 0
var int bars_in_trade = 0
var int last_exit_bar = na
var float last_day_bucket = na
var int trades_today = 0

// Resolve the resting stop submitted at an earlier close. The canonical
// broker owns its gap and intrabar fill rules.
matches = strat.begin_bar(open, high, low, bar_index)
stopped_this_bar = not na(matches.exit)
if stopped_this_bar
	last_exit_bar := bar_index

position_at_calculation = strat.position_quantity()

atr_value = pine_atr(cluster_atr_length)
cluster_high = ta.highest(high, cluster_length)
cluster_low = ta.lowest(low, cluster_length)
cluster_range = cluster_high - cluster_low
is_tight = cluster_range <= atr_value * tightness_atr
contracting = require_contraction_mode == 0 or atr_value < atr_value[contraction_lookback]
is_cluster = is_tight and contracting

volume_average = ta.sma(volume, volume_average_length)
has_volume = not na(volume) and volume > 0.0
volume_ok = volume_confirm_mode == 0 or not has_volume or volume > volume_average * volume_multiple

ema_trend = ta.ema(close, ema_length)
up_move = high - high[1]
down_move = low[1] - low
plus_dm = up_move > down_move and up_move > 0.0 ? up_move : 0.0
minus_dm = down_move > up_move and down_move > 0.0 ? down_move : 0.0
adx_previous_close = close[1]
adx_true_range = na(adx_previous_close) ? high - low : math.max(high - low, math.max(math.abs(high - adx_previous_close), math.abs(low - adx_previous_close)))
tr_rma = pine_rma(adx_true_range, adx_length)
plus_di = 100.0 * pine_rma(plus_dm, adx_length) / tr_rma
minus_di = 100.0 * pine_rma(minus_dm, adx_length) / tr_rma
dx = 100.0 * math.abs(plus_di - minus_di) / (plus_di + minus_di)
adx_value = pine_rma(dx, adx_length)
trend_long_ok = trend_filter_mode == 0 or (close > ema_trend and adx_value > adx_minimum)
trend_short_ok = trend_filter_mode == 0 or (close < ema_trend and adx_value > adx_minimum)

new_cluster = is_cluster and (na(box_top) or box_top != cluster_high or box_bottom != cluster_low or not box_active)
if new_cluster
	box_top := cluster_high
	box_bottom := cluster_low
	box_active := true

day_bucket = math.floor(time / 86400000.0)
if na(last_day_bucket) or day_bucket != last_day_bucket
	trades_today := 0
	last_day_bucket := day_bucket

in_cooldown = not na(last_exit_bar) and bar_index - last_exit_bar < cooldown_bars
bar_range = high - low
close_position = bar_range > 0.0 ? (close - low) / bar_range : 0.5
strong_long = strong_close_mode == 0 or close_position >= strong_close_percent
strong_short = strong_close_mode == 0 or close_position <= 1.0 - strong_close_percent
buffer = atr_value * break_buffer_atr
long_break = box_active and close > box_top + buffer and close[1] <= box_top[1] + buffer[1]
short_break = box_active and close < box_bottom - buffer and close[1] >= box_bottom[1] - buffer[1]

valid_profile = session_mode == 0 and exit_eod_mode == 0 and strong_close_percent >= 0.0 and strong_close_percent <= 1.0
can_trade = valid_profile and trades_today < max_trades_per_day and not in_cooldown
long_signal = long_break and can_trade and trend_long_ok and volume_ok and strong_long
short_signal = short_break and can_trade and trend_short_ok and volume_ok and strong_short
long_risk = close - box_bottom
short_risk = box_top - close

entered_this_bar = false
if position_at_calculation == 0.0 and long_signal and long_risk > 0.0
	strat.entry("Cluster Position", trade.Direction.long, qty = order_size)
	execution = strat.process_close(close)
	if not na(execution)
		strategy_entry_price := close
		initial_risk := long_risk
		current_stop := box_bottom
		target_line := close + long_risk * risk_reward
		stage := 0
		bars_in_trade := 0
		trades_today := trades_today + 1
		entered_this_bar := true

if position_at_calculation == 0.0 and not entered_this_bar and short_signal and short_risk > 0.0
	strat.entry("Cluster Position", trade.Direction.short, qty = order_size)
	execution = strat.process_close(close)
	if not na(execution)
		strategy_entry_price := close
		initial_risk := short_risk
		current_stop := box_top
		target_line := close - short_risk * risk_reward
		stage := 0
		bars_in_trade := 0
		trades_today := trades_today + 1
		entered_this_bar := true

closed_on_time = false
if position_at_calculation > 0.0
	bars_in_trade := bars_in_trade + 1
	profit = close - strategy_entry_price
	if stage == 0 and profit >= initial_risk
		stage := 1
		current_stop := math.max(current_stop, strategy_entry_price)
	if stage <= 1 and profit >= initial_risk * risk_reward
		stage := 2
		current_stop := math.max(current_stop, strategy_entry_price + initial_risk * trail_multiple)
	if stage == 2
		current_stop := math.max(current_stop, close - initial_risk * trail_multiple)
	if time_stop_mode == 1 and stage == 0 and bars_in_trade >= time_stop_bars
		strat.close("Cluster Time Close")
		execution = strat.process_close(close)
		if not na(execution)
			last_exit_bar := bar_index
			closed_on_time := true
	else
		strat.exit("Cluster Stop", fromEntry = "Cluster Position", stop = current_stop)

if position_at_calculation < 0.0
	bars_in_trade := bars_in_trade + 1
	profit = strategy_entry_price - close
	if stage == 0 and profit >= initial_risk
		stage := 1
		current_stop := math.min(current_stop, strategy_entry_price)
	if stage <= 1 and profit >= initial_risk * risk_reward
		stage := 2
		current_stop := math.min(current_stop, strategy_entry_price - initial_risk * trail_multiple)
	if stage == 2
		current_stop := math.min(current_stop, close + initial_risk * trail_multiple)
	if time_stop_mode == 1 and stage == 0 and bars_in_trade >= time_stop_bars
		strat.close("Cluster Time Close")
		execution = strat.process_close(close)
		if not na(execution)
			last_exit_bar := bar_index
			closed_on_time := true
	else
		strat.exit("Cluster Stop", fromEntry = "Cluster Position", stop = current_stop)

if strat.position_quantity() == 0.0 and not entered_this_bar
	strategy_entry_price := missing_value
	initial_risk := missing_value
	current_stop := missing_value
	target_line := missing_value
	stage := 0
	bars_in_trade := 0

strat.mark(close)
strat.finish(barstate.islast)
metrics = strat.snapshot()

plot("close", close, "close")
plot("cluster top", box_top, "cluster top")
plot("cluster bottom", box_bottom, "cluster bottom")
plot("active stop", metrics.positionQuantity != 0.0 ? current_stop : na, "active stop")
plot("target line", metrics.positionQuantity != 0.0 ? target_line : na, "target line")
plot("long signal", long_signal ? 1.0 : 0.0, "long signal")
plot("short signal", short_signal ? 1.0 : 0.0, "short signal")
plot("signed position", metrics.positionQuantity, "signed position")
plot("equity", metrics.equity, "equity")
plot("realized pnl", metrics.realizedPnl, "realized pnl")
plot("fill count", metrics.fillCount, "fill count")
plot("round trips", metrics.roundTripCount, "round trips")
plot("maximum drawdown", metrics.maxDrawdown, "maximum drawdown")
plot("total return", metrics.totalReturn, "total return")
