//@version=1


import broker
import portfolio
import trade

fast_length = input.int(5, "Fast EMA length", minval=2, maxval=20)
slow_length = input.int(13, "Slow EMA length", minval=3, maxval=60)
initial_cash = input.float(100000.0, "Initial cash", minval=1.0)
slippage = input.float(0.0005, "Adverse slippage rate", minval=0.0, maxval=0.05)
fee = input.float(0.001, "Taker fee rate", minval=0.0, maxval=0.05)

var strat = trade.nextOpen(
	broker = broker.new(
		commission = broker.commissionRate(fee),
		slippage = broker.slippageRate(slippage),
		processOrdersOnClose = false
	),
	portfolio = portfolio.new(
		initialCash = initial_cash,
		pyramiding = 1,
		marginLong = 100.0,
		marginShort = 100.0
	)
)

strat.begin_bar(open, bar_index)

fast_value = ta.ema(close, fast_length)
slow_value = ta.ema(close, slow_length)
crossed_above = ta.crossover(fast_value, slow_value)
crossed_below = ta.crossunder(fast_value, slow_value)

valid_lengths = fast_length < slow_length

if valid_lengths and crossed_above and strat.position_quantity() == 0.0 and not strat.has_pending()
	strat.entry("EMA Long", trade.Direction.long)

if valid_lengths and crossed_below and strat.position_quantity() > 0.0 and not strat.has_pending()
	strat.close("EMA Long")

strat.end_bar(close, false)
metrics = strat.snapshot()

plot("close", close, "close")
plot("fast ema", fast_value, "fast ema")
plot("slow ema", slow_value, "slow ema")
plot("long signal", crossed_above ? 1.0 : 0.0, "long signal")
plot("close signal", crossed_below ? 1.0 : 0.0, "close signal")
plot("position quantity", metrics.positionQuantity, "position quantity")
plot("equity", metrics.equity, "equity")
plot("realized pnl", metrics.realizedPnl, "realized pnl")
plot("total fees", metrics.totalFees, "total fees")
plot("fill count", metrics.fillCount, "fill count")
plot("round trips", metrics.roundTripCount, "round trips")
plot("maximum drawdown", metrics.maxDrawdown, "maximum drawdown")
plot("total return", metrics.totalReturn, "total return")
