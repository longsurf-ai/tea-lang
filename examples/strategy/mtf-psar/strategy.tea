//@version=1
// Clean-room conversion of the inspected current Multi-Timeframe Parabolic SAR
// v2.0 source, including its two-sided close-then-reverse order sequence.


import broker
import portfolio
import trade

request_symbol = input.symbol("BTC-USD", "Requested symbol equivalent")
higher_timeframe = input.timeframe("D", "Higher timeframe")
condition_source_mode = input.int(0, "Condition source: 0 higher, 1 current, 2 both", minval=0, maxval=2)
sar_start = input.float(0.02, "SAR start", minval=0.001, maxval=1.0)
sar_increment = input.float(0.02, "SAR increment", minval=0.001, maxval=1.0)
sar_maximum = input.float(0.2, "SAR maximum", minval=0.01, maxval=1.0)
use_stop_loss = input.int(1, "Use stop loss: 0 off, 1 on", minval=0, maxval=1)
stop_loss_percent = input.float(1.0, "Stop loss (%)", minval=0.1, maxval=25.0)
use_trailing_stop = input.int(0, "Use trailing stop: 0 off, 1 on", minval=0, maxval=1)
trailing_stop_percent = input.float(0.5, "Trailing offset (%)", minval=0.1, maxval=25.0)
use_take_profit = input.int(0, "Use take profit: 0 off, 1 on", minval=0, maxval=1)
take_profit_percent = input.float(2.0, "Take profit (%)", minval=0.1, maxval=100.0)
initial_cash = input.float(10000.0, "Initial cash", minval=1.0)
commission_percent = input.float(0.1, "Commission (%)", minval=0.0, maxval=10.0)

var strat = trade.nextOpen(
	broker = broker.new(
		commission = broker.commissionPercent(commission_percent),
		slippage = broker.slippageRate(0.0),
		processOrdersOnClose = false
	),
	portfolio = portfolio.new(
		initialCash = initial_cash,
		pyramiding = 1,
		marginLong = 0.0,
		marginShort = 0.0
	)
)
var float stop_loss_price = na
var float take_profit_price = na
var float trailing_stop = na
float missing_value = na

strat.begin_bar(open, bar_index)
if strat.position_quantity() == 0.0
	stop_loss_price := missing_value
	take_profit_price := missing_value
	trailing_stop := missing_value

current_sar = ta.sar(sar_start, sar_increment, sar_maximum)
// The inspected v2.0 source makes the higher interval available from its
// start, despite the page describing a strategy that waits for completion.
higher_sar = request.security(
	request_symbol,
	higher_timeframe,
	ta.sar(sar_start, sar_increment, sar_maximum),
	availability = "start"
)

higher_long = close > higher_sar
higher_short = close < higher_sar
current_long = close > current_sar
current_short = close < current_sar
long_signal = condition_source_mode == 0 ? higher_long : condition_source_mode == 1 ? current_long : higher_long and current_long
short_signal = condition_source_mode == 0 ? higher_short : condition_source_mode == 1 ? current_short : higher_short and current_short

// This occurs before signal handling in the Pine source.
if strat.position_quantity() > 0.0
	if use_stop_loss == 1
		stop_loss_price := strat.position_avg_price() * (1.0 - stop_loss_percent / 100.0)
	if use_take_profit == 1
		take_profit_price := strat.position_avg_price() * (1.0 + take_profit_percent / 100.0)
	if use_trailing_stop == 1
		// Exact source behavior: math.max(na, candidate) remains na, so
		// the trailing state never bootstraps after an entry reset.
		trailing_stop := math.max(trailing_stop, close * (1.0 - trailing_stop_percent / 100.0))
		stop_loss_price := math.max(stop_loss_price, trailing_stop)
else if strat.position_quantity() < 0.0
	if use_stop_loss == 1
		stop_loss_price := strat.position_avg_price() * (1.0 + stop_loss_percent / 100.0)
	if use_take_profit == 1
		take_profit_price := strat.position_avg_price() * (1.0 - take_profit_percent / 100.0)
	if use_trailing_stop == 1
		trailing_stop := math.min(trailing_stop, close * (1.0 + trailing_stop_percent / 100.0))
		stop_loss_price := math.min(stop_loss_price, trailing_stop)

if long_signal
	if strat.position_quantity() <= 0.0 and not strat.has_pending()
		strat.entry("MTF Position", trade.Direction.long, sizing = trade.percentOfEquityAtFill(100.0))
	// The source resets these on every true condition, even when pyramiding=0
	// rejects a redundant same-direction entry.
	stop_loss_price := missing_value
	take_profit_price := missing_value
	trailing_stop := missing_value

if short_signal
	if strat.position_quantity() >= 0.0 and not strat.has_pending()
		strat.entry("MTF Position", trade.Direction.short, sizing = trade.percentOfEquityAtFill(100.0))
	stop_loss_price := missing_value
	take_profit_price := missing_value
	trailing_stop := missing_value

// Close-tested exits are next-open market orders. Under the source-default
// Higher mode, one directional condition is normally true and has just reset
// these levels, which is why the nominally enabled stop is usually inert.
if strat.position_quantity() > 0.0 and not strat.has_pending()
	if use_stop_loss == 1 and close <= stop_loss_price
		strat.close("MTF Exit")
	else if use_take_profit == 1 and close >= take_profit_price
		strat.close("MTF Exit")
if strat.position_quantity() < 0.0 and not strat.has_pending()
	if use_stop_loss == 1 and close >= stop_loss_price
		strat.close("MTF Exit")
	else if use_take_profit == 1 and close <= take_profit_price
		strat.close("MTF Exit")

strat.mark(close)
strat.finish(barstate.islast)
metrics = strat.snapshot()

plot("close", close, "close")
plot("current SAR", current_sar, "current SAR")
plot("higher-timeframe SAR", higher_sar, "higher-timeframe SAR")
plot("long signal", long_signal ? 1.0 : 0.0, "long signal")
plot("short signal", short_signal ? 1.0 : 0.0, "short signal")
plot("signed position quantity", metrics.positionQuantity, "signed position quantity")
plot("equity", metrics.equity, "equity")
plot("realized pnl", metrics.realizedPnl, "realized pnl")
plot("total fees", metrics.totalFees, "total fees")
plot("fill count", metrics.fillCount, "fill count")
plot("round trips", metrics.roundTripCount, "round trips")
plot("win rate", metrics.winRate, "win rate")
plot("profit factor", metrics.profitFactor, "profit factor")
plot("maximum drawdown", metrics.maxDrawdown, "maximum drawdown")
plot("total return", metrics.totalReturn, "total return")
