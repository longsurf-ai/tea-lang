//@version=1
// Clean-room ATR ZigZag breakout using Tea's canonical scalar broker,
// portfolio, and deterministic OHLC path replay.
strategy("ATR ZigZag breakout", shorttitle="ATR ZigZag", overlay=true)

import broker
import portfolio
import strategy

pine_rma(float source, int length) =>
	seed = ta.sma(source, length)
	var float value = na
	if na(value)
		value := seed
	else
		value := (value * (length - 1) + source) / length
	value

pine_atr(int length) =>
	previous_close = close[1]
	true_range = na(previous_close) ? high - low : math.max(high - low, math.max(math.abs(high - previous_close), math.abs(low - previous_close)))
	pine_rma(true_range, length)

zigzag_atr_length = input.int(50, "ZigZag ATR length", minval=1, maxval=300)
zigzag_atr_multiple = input.float(3.0, "ZigZag ATR multiple", minval=0.1, maxval=20.0)
stop_atr_multiple = input.float(1.0, "Stop ATR multiple", minval=0.1, maxval=20.0)
risk_reward = input.float(2.0, "Reward multiple", minval=0.1, maxval=20.0)
trading_window_mode = input.int(0, "Trading window profile: 0 disabled", minval=0, maxval=1)
initial_cash = input.float(50000.0, "Initial cash", minval=1.0)

var strat = strategy.configure(
	broker = broker.new(
		commission = broker.commissionRate(0.0),
		slippage = broker.slippageRate(0.0)
	),
	portfolio = portfolio.new(
		initialCash = initial_cash,
		pyramiding = 1,
		marginLong = 0.0,
		marginShort = 0.0
	)
)
var float pending_stop = na
var float pending_target = na
var float active_stop = na
var float active_target = na

// Existing orders are replayed through the deterministic bar path before the
// completed bar updates the ZigZag state and replaces pending orders.
primary = strat.begin_path_primary(open, high, low, close, bar_index)
if not na(primary.pending) and strat.position_quantity() != 0.0
	active_stop := pending_stop
	active_target := pending_target
	float no_pending = na
	pending_stop := no_pending
	pending_target := no_pending
exit_execution = strat.process_path_exit(open, high, low, close)
if not na(exit_execution)
	float no_active = na
	active_stop := no_active
	active_target := no_active

atr_value = pine_atr(zigzag_atr_length)
threshold = atr_value * zigzag_atr_multiple

var int zigzag_direction = 0
var float high_since_low = na
var float low_since_high = na
var float last_high_level = na
var float last_low_level = na
var int high_since_low_index = -1
var int low_since_high_index = -1
var int last_high_index = -1
var int last_low_index = -1
var bool is_new_high = false
var bool is_new_low = false
var bool high_broken = true
var bool low_broken = true

if bar_index == 0
	zigzag_direction := 0
	float missing = na
	high_since_low := missing
	low_since_high := missing
	last_high_level := missing
	last_low_level := missing
	high_since_low_index := -1
	low_since_high_index := -1
	last_high_index := -1
	last_low_index := -1
	is_new_high := false
	is_new_low := false
else if bar_index == 1
	high_since_low := high
	low_since_high := low
	high_since_low_index := bar_index
	low_since_high_index := bar_index
	zigzag_direction := 0
	is_new_high := false
	is_new_low := false
else
	previous_direction = zigzag_direction
	is_new_high := false
	is_new_low := false
	if previous_direction == 0
		high_since_low := na(high_since_low) ? high : math.max(high_since_low, high)
		low_since_high := na(low_since_high) ? low : math.min(low_since_high, low)
		if high_since_low - open > threshold
			zigzag_direction := 1
			low_since_high := high
			low_since_high_index := bar_index
		else if open - low_since_high > threshold
			zigzag_direction := -1
			high_since_low := low
			high_since_low_index := bar_index
	else if previous_direction == 1
		if high >= high_since_low
			high_since_low := high
			high_since_low_index := bar_index
			low_since_high := high
			low_since_high_index := bar_index
		else if low <= low_since_high
			low_since_high := low
			low_since_high_index := bar_index
		if high_since_low - low_since_high > threshold
			zigzag_direction := -1
			last_high_level := high_since_low
			last_high_index := high_since_low_index
			is_new_high := true
			high_since_low := high
			high_since_low_index := bar_index
	else if previous_direction == -1
		if low <= low_since_high
			high_since_low := low
			high_since_low_index := bar_index
			low_since_high := low
			low_since_high_index := bar_index
		else if high >= high_since_low
			high_since_low := high
			high_since_low_index := bar_index
		if high_since_low - low_since_high > threshold
			zigzag_direction := 1
			last_low_level := low_since_high
			last_low_index := low_since_high_index
			is_new_low := true
			low_since_high := low
			low_since_high_index := bar_index
	is_new_low := is_new_low

if is_new_high
	high_broken := false
else
	high_broken := high_broken
if is_new_low
	low_broken := false
else
	low_broken := low_broken
if not na(last_high_level) and high >= last_high_level
	high_broken := true
else
	high_broken := high_broken
if not na(last_low_level) and low <= last_low_level
	low_broken := true
else
	low_broken := low_broken

base_long = zigzag_direction == 1 and not high_broken and not is_new_low
base_short = zigzag_direction == -1 and not low_broken and not is_new_high
valid_profile = trading_window_mode == 0

if zigzag_direction == 1
	if strat.cancel("Short Open") > 0
		float no_short_pending = na
		pending_stop := no_short_pending
		pending_target := no_short_pending
if zigzag_direction == -1
	if strat.cancel("Long Open") > 0
		float no_long_pending = na
		pending_stop := no_long_pending
		pending_target := no_long_pending

if strat.position_quantity() == 0.0 and valid_profile
	if base_long and not na(last_high_level)
		stop_distance = stop_atr_multiple * atr_value
		pending_stop := last_high_level - stop_distance
		pending_target := last_high_level + risk_reward * stop_distance
		strat.entry("Long Open", strategy.Direction.long, qty = 1.0, stop = last_high_level)
		strat.exit("Long Bracket", fromEntry = "Long Open", stop = pending_stop, target = pending_target, activateOnEntryBar = true)
	else if base_short and not na(last_low_level)
		stop_distance = stop_atr_multiple * atr_value
		pending_stop := last_low_level + stop_distance
		pending_target := last_low_level - risk_reward * stop_distance
		strat.entry("Short Open", strategy.Direction.short, qty = 1.0, stop = last_low_level)
		strat.exit("Short Bracket", fromEntry = "Short Open", stop = pending_stop, target = pending_target, activateOnEntryBar = true)

strat.mark(close)
strat.finish(barstate.islast)

plot(close, "close")
plot(base_long ? last_high_level : na, "candidate long")
plot(base_short ? last_low_level : na, "candidate short")
plot(strat.position_quantity() != 0.0 ? active_stop : na, "active stop")
plot(strat.position_quantity() != 0.0 ? active_target : na, "active target")
plot(strat.position_quantity(), "signed position")
plot(strat.position_avg_price(), "entry price")
plot(strat.equity(), "equity")
plot(strat.realized_pnl(), "realized pnl")
plot(strat.fill_count(), "fill count")
plot(strat.round_trip_count(), "round trips")
plot(strat.max_drawdown(), "maximum drawdown")
plot(strat.total_return(), "total return")
