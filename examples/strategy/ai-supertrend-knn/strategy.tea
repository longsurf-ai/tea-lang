//@version=1
// Clean-room conversion of the inspected AI Volume SuperTrend strategy. This
// example pins its published WMA source and Long trading-direction modes.
strategy("AI SuperTrend KNN — WMA long mode", shorttitle="AI ST KNN Long", overlay=true)

import broker
import portfolio
import trade

pine_rma(float source, int length) =>
	seed = ta.sma(source, length)
	var float value = na
	if na(value)
		value := seed
	else
		value := (value * (length - 1) + source) / length
	value

pine_atr(int length) =>
	previous_close = close[1]
	true_range = na(previous_close) ? high - low : math.max(high - low, math.max(math.abs(high - previous_close), math.abs(low - previous_close)))
	pine_rma(true_range, length)

distance(float x1, float x2) =>
	math.abs(x1 - x2)

knn_weighted(array<float> data, array<int> labels, int k, float x) =>
	n = data.size()
	distances = array.new<float>(n, 0.0)
	indices = array.new<int>(n, 0)
	for i = 0 to n - 1
		distances.set(i, distance(x, data.get(i)))
		indices.set(i, i)
	if n > 1
		for i = 0 to n - 2
			for j = 0 to n - i - 2
				if distances.get(j) > distances.get(j + 1)
					tempDistance = distances.get(j)
					distances.set(j, distances.get(j + 1))
					distances.set(j + 1, tempDistance)
					tempIndex = indices.get(j)
					indices.set(j, indices.get(j + 1))
					indices.set(j + 1, tempIndex)
	weightedSum = 0.0
	totalWeight = 0.0
	for i = 0 to k - 1
		index = indices.get(i)
		weight = 1.0 / (distances.get(i) + 0.000001)
		weightedSum += weight * labels.get(index)
		totalWeight += weight
	weightedSum / totalWeight

neighbors = input.int(3, "KNN neighbors", minval=1, maxval=100)
data_points = input.int(10, "KNN data points", minval=1, maxval=100)
price_trend_length = input.int(20, "Price WMA length", minval=2, maxval=500)
prediction_trend_length = input.int(100, "SuperTrend WMA length", minval=2, maxval=500)
supertrend_length = input.int(10, "SuperTrend length", minval=1, maxval=200)
supertrend_factor = input.float(3.0, "SuperTrend ATR factor", minval=0.1, maxval=20.0)
initial_cash = input.float(10000.0, "Initial cash", minval=1.0)
allocation_percent = input.float(10.0, "Entry equity percent", minval=0.1, maxval=100.0)
commission_percent = input.float(0.1, "Commission (%)", minval=0.0, maxval=10.0)
tick_size = input.float(0.01, "Instrument tick size", minval=0.00000001)

var strat = trade.net(
	broker = broker.new(
		commission = broker.commissionPercent(commission_percent),
		slippage = broker.slippageTicks(1.0, tick_size),
		processOrdersOnClose = false
	),
	portfolio = portfolio.new(
		initialCash = initial_cash,
		pyramiding = 1,
		// The publication treats commission as an extra charge outside the
		// requested equity allocation, including at a 100% allocation.
		marginLong = 0.0,
		marginShort = 0.0
	)
)
// Display-only mirror of the live stop; matching remains broker-owned.
var float display_active_stop = na

// The canonical broker fills a pending market entry first, then evaluates its
// attached stop against the same bar's open/low path.
strat.begin_bar(open, high, low, bar_index)
if strat.position_quantity() == 0.0 and not strat.has_pending_entry()
	float no_active_stop = na
	display_active_stop := no_active_stop

// The selected published moving-average mode is WMA. Its central SuperTrend
// source is volume-weighted by explicitly smoothing close*volume and volume.
central = ta.wma(close * volume, supertrend_length) / ta.wma(volume, supertrend_length)
atr_value = pine_atr(supertrend_length)
raw_upper = central + supertrend_factor * atr_value
raw_lower = central - supertrend_factor * atr_value
var float lower_band = na
var float upper_band = na
previous_lower = nz(lower_band[1])
previous_upper = nz(upper_band[1])
lower_band := raw_lower > previous_lower or close[1] < previous_lower ? raw_lower : previous_lower
upper_band := raw_upper < previous_upper or close[1] > previous_upper ? raw_upper : previous_upper

var int direction = na
var float supertrend = na
previous_supertrend = supertrend[1]
if na(atr_value[1])
	direction := 1
else if previous_supertrend == previous_upper
	direction := close > upper_band ? -1 : 1
else
	direction := close < lower_band ? 1 : -1
supertrend := direction == -1 ? lower_band : upper_band

price_trend = ta.wma(close, price_trend_length)
prediction_trend = ta.wma(supertrend, prediction_trend_length)
n = math.max(neighbors, data_points)
float missing = na
data = array.new<float>(n, missing)
labels = array.new<int>(n, 0)
for i = 0 to n - 1
	data.set(i, supertrend[i])
	labels.set(i, price_trend[i] > prediction_trend[i] ? 1 : 0)

classification = knn_weighted(data, labels, neighbors, supertrend)
bullish_class = classification == 1.0
bearish_class = classification == 0.0
start_trend_up = bullish_class and not bullish_class[1]
start_trend_down = bearish_class and not bearish_class[1]
trend_up = direction == -1 and direction[1] == 1 and bullish_class
trend_down = direction == 1 and direction[1] == -1 and bearish_class
long_signal = start_trend_up or trend_up
short_signal = start_trend_down or trend_down

aligned_bullish = direction == -1 and bullish_class
aligned_bearish = direction == 1 and bearish_class
// This expression intentionally preserves the source's initialized-false /
// else-if control flow: neither aligned branch enables the long exit update.
long_exit_condition = not aligned_bullish and not aligned_bearish
long_stop = supertrend - atr_value * supertrend_factor

if long_signal and strat.position_quantity() == 0.0 and not strat.has_pending_entry()
	strat.entry("AI Long", trade.Direction.long, sizing = trade.percentOfEquity(allocation_percent))

// Skipping this call is the Pine `when=false` behavior: the last submitted
// stop remains live rather than being cancelled or replaced.
if long_exit_condition and not na(long_stop) and (strat.position_quantity() > 0.0 or strat.has_pending_entry())
	strat.exit("AI Long Stop", fromEntry = "AI Long", stop = long_stop, activateOnEntryBar = true)
	display_active_stop := long_stop

strat.end(close, barstate.islast)
metrics = strat.snapshot()

plot(close, "close")
plot(supertrend, "volume supertrend")
plot(classification, "KNN classification")
plot(long_stop, "long stop candidate")
plot(display_active_stop, "active stop")
plot(long_signal ? 1.0 : 0.0, "long signal")
plot(short_signal ? 1.0 : 0.0, "short signal")
plot(metrics.positionQuantity, "position quantity")
plot(metrics.equity, "equity")
plot(metrics.realizedPnl, "realized pnl")
plot(metrics.totalFees, "total fees")
plot(metrics.fillCount, "fill count")
plot(metrics.roundTripCount, "round trips")
plot(metrics.maxDrawdown, "maximum drawdown")
plot(metrics.totalReturn, "total return")
