//@version=1
// Clean-room conversion of the inspected AI Volume SuperTrend strategy. This
// example pins its published WMA source and Long trading-direction modes.
strategy("AI SuperTrend KNN — WMA long mode", shorttitle="AI ST KNN Long", overlay=true)

import broker

pine_rma(float source, int length) =>
	seed = ta.sma(source, length)
	var float value = na
	if na(value)
		value := seed
	else
		value := (value * (length - 1) + source) / length
	value

pine_atr(int length) =>
	previous_close = close[1]
	true_range = na(previous_close) ? high - low : math.max(high - low, math.max(math.abs(high - previous_close), math.abs(low - previous_close)))
	pine_rma(true_range, length)

distance(float x1, float x2) =>
	math.abs(x1 - x2)

knn_weighted(array<float> data, array<int> labels, int k, float x) =>
	n = data.size()
	distances = array.new<float>(n, 0.0)
	indices = array.new<int>(n, 0)
	for i = 0 to n - 1
		distances.set(i, distance(x, data.get(i)))
		indices.set(i, i)
	if n > 1
		for i = 0 to n - 2
			for j = 0 to n - i - 2
				if distances.get(j) > distances.get(j + 1)
					tempDistance = distances.get(j)
					distances.set(j, distances.get(j + 1))
					distances.set(j + 1, tempDistance)
					tempIndex = indices.get(j)
					indices.set(j, indices.get(j + 1))
					indices.set(j + 1, tempIndex)
	weightedSum = 0.0
	totalWeight = 0.0
	for i = 0 to k - 1
		index = indices.get(i)
		weight = 1.0 / (distances.get(i) + 0.000001)
		weightedSum += weight * labels.get(index)
		totalWeight += weight
	weightedSum / totalWeight

// A strategy-local execution engine preserves the publication's 10%-of-equity
// sizing, one-tick adverse slippage, percent commission, and persistent stop
// order without expanding Tea's shared reference broker.
type LongStopEngine
	float initialCash
	float allocationRate
	float tickSize
	float feeRate
	float cashValue = 0.0
	float positionQuantity = 0.0
	float entryPrice = na
	float entryFee = 0.0
	float equityValue = 0.0
	float peakEquity = 0.0
	float maximumDrawdown = 0.0
	float realizedPnl = 0.0
	float totalFees = 0.0
	float activeStop = na
	int fills = 0
	int roundTrips = 0
	int nextOrderId = 1
	int nextFillId = 1
	int pendingEntryBar = -1
	float pendingEntryNotional = 0.0

	bool is_flat() const =>
		this.positionQuantity == 0.0

	bool has_pending_entry() const =>
		this.pendingEntryBar >= 0

	int submit_entry(int signalBarIndex) =>
		if this.positionQuantity == 0.0 and this.pendingEntryBar < 0
			this.pendingEntryBar := signalBarIndex
			this.pendingEntryNotional := this.equityValue * this.allocationRate
		this.pendingEntryBar

	int emit_entry(float referencePrice, int barIndex) =>
		price = referencePrice + this.tickSize
		quantity = this.pendingEntryNotional / price
		notional = quantity * price
		fee = notional * this.feeRate
		execution = broker.Fill.new(this.nextFillId, this.nextOrderId, "AI Long", broker.Side.buy, barIndex, referencePrice, price, quantity, notional, fee)
		this.nextFillId := this.nextFillId + 1
		this.nextOrderId := this.nextOrderId + 1
		effect.emit(broker.FillExecuted.new(execution))
		this.cashValue := this.cashValue - notional - fee
		this.positionQuantity := quantity
		this.entryPrice := price
		this.entryFee := fee
		this.totalFees := this.totalFees + fee
		this.fills := this.fills + 1
		this.pendingEntryBar := -1
		this.pendingEntryNotional := 0.0
		this.fills

	int emit_exit(float referencePrice, float expectedPrice, int barIndex) =>
		price = math.max(expectedPrice - this.tickSize, this.tickSize)
		quantity = this.positionQuantity
		notional = quantity * price
		fee = notional * this.feeRate
		execution = broker.Fill.new(this.nextFillId, this.nextOrderId, "AI Long Stop", broker.Side.sell, barIndex, referencePrice, price, quantity, notional, fee)
		this.nextFillId := this.nextFillId + 1
		this.nextOrderId := this.nextOrderId + 1
		effect.emit(broker.FillExecuted.new(execution))
		grossPnl = quantity * (price - this.entryPrice)
		this.cashValue := this.cashValue + notional - fee
		this.realizedPnl := this.realizedPnl + grossPnl - this.entryFee - fee
		this.positionQuantity := 0.0
		float empty = na
		this.entryPrice := empty
		this.entryFee := 0.0
		this.activeStop := empty
		this.totalFees := this.totalFees + fee
		this.fills := this.fills + 1
		this.roundTrips := this.roundTrips + 1
		this.fills

	int begin(float openPrice, float lowPrice, int barIndex) =>
		// Market entries resolve first at the next open. A previously submitted
		// exit tied to that entry can then trigger during the same bar.
		if this.pendingEntryBar >= 0 and barIndex > this.pendingEntryBar and this.positionQuantity == 0.0
			this.emit_entry(openPrice, barIndex)
		if this.positionQuantity > 0.0 and not na(this.activeStop)
			if openPrice <= this.activeStop
				this.emit_exit(openPrice, openPrice, barIndex)
			else if lowPrice <= this.activeStop
				this.emit_exit(this.activeStop, this.activeStop, barIndex)
		this.fills

	float update_stop(float stopPrice, bool enabled) =>
		// strategy.exit(when=false) does not replace the existing order. The
		// last submitted stop therefore remains live until fill or replacement.
		if enabled and not na(stopPrice) and (this.positionQuantity > 0.0 or this.pendingEntryBar >= 0)
			this.activeStop := stopPrice
		this.activeStop

	float mark(float closePrice) =>
		this.equityValue := this.cashValue + this.positionQuantity * closePrice
		if this.equityValue > this.peakEquity
			this.peakEquity := this.equityValue
		drawdown = this.peakEquity == 0.0 ? 0.0 : (this.peakEquity - this.equityValue) / this.peakEquity
		if drawdown > this.maximumDrawdown
			this.maximumDrawdown := drawdown
		this.equityValue

	float total_return() const =>
		(this.equityValue - this.initialCash) / this.initialCash

neighbors = input.int(3, "KNN neighbors", minval=1, maxval=100)
data_points = input.int(10, "KNN data points", minval=1, maxval=100)
price_trend_length = input.int(20, "Price WMA length", minval=2, maxval=500)
prediction_trend_length = input.int(100, "SuperTrend WMA length", minval=2, maxval=500)
supertrend_length = input.int(10, "SuperTrend length", minval=1, maxval=200)
supertrend_factor = input.float(3.0, "SuperTrend ATR factor", minval=0.1, maxval=20.0)
initial_cash = input.float(10000.0, "Initial cash", minval=1.0)
allocation_percent = input.float(10.0, "Entry equity percent", minval=0.1, maxval=100.0)
commission_percent = input.float(0.1, "Commission (%)", minval=0.0, maxval=10.0)
tick_size = input.float(0.01, "Instrument tick size", minval=0.00000001)

var engine = LongStopEngine.new(
	initialCash = initial_cash,
	allocationRate = allocation_percent / 100.0,
	tickSize = tick_size,
	feeRate = commission_percent / 100.0,
	cashValue = initial_cash,
	equityValue = initial_cash,
	peakEquity = initial_cash
)

engine.begin(open, low, bar_index)

// The selected published moving-average mode is WMA. Its central SuperTrend
// source is volume-weighted by explicitly smoothing close*volume and volume.
central = ta.wma(close * volume, supertrend_length) / ta.wma(volume, supertrend_length)
atr_value = pine_atr(supertrend_length)
raw_upper = central + supertrend_factor * atr_value
raw_lower = central - supertrend_factor * atr_value
var float lower_band = na
var float upper_band = na
previous_lower = nz(lower_band[1])
previous_upper = nz(upper_band[1])
lower_band := raw_lower > previous_lower or close[1] < previous_lower ? raw_lower : previous_lower
upper_band := raw_upper < previous_upper or close[1] > previous_upper ? raw_upper : previous_upper

var int direction = na
var float supertrend = na
previous_supertrend = supertrend[1]
if na(atr_value[1])
	direction := 1
else if previous_supertrend == previous_upper
	direction := close > upper_band ? -1 : 1
else
	direction := close < lower_band ? 1 : -1
supertrend := direction == -1 ? lower_band : upper_band

price_trend = ta.wma(close, price_trend_length)
prediction_trend = ta.wma(supertrend, prediction_trend_length)
n = math.max(neighbors, data_points)
float missing = na
data = array.new<float>(n, missing)
labels = array.new<int>(n, 0)
for i = 0 to n - 1
	data.set(i, supertrend[i])
	labels.set(i, price_trend[i] > prediction_trend[i] ? 1 : 0)

classification = knn_weighted(data, labels, neighbors, supertrend)
bullish_class = classification == 1.0
bearish_class = classification == 0.0
start_trend_up = bullish_class and not bullish_class[1]
start_trend_down = bearish_class and not bearish_class[1]
trend_up = direction == -1 and direction[1] == 1 and bullish_class
trend_down = direction == 1 and direction[1] == -1 and bearish_class
long_signal = start_trend_up or trend_up
short_signal = start_trend_down or trend_down

aligned_bullish = direction == -1 and bullish_class
aligned_bearish = direction == 1 and bearish_class
// This expression intentionally preserves the source's initialized-false /
// else-if control flow: neither aligned branch enables the long exit update.
long_exit_condition = not aligned_bullish and not aligned_bearish
long_stop = supertrend - atr_value * supertrend_factor

if long_signal and engine.is_flat() and not engine.has_pending_entry()
	engine.submit_entry(bar_index)

engine.update_stop(long_stop, long_exit_condition)
engine.mark(close)

plot(close, "close")
plot(supertrend, "volume supertrend")
plot(classification, "KNN classification")
plot(long_stop, "long stop candidate")
plot(engine.activeStop, "active stop")
plot(long_signal ? 1.0 : 0.0, "long signal")
plot(short_signal ? 1.0 : 0.0, "short signal")
plot(engine.positionQuantity, "position quantity")
plot(engine.equityValue, "equity")
plot(engine.realizedPnl, "realized pnl")
plot(engine.totalFees, "total fees")
plot(engine.fills, "fill count")
plot(engine.roundTrips, "round trips")
plot(engine.maximumDrawdown, "maximum drawdown")
plot(engine.total_return(), "total return")
