//@version=1
// Clean-room long-only historical profile of the public BB SPY mean-reversion
// strategy. It keeps the published stop-entry re-arm and segmented ATR exits.


import broker
import portfolio
import trade

// Keep the selected Pine directional-smoothing contract explicit and
// self-contained in this historical profile.
pine_rma(float source, int length) =>
	seed = ta.sma(source, length)
	var float value = na
	if na(value)
		value := seed
	else
		value := (value * (length - 1.0) + source) / length
	value

pine_dmi(int diLength, int adxSmoothing) =>
	up_move = high - high[1]
	down_move = low[1] - low
	previous_close = close[1]
	true_range = na(previous_close) ? high - low : math.max(high - low, math.max(math.abs(high - previous_close), math.abs(low - previous_close)))
	smoothed_range = pine_rma(true_range, diLength)
	raw_plus = 100.0 * pine_rma(up_move > down_move and up_move > 0.0 ? up_move : 0.0, diLength) / smoothed_range
	raw_minus = 100.0 * pine_rma(down_move > up_move and down_move > 0.0 ? down_move : 0.0, diLength) / smoothed_range
	var float plus = na
	var float minus = na
	plus := na(raw_plus) ? plus : raw_plus
	minus := na(raw_minus) ? minus : raw_minus
	sum = plus + minus
	adx = 100.0 * pine_rma(math.abs(plus - minus) / (sum == 0.0 ? 1.0 : sum), adxSmoothing)
	[plus, minus, adx]

type ConfirmedMonthlyAtr
	float key = na
	float monthHigh = na
	float monthLow = na
	float monthClose = na
	float previousClose = na
	float value = na
	float seedSum = 0.0
	int samples = 0

	float update(float currentKey, float barHigh, float barLow, float barClose, int length) =>
		if not na(this.key) and currentKey != this.key
			monthlyRange = this.monthHigh - this.monthLow
			monthlyTr = na(this.previousClose) ? monthlyRange : math.max(monthlyRange, math.abs(this.monthHigh - this.previousClose), math.abs(this.monthLow - this.previousClose))
			nextSamples = this.samples + 1
			if nextSamples <= length
				this.seedSum := this.seedSum + monthlyTr
				if nextSamples == length
					this.value := this.seedSum / (length * 1.0)
			else
				this.value := (this.value * (length - 1.0) + monthlyTr) / length
			this.samples := nextSamples
			this.previousClose := this.monthClose
		if na(this.key) or currentKey != this.key
			this.key := currentKey
			this.monthHigh := barHigh
			this.monthLow := barLow
			this.monthClose := barClose
		else
			this.monthHigh := math.max(this.monthHigh, barHigh)
			this.monthLow := math.min(this.monthLow, barLow)
			this.monthClose := barClose
		this.value

month_key(int epochMs) =>
	days = math.floor(epochMs / 86400000.0)
	z = days + 719468.0
	era = math.floor(z / 146097.0)
	doe = z - era * 146097.0
	yoe = math.floor((doe - math.floor(doe / 1460.0) + math.floor(doe / 36524.0) - math.floor(doe / 146096.0)) / 365.0)
	year = yoe + era * 400.0
	doy = doe - (365.0 * yoe + math.floor(yoe / 4.0) - math.floor(yoe / 100.0))
	mp = math.floor((5.0 * doy + 2.0) / 153.0)
	month = mp + (mp < 10.0 ? 3.0 : -9.0)
	year := year + (month <= 2.0 ? 1.0 : 0.0)
	year * 12.0 + month

bb_length = input.int(14, "BB length", minval=1, maxval=200)
bb_multiplier = input.float(1.1, "BB multiplier", minval=0.1, maxval=10.0)
long_ema_length = input.int(20, "Long EMA length", minval=1, maxval=200)
short_ema_length = input.int(10, "Short EMA length", minval=1, maxval=200)
minimum_short_adx = input.float(25.0, "Minimum short ADX", minval=0.0, maxval=100.0)
use_adaptive_multiplier = input.int(0, "Adaptive bands: 0 off, 1 on", minval=0, maxval=1)
use_adaptive_signals = input.int(0, "Adaptive signals: 0 off, 1 on", minval=0, maxval=1)
vov_length = input.int(20, "Volatility-of-volatility length", minval=5, maxval=200)
vov_gain = input.float(0.6, "Volatility-of-volatility gain", minval=0.0, maxval=5.0)
vov_scale_min = input.float(0.5, "Minimum adaptive scale", minval=0.1, maxval=5.0)
vov_scale_max = input.float(2.0, "Maximum adaptive scale", minval=0.1, maxval=10.0)
regime_mode = input.int(0, "Regime: 0 none, 1 trend, 2 mean reversion", minval=0, maxval=2)
rank_length = input.int(200, "Regime rank lookback", minval=50, maxval=500)
trend_rank_minimum = input.float(60.0, "Trend width percentile", minval=0.0, maxval=100.0)
slope_length = input.int(10, "Basis slope length", minval=1, maxval=100)
slope_threshold = input.float(0.1, "Normalized slope threshold", minval=0.0, maxval=10.0)
atr_length = input.int(14, "Monthly ATR length", minval=1, maxval=100)
atr_stop_multiple = input.float(1.5, "ATR stop multiple", minval=0.1, maxval=10.0)
atr_target_multiple = input.float(3.0, "ATR target multiple", minval=0.1, maxval=20.0)
break_even_r = input.float(1.0, "Break-even trigger R", minval=0.0, maxval=10.0)
use_time_exit = input.int(0, "Time exit: 0 off, 1 on", minval=0, maxval=1)
minimum_hold_bars = input.int(30, "Minimum hold bars", minval=1, maxval=500)
profit_extension_bars = input.int(15, "Profit extension bars", minval=0, maxval=500)
time_profit_gate_r = input.float(0.25, "Time-exit profit gate R", minval=0.0, maxval=10.0)
allocation_percent = input.float(5.0, "Allocation per entry percent", minval=0.1, maxval=100.0)
initial_cash = input.float(25000.0, "Initial cash", minval=1.0)
fee_rate = input.float(0.0003, "Fee rate", minval=0.0, maxval=0.05)
tick_size = input.float(0.01, "Tick size", minval=0.00000001)
slippage_ticks = input.float(3.0, "Slippage ticks", minval=0.0, maxval=100.0)

var strat = trade.ohlc(
	broker = broker.new(
		commission = broker.commissionRate(fee_rate),
		slippage = broker.slippageTicks(slippage_ticks, tick_size),
		processOrdersOnClose = true
	),
	portfolio = portfolio.new(
		initialCash = initial_cash,
		pyramiding = 1,
		marginLong = 100.0,
		marginShort = 100.0
	)
)
var monthly_atr_state = ConfirmedMonthlyAtr.new()
var int current_bias = 0
var float entry_price_state = na
var int entry_bar = na
float missing_float = na
int missing_int = na

// A change in the bar's month key means the previous month has completed. The
// completed monthly value is published on the first daily row of the new month,
// matching Pine's lookahead_off publication without implicit resampling.
monthly_atr = monthly_atr_state.update(month_key(time), high, low, close, atr_length)

// Resolve the one pending market-or-buy-stop command, then the atomic bracket.
matches = strat.begin_bar(open, high, low, bar_index)
if not na(matches.pending)
	if matches.pending.side == broker.Side.buy
		entry_price_state := matches.pending.price
		entry_bar := bar_index
	else
		entry_price_state := missing_float
		entry_bar := missing_int
if not na(matches.exit)
	entry_price_state := missing_float
	entry_bar := missing_int

basis = ta.sma(close, bb_length)
standard_deviation = ta.stdev(close, bb_length)
upper_band = basis + bb_multiplier * standard_deviation
lower_band = basis - bb_multiplier * standard_deviation
vov = ta.stdev(ta.roc(close, 1), vov_length)
vov_average = ta.sma(vov, vov_length)
vov_ratio = na(vov_average) or vov_average == 0.0 ? 1.0 : vov / vov_average
vov_scale = math.min(math.max(1.0 + vov_gain * (vov_ratio - 1.0), vov_scale_min), vov_scale_max)
effective_multiplier = use_adaptive_multiplier == 1 ? bb_multiplier * vov_scale : bb_multiplier
upper_adaptive = basis + effective_multiplier * standard_deviation
lower_adaptive = basis - effective_multiplier * standard_deviation
signal_upper = use_adaptive_multiplier == 1 and use_adaptive_signals == 1 ? upper_adaptive : upper_band
signal_lower = use_adaptive_multiplier == 1 and use_adaptive_signals == 1 ? lower_adaptive : lower_band

band_width = upper_band - lower_band
width_rank = ta.percentrank(band_width, rank_length)
normalized_slope = band_width == 0.0 ? 0.0 : (basis - basis[slope_length]) / band_width
trend_gate = width_rank > trend_rank_minimum and math.abs(normalized_slope) > slope_threshold
mean_reversion_gate = width_rank < 100.0 - trend_rank_minimum
regime_ok = regime_mode == 0 or regime_mode == 1 and trend_gate or regime_mode == 2 and mean_reversion_gate
[unused_plus, unused_minus, adx_value] = pine_dmi(14, 14)
long_base = ta.crossover(close, signal_lower) and close > open and close > ta.ema(close, long_ema_length)
short_base = ta.crossunder(close, signal_upper) and close < open and close < ta.ema(close, short_ema_length) and adx_value > minimum_short_adx
long_signal = long_base and regime_ok

next_bias = current_bias
if current_bias == 0
	next_bias := long_base ? 1 : short_base ? -1 : 0
else if current_bias == 1 and short_base
	next_bias := -1
else if current_bias == -1 and long_base
	next_bias := 1
current_bias := next_bias

// Time segmentation is an optional published alternative to the ATR bracket.
if use_time_exit == 1 and strat.position_quantity() > 0.0 and not na(entry_bar)
	bars_held = bar_index - entry_bar
	profit_gate = not na(monthly_atr) and close - entry_price_state >= time_profit_gate_r * atr_stop_multiple * monthly_atr
	time_exit_now = bars_held >= minimum_hold_bars and not profit_gate or bars_held >= minimum_hold_bars + profit_extension_bars
	if time_exit_now
		strat.close("BB time exit")
		execution = strat.process_close(close)
		if not na(execution)
			entry_price_state := missing_float
			entry_bar := missing_int

strat.mark(close)

// Keep the published long bias re-armed while flat. A marketable buy stop
// fills on this close because this publication processes orders on close.
want_long = current_bias == 1 and regime_ok and strat.position_quantity() == 0.0
if want_long
	strat.entry(
		"BB long",
		trade.Direction.long,
		sizing = trade.percentOfEquity(allocation_percent, commissionIncluded = true),
		stop = signal_lower
	)
	execution = strat.process_close(close)
	if not na(execution)
		entry_price_state := execution.price
		entry_bar := bar_index
else if current_bias != 1
	strat.cancel("BB long")

if strat.position_quantity() > 0.0 and not na(monthly_atr)
	long_stop_raw = entry_price_state - atr_stop_multiple * monthly_atr
	break_even_on = close - entry_price_state >= break_even_r * atr_stop_multiple * monthly_atr
	active_stop = break_even_on ? math.max(long_stop_raw, entry_price_state) : long_stop_raw
	active_target = entry_price_state + atr_target_multiple * monthly_atr
	// A non-positive stop cannot be reached by valid OHLC prices. Preserve the
	// target leg while omitting that inert stop until its computed level is valid.
	strat.exit("BB ATR exit", fromEntry = "BB long", stop = active_stop > 0.0 ? active_stop : na, target = active_target)

strat.finish(false)
metrics = strat.snapshot()

plot("close", close, "close")
plot("BB basis", basis, "BB basis")
plot("BB upper", upper_band, "BB upper")
plot("BB lower", lower_band, "BB lower")
plot("BB upper adaptive", use_adaptive_multiplier == 1 ? upper_adaptive : na, "BB upper adaptive")
plot("BB lower adaptive", use_adaptive_multiplier == 1 ? lower_adaptive : na, "BB lower adaptive")
plot("confirmed monthly ATR", monthly_atr, "confirmed monthly ATR")
plot("long signal", long_signal ? 1.0 : 0.0, "long signal")
plot("bias", current_bias, "bias")
plot("position quantity", metrics.positionQuantity, "position quantity")
plot("equity", metrics.equity, "equity")
plot("realized pnl", metrics.realizedPnl, "realized pnl")
plot("total fees", metrics.totalFees, "total fees")
plot("fill count", metrics.fillCount, "fill count")
plot("round trips", metrics.roundTripCount, "round trips")
plot("maximum drawdown", metrics.maxDrawdown, "maximum drawdown")
plot("total return", metrics.totalReturn, "total return")
