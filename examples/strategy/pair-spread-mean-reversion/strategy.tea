//@version=1
// Pair-spread mean reversion. Two requested markets form the signal while the
// primary dataset remains the instrument traded by the strategy.
strategy("Pair-spread mean reversion", shorttitle="Pair Spread", overlay=false)

import broker
import portfolio
import strategy

// The published strategy uses a fixed one-contract order, one tick of adverse
// slippage, and a fixed cash commission per contract. BasicBroker sizes orders
// from all available cash and charges a percentage fee, so this example keeps
// the differing execution policy local instead of changing the shared broker.
type FixedContractBroker
	float tickSize
	float slippageTicks
	float commissionPerContract
	float contracts
	int nextOrderId = 1
	int nextFillId = 1
	broker.Order pending = na

	bool has_pending() const =>
		not na(this.pending)

	broker.Order submit(string commandId, broker.Side side, int signalBarIndex) =>
		broker.Order order = na
		if na(this.pending)
			order := broker.Order.new(this.nextOrderId, commandId, side, signalBarIndex)
			this.nextOrderId := this.nextOrderId + 1
			this.pending := order
			effect.emit(broker.OrderSubmitted.new(order))
		else
			effect.emit(broker.OrderRejected.new(commandId, side, signalBarIndex, broker.Rejection.pendingOrder))
		order

	broker.Fill on_open(float referencePrice, float buyingPower, float positionQuantity, int barIndex) =>
		broker.Fill execution = na
		if not na(this.pending)
			order = this.pending
			if barIndex > order.signalBarIndex
				isBuy = order.side == broker.Side.buy
				slippage = this.tickSize * this.slippageTicks
				price = isBuy ? referencePrice + slippage : referencePrice - slippage
				quantity = isBuy ? this.contracts : positionQuantity
				notional = quantity * price
				fee = quantity * this.commissionPerContract
				// The source strategy's published v5 properties use zero margin,
				// so fixed-size entries are not limited by available funds.
				validAccountState = isBuy ? positionQuantity == 0.0 : positionQuantity > 0.0
				if validAccountState and quantity > 0.0 and price > 0.0
					execution := broker.Fill.new(this.nextFillId, order.id, order.commandId, order.side, barIndex, referencePrice, price, quantity, notional, fee)
					this.nextFillId := this.nextFillId + 1
					effect.emit(broker.FillExecuted.new(execution))
				else
					effect.emit(broker.OrderRejected.new(order.commandId, order.side, barIndex, broker.Rejection.invalidAccountState))
				broker.Order empty = na
				this.pending := empty
		execution

	broker.Order finish() =>
		expired = this.pending
		broker.Order empty = na
		this.pending := empty
		if not na(expired)
			effect.emit(broker.OrderExpired.new(expired))
		expired

symbol_one = input.symbol("YM=F", "Spread leg one")
symbol_two = input.symbol("ES=F", "Spread leg two")
spread_timeframe = input.timeframe("D", "Spread timeframe")
mean_length = input.int(20, "Mean length", minval=2, maxval=250)
entry_deviations = input.float(2.0, "Entry deviations", minval=0.1, maxval=10.0)
initial_cash = input.float(30000.0, "Initial cash", minval=1.0)
tick_size = input.float(0.01, "Primary instrument tick size", minval=0.00000001)
slippage_ticks = input.float(1.0, "Adverse slippage in ticks", minval=0.0)
commission_per_contract = input.float(0.05, "Commission per contract", minval=0.0)
contracts = input.float(1.0, "Contracts per entry", minval=0.00000001)

var strat = strategy.configure(
	broker = FixedContractBroker.new(tick_size, slippage_ticks, commission_per_contract, contracts),
	portfolio = portfolio.basic(initial_cash)
)

// Resolve prior-bar orders at the primary instrument's next open.
strat.begin(open, bar_index)

leg_one_close = request.security(symbol_one, spread_timeframe, close)
leg_two_close = request.security(symbol_two, spread_timeframe, close)
spread = leg_one_close - leg_two_close
spread_mean = ta.sma(spread, mean_length)
spread_deviation = ta.stdev(spread, mean_length)
lower_band = spread_mean - entry_deviations * spread_deviation

enter_long = spread < lower_band
exit_long = spread > spread_mean

if enter_long and strat.position_quantity() == 0.0 and not strat.has_pending()
	strat.entry("Spread Long", strategy.Direction.long)

if exit_long and strat.position_quantity() > 0.0 and not strat.has_pending()
	strat.close("Spread Long")

strat.end(close, barstate.islast)

plot(spread, "spread")
plot(spread_mean, "spread mean")
plot(lower_band, "entry threshold")
plot(enter_long ? 1.0 : 0.0, "long signal")
plot(exit_long ? 1.0 : 0.0, "close signal")
plot(strat.position_quantity(), "position quantity")
plot(strat.equity(), "equity")
plot(strat.realized_pnl(), "realized pnl")
plot(strat.total_fees(), "total fees")
plot(strat.fill_count(), "fill count")
plot(strat.round_trip_count(), "round trips")
plot(strat.max_drawdown(), "maximum drawdown")
plot(strat.total_return(), "total return")
