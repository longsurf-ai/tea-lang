//@version=1
// Pair-spread mean reversion. Two requested markets form the signal while the
// primary dataset remains the instrument traded by the strategy.
strategy("Pair-spread mean reversion", shorttitle="Pair Spread", overlay=false)

import broker
import portfolio
import strategy

symbol_one = input.symbol("YM=F", "Spread leg one")
symbol_two = input.symbol("ES=F", "Spread leg two")
spread_timeframe = input.timeframe("D", "Spread timeframe")
mean_length = input.int(20, "Mean length", minval=2, maxval=250)
entry_deviations = input.float(2.0, "Entry deviations", minval=0.1, maxval=10.0)
initial_cash = input.float(30000.0, "Initial cash", minval=1.0)
tick_size = input.float(0.01, "Primary instrument tick size", minval=0.00000001)
slippage_ticks = input.float(1.0, "Adverse slippage in ticks", minval=0.0)
commission_per_contract = input.float(0.05, "Commission per contract", minval=0.0)
contracts = input.float(1.0, "Contracts per entry", minval=0.00000001)

var strat = strategy.configure(
	broker = broker.new(
		commission = broker.commissionCashPerContract(commission_per_contract),
		slippage = broker.slippageTicks(slippage_ticks, tick_size),
		processOrdersOnClose = false
	),
	portfolio = portfolio.new(
		initialCash = initial_cash,
		pyramiding = 1,
		marginLong = 0.0,
		marginShort = 0.0
	)
)

// Resolve prior-bar orders at the primary instrument's next open.
strat.begin(open, bar_index)

leg_one_close = request.security(symbol_one, spread_timeframe, close)
leg_two_close = request.security(symbol_two, spread_timeframe, close)
spread = leg_one_close - leg_two_close
spread_mean = ta.sma(spread, mean_length)
spread_deviation = ta.stdev(spread, mean_length)
lower_band = spread_mean - entry_deviations * spread_deviation

enter_long = spread < lower_band
exit_long = spread > spread_mean

if enter_long and strat.position_quantity() == 0.0 and not strat.has_pending()
	strat.entry("Spread Long", strategy.Direction.long, qty = contracts)

if exit_long and strat.position_quantity() > 0.0 and not strat.has_pending()
	strat.close("Spread Long")

strat.end(close, barstate.islast)

plot(spread, "spread")
plot(spread_mean, "spread mean")
plot(lower_band, "entry threshold")
plot(enter_long ? 1.0 : 0.0, "long signal")
plot(exit_long ? 1.0 : 0.0, "close signal")
plot(strat.position_quantity(), "position quantity")
plot(strat.equity(), "equity")
plot(strat.realized_pnl(), "realized pnl")
plot(strat.total_fees(), "total fees")
plot(strat.fill_count(), "fill count")
plot(strat.round_trip_count(), "round trips")
plot(strat.max_drawdown(), "maximum drawdown")
plot(strat.total_return(), "total return")
