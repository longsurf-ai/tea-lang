type Foo
    int bar
    float f
    bool b
    array<int> arr

struct OrderBook
    array<float> bids
    array<float> asks

match(OrderBook book, float price) =>
    if price > book.bids[0]
        return book.bids[0]
    else
        return book.asks[0]



var float a = close
b = a - a[1]

baz(float a, float b) => a + b

c = baz(a, a[1])


