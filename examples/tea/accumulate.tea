// Independent accumulators and parameter-bound history for inspecting TypeScript lowering.
lag = input.int(1, minval=0, maxval=10)

accumulate(float x) =>
    var float total = 0
    total := total + x
    total

a = accumulate(close)
b = accumulate(open)

emit "output0" a
emit "output1" b
emit "output2" close[lag]
