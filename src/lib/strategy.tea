//@version=1
// Explicit strategy composition. configure(), begin(), entry(), close(), and
// end() are ordinary Tea calls; their behavior comes only from this source.
library("strategy")

import broker
import portfolio

export enum Direction
	long
	short

export enum SizingKind
	percentOfEquity
	percentOfEquityAtFill

export type Sizing
	SizingKind kind
	float value
	bool commissionIncluded = false

// Strategy is a checker-only structural method set for common commands and
// observations. Satisfaction compares receiver modes and full-arity ordered
// parameter/result types; parameter names and defaults are not part of it.
// Commands assume an appropriate lifecycle has already established broker and
// portfolio state, and a concrete configuration may still reject a command.
export interface Strategy
	broker.Order entry(string commandId, Direction direction, float qty, Sizing sizing, float stop)
	broker.Order exit(string commandId, string fromEntry, float stop, float target, bool activateOnEntryBar, float trailPrice, float trailOffset)
	broker.Order close(string commandId)
	broker.Order rebalance(string commandId, broker.PositionTarget target)
	int cancel(string commandId)
	float position_quantity() const
	float position_avg_price() const
	portfolio.PortfolioSnapshot snapshot() const
	bool has_pending() const
	bool has_pending_entry() const

// ConfiguredStrategy is the canonical concrete composition returned by
// configure(). It owns the ergonomic parameter names and defaults used at call
// sites. Its broader method surface reflects the current Broker and Portfolio
// supersets; presence alone does not mean every configured pair supports it.
export type ConfiguredStrategy<B: broker.Broker, P: portfolio.Portfolio>
	B broker
	P portfolio
	int currentBarIndex = -1

	int begin_immediate(int barIndex) =>
		this.currentBarIndex := barIndex
		this.currentBarIndex

	broker.Fill begin(float openPrice, int barIndex) =>
		this.currentBarIndex := barIndex
		currentBroker = this.broker
		currentPortfolio = this.portfolio
		execution = currentBroker.on_open(openPrice, currentPortfolio.account(), this.currentBarIndex)
		currentPortfolio.apply(execution)
		continuation = currentBroker.continue_reversal(currentPortfolio.account(), this.currentBarIndex)
		currentPortfolio.apply(continuation)
		this.broker := currentBroker
		this.portfolio := currentPortfolio
		not na(continuation) ? continuation : execution

	broker.BarMatches begin_primary(float openPrice, float highPrice, float lowPrice, int barIndex) =>
		this.currentBarIndex := barIndex
		currentBroker = this.broker
		currentPortfolio = this.portfolio
		firstExecution = currentBroker.match_pending(openPrice, highPrice, lowPrice, currentPortfolio.account(), this.currentBarIndex)
		currentPortfolio.apply(firstExecution)
		continuation = currentBroker.continue_reversal(currentPortfolio.account(), this.currentBarIndex)
		currentPortfolio.apply(continuation)
		pendingExecution = not na(continuation) ? continuation : firstExecution
		this.broker := currentBroker
		this.portfolio := currentPortfolio
		broker.BarMatches.new(pendingExecution, na, not na(continuation) ? firstExecution : na)

	broker.Fill process_exit(float openPrice, float highPrice, float lowPrice) =>
		currentBroker = this.broker
		currentPortfolio = this.portfolio
		execution = currentBroker.match_exit(openPrice, highPrice, lowPrice, currentPortfolio.account(), this.currentBarIndex)
		currentPortfolio.apply(execution)
		this.broker := currentBroker
		this.portfolio := currentPortfolio
		execution

	broker.BarMatches begin_bar(float openPrice, float highPrice, float lowPrice, int barIndex) =>
		primary = this.begin_primary(openPrice, highPrice, lowPrice, barIndex)
		exitExecution = this.process_exit(openPrice, highPrice, lowPrice)
		broker.BarMatches.new(primary.pending, exitExecution, primary.reversalClose)

	broker.BarMatches begin_path_primary(float openPrice, float highPrice, float lowPrice, float closePrice, int barIndex) =>
		this.currentBarIndex := barIndex
		currentBroker = this.broker
		currentPortfolio = this.portfolio
		firstExecution = currentBroker.match_path_primary(openPrice, highPrice, lowPrice, closePrice, currentPortfolio.account(), this.currentBarIndex)
		currentPortfolio.apply(firstExecution)
		continuation = currentBroker.continue_reversal(currentPortfolio.account(), this.currentBarIndex)
		currentPortfolio.apply(continuation)
		pendingExecution = not na(continuation) ? continuation : firstExecution
		this.broker := currentBroker
		this.portfolio := currentPortfolio
		broker.BarMatches.new(pendingExecution, na, not na(continuation) ? firstExecution : na)

	broker.Fill process_path_exit(float openPrice, float highPrice, float lowPrice, float closePrice) =>
		currentBroker = this.broker
		currentPortfolio = this.portfolio
		execution = currentBroker.match_path_exit(openPrice, highPrice, lowPrice, closePrice, currentPortfolio.account(), this.currentBarIndex)
		currentPortfolio.apply(execution)
		this.broker := currentBroker
		this.portfolio := currentPortfolio
		execution

	broker.BarMatches begin_path(float openPrice, float highPrice, float lowPrice, float closePrice, int barIndex) =>
		primary = this.begin_path_primary(openPrice, highPrice, lowPrice, closePrice, barIndex)
		exitExecution = this.process_path_exit(openPrice, highPrice, lowPrice, closePrice)
		broker.BarMatches.new(primary.pending, exitExecution, primary.reversalClose)

	broker.Order entry(string commandId, Direction direction, float qty = na, Sizing sizing = na, float stop = na) =>
		side = direction == Direction.long ? broker.Side.buy : broker.Side.sell
		broker.Order order = na
		if this.portfolio.supports_open_trades()
			this.broker.reject(commandId, side, this.currentBarIndex, broker.Rejection.invalidAccountState)
			broker.Order noOrder = na
			order := noOrder
		else
			float notional = na
			float cashBudget = na
			float equityPercent = na
			commissionIncluded = false
			if not na(sizing)
				sizingValid = (sizing.kind == SizingKind.percentOfEquity or sizing.kind == SizingKind.percentOfEquityAtFill) and not na(sizing.value) and sizing.value > 0.0 and sizing.value <= 100.0
				if sizing.kind == SizingKind.percentOfEquityAtFill
					commissionIncluded := sizing.commissionIncluded
					equityPercent := sizingValid ? sizing.value : -1.0
				else
					equity = this.portfolio.equity()
					markedSizingValid = sizingValid and not na(equity) and equity > 0.0
					budget = markedSizingValid ? equity * sizing.value / 100.0 : -1.0
					if sizing.commissionIncluded
						cashBudget := budget
					else
						notional := budget
			order := this.broker.submit(broker.Command.new(commandId, broker.CommandKind.entry, side, qty, this.currentBarIndex, notional, na, stop, false, na, cashBudget, equityPercent, commissionIncluded))
		order

	broker.Order exit(string commandId, string fromEntry, float stop = na, float target = na, bool activateOnEntryBar = false, float trailPrice = na, float trailOffset = na) =>
		currentQuantity = this.portfolio.position_quantity()
		side = currentQuantity < 0.0 ? broker.Side.buy : broker.Side.sell
		broker.Order order = na
		if this.portfolio.supports_open_trades()
			this.broker.reject(commandId, side, this.currentBarIndex, broker.Rejection.invalidAccountState)
			broker.Order noOrder = na
			order := noOrder
		else
			order := this.broker.submit_exit(broker.Command.new(commandId, broker.CommandKind.exit, side, na, this.currentBarIndex, na, fromEntry, stop, activateOnEntryBar, target, trailPrice = trailPrice, trailOffset = trailOffset))
		order

	broker.Order close(string commandId) =>
		currentQuantity = this.portfolio.position_quantity()
		side = currentQuantity < 0.0 ? broker.Side.buy : broker.Side.sell
		broker.Order order = na
		if this.portfolio.supports_open_trades()
			this.broker.reject(commandId, side, this.currentBarIndex, broker.Rejection.invalidAccountState)
			broker.Order noOrder = na
			order := noOrder
		else
			order := this.broker.submit(broker.Command.new(commandId, broker.CommandKind.close, side, na, this.currentBarIndex))
		order

	broker.Order rebalance(string commandId, broker.PositionTarget target) =>
		currentQuantity = this.portfolio.position_quantity()
		side = target.value > 0.0 ? broker.Side.buy : target.value < 0.0 ? broker.Side.sell : currentQuantity > 0.0 ? broker.Side.sell : broker.Side.buy
		broker.Order order = na
		if this.portfolio.supports_open_trades()
			this.broker.reject(commandId, side, this.currentBarIndex, broker.Rejection.invalidAccountState)
			broker.Order noOrder = na
			order := noOrder
		else
			order := this.broker.submit(broker.Command.new(commandId, broker.CommandKind.rebalance, side, na, this.currentBarIndex, positionTarget = target))
		order

	int cancel(string commandId) =>
		this.broker.cancel(commandId)

	broker.Fill close_trade(string commandId, int index, float referencePrice) =>
		currentBroker = this.broker
		currentPortfolio = this.portfolio
		broker.Fill execution = na
		if currentPortfolio.supports_open_trades() and index >= 0 and index < currentPortfolio.open_trade_count()
			trade = currentPortfolio.open_trade(index)
			side = trade.entrySide == broker.Side.buy ? broker.Side.sell : broker.Side.buy
			command = broker.Command.new(commandId, broker.CommandKind.close, side, trade.quantity, this.currentBarIndex, tradeId = trade.id)
			execution := currentBroker.execute_now(command, referencePrice, currentPortfolio.account(), this.currentBarIndex)
			currentPortfolio.apply(execution)
		else
			side = currentPortfolio.position_quantity() < 0.0 ? broker.Side.buy : broker.Side.sell
			currentBroker.reject(commandId, side, this.currentBarIndex, broker.Rejection.invalidAccountState)
			broker.Fill noExecution = na
			execution := noExecution
		this.broker := currentBroker
		this.portfolio := currentPortfolio
		execution

	broker.Fill entry_now(string commandId, string reversalCommandId, Direction direction, float referencePrice, float qty = na, float notional = na, int tag = 0, float target = na, float stop = na) =>
		currentBroker = this.broker
		currentPortfolio = this.portfolio
		broker.Fill execution = na
		entrySide = direction == Direction.long ? broker.Side.buy : broker.Side.sell
		if currentPortfolio.supports_open_trades()
			qtyPresent = not na(qty)
			notionalPresent = not na(notional)
			sizeValid = qtyPresent != notionalPresent and (qtyPresent ? qty > 0.0 : notional > 0.0)
			if not sizeValid
				currentBroker.reject(commandId, entrySide, this.currentBarIndex, broker.Rejection.invalidQuantity)
				broker.Fill noExecution = na
				execution := noExecution
			else
				reversalValid = true
				tradeIndex = currentPortfolio.open_trade_count() - 1
				while tradeIndex >= 0 and reversalValid
					trade = currentPortfolio.open_trade(tradeIndex)
					if trade.entrySide != entrySide
						closeSide = trade.entrySide == broker.Side.buy ? broker.Side.sell : broker.Side.buy
						closeCommand = broker.Command.new(reversalCommandId, broker.CommandKind.close, closeSide, trade.quantity, this.currentBarIndex, tradeId = trade.id)
						closeExecution = currentBroker.execute_now(closeCommand, referencePrice, currentPortfolio.account(), this.currentBarIndex)
						currentPortfolio.apply(closeExecution)
						reversalValid := not na(closeExecution)
					tradeIndex := tradeIndex - 1
				if reversalValid
					entryCommand = broker.Command.new(commandId, broker.CommandKind.entry, entrySide, qty, this.currentBarIndex, notional, tradeId = 0)
					execution := currentBroker.execute_now(entryCommand, referencePrice, currentPortfolio.account(), this.currentBarIndex)
					currentPortfolio.apply(execution)
					if not na(execution) and currentPortfolio.open_trade_count() > 0
						openedIndex = currentPortfolio.open_trade_count() - 1
						opened = currentPortfolio.open_trade(openedIndex)
						opened.tag := tag
						opened.targetPrice := target
						opened.stopPrice := stop
						currentPortfolio.update_open_trade(openedIndex, opened)
		else
			currentBroker.reject(commandId, entrySide, this.currentBarIndex, broker.Rejection.invalidAccountState)
			broker.Fill noExecution = na
			execution := noExecution
		this.broker := currentBroker
		this.portfolio := currentPortfolio
		execution

	broker.Fill process_close(float closePrice) =>
		currentBroker = this.broker
		currentPortfolio = this.portfolio
		firstExecution = currentBroker.on_close(closePrice, currentPortfolio.account(), this.currentBarIndex)
		currentPortfolio.apply(firstExecution)
		continuation = currentBroker.continue_reversal(currentPortfolio.account(), this.currentBarIndex)
		currentPortfolio.apply(continuation)
		this.broker := currentBroker
		this.portfolio := currentPortfolio
		not na(continuation) ? continuation : firstExecution

	float mark(float price) =>
		currentPortfolio = this.portfolio
		value = currentPortfolio.mark(price)
		this.portfolio := currentPortfolio
		value

	broker.FinishResult finish(bool isLast) =>
		broker.FinishResult expired = na
		if isLast
			currentBroker = this.broker
			expired := currentBroker.finish()
			this.broker := currentBroker
		expired

	broker.FinishResult end(float closePrice, bool isLast) =>
		currentBroker = this.broker
		currentPortfolio = this.portfolio
		execution = currentBroker.on_close(closePrice, currentPortfolio.account(), this.currentBarIndex)
		currentPortfolio.apply(execution)
		continuation = currentBroker.continue_reversal(currentPortfolio.account(), this.currentBarIndex)
		currentPortfolio.apply(continuation)
		currentPortfolio.mark(closePrice)
		broker.FinishResult expired = na
		if isLast
			expired := currentBroker.finish()
		this.broker := currentBroker
		this.portfolio := currentPortfolio
		expired

	float cash() const =>
		this.portfolio.cash()

	float position_quantity() const =>
		this.portfolio.position_quantity()

	float position_avg_price() const =>
		this.portfolio.position_avg_price()

	int open_trade_count() const =>
		this.portfolio.open_trade_count()

	portfolio.OpenTrade open_trade(int index) const =>
		this.portfolio.open_trade(index)

	int update_open_trade(int index, portfolio.OpenTrade trade) =>
		currentPortfolio = this.portfolio
		updated = currentPortfolio.update_open_trade(index, trade)
		this.portfolio := currentPortfolio
		updated

	int max_long_stack() const =>
		this.portfolio.max_long_stack()

	int max_short_stack() const =>
		this.portfolio.max_short_stack()

	portfolio.PortfolioSnapshot snapshot() const =>
		this.portfolio.snapshot()

	float equity() const =>
		this.portfolio.equity()

	float realized_pnl() const =>
		this.portfolio.realized_pnl()

	float total_fees() const =>
		this.portfolio.total_fees()

	int fill_count() const =>
		this.portfolio.fill_count()

	int round_trip_count() const =>
		this.portfolio.round_trip_count()

	float win_rate() const =>
		this.portfolio.win_rate()

	float profit_factor() const =>
		this.portfolio.profit_factor()

	float max_drawdown() const =>
		this.portfolio.max_drawdown()

	float total_return() const =>
		this.portfolio.total_return()

	bool has_pending() const =>
		this.broker.has_pending()

	bool has_pending_entry() const =>
		this.broker.has_pending_entry()

export percentOfEquity(float percent, bool commissionIncluded = false) =>
	Sizing.new(SizingKind.percentOfEquity, percent, commissionIncluded)

export percentOfEquityAtFill(float percent, bool commissionIncluded = false) =>
	Sizing.new(SizingKind.percentOfEquityAtFill, percent, commissionIncluded)

export targetQuantity(float quantity) =>
	broker.PositionTarget.new(broker.PositionTargetKind.quantity, quantity)

export targetPercentOfEquity(float percent) =>
	broker.PositionTarget.new(broker.PositionTargetKind.percentOfEquity, percent)

export configure(broker, portfolio) =>
	ConfiguredStrategy.new(broker, portfolio)
