//@version=1
// ta: the Tea-authored technical-analysis library. Ordinary Tea functions
// compiled by the ordinary pipeline — nothing here is native, and per-call-
// site state falls out of function semantics (var locals, param history).
// Implicitly imported into every script under its declared name.
//
// Coverage tracks Pine v6's ta.* functions. Not yet expressible:
//   - median, mode, percentile_*, valuewhen: need collections (array slice).
//   - ta.obv, ta.vwap, ta.accdist, ta.pvt, ta.iii, ta.nvi, ta.pvi, ta.wad,
//     ta.wvad, ta.tr (variable form): need exported library variables.
// Functions reading ambient context (volume, high, low, close) directly are
// rejected inside request expressions by design; pass sources as parameters
// where Pine's signature allows it.
library("ta")

// ---- moving averages and smoothing ------------------------------------------

export sma(source, length) =>
	sum = 0.0
	for i = 0 to length - 1
		sum += source[i]
	sum / length

export ema(source, length) =>
	alpha = 2.0 / (length + 1)
	var float e = na
	e := na(e) ? source : alpha * source + (1 - alpha) * e
	e

export rma(source, length) =>
	alpha = 1.0 / length
	var float r = na
	r := na(r) ? source : alpha * source + (1 - alpha) * r
	r

export wma(source, length) =>
	norm = 0.0
	sum = 0.0
	for i = 0 to length - 1
		weight = (length - i) * length
		norm += weight
		sum += source[i] * weight
	sum / norm

export vwma(source, length) =>
	sma(source * volume, length) / sma(volume, length)

export hma(source, length) =>
	wma(2 * wma(source, math.floor(length / 2)) - wma(source, length), math.floor(math.sqrt(length)))

export swma(source) =>
	source[3] / 6 + source[2] * 2 / 6 + source[1] * 2 / 6 + source / 6

export alma(source, length, offset, sigma) =>
	m = offset * (length - 1)
	s = length / sigma
	norm = 0.0
	sum = 0.0
	for i = 0 to length - 1
		weight = math.exp(-math.pow(i - m, 2) / (2 * math.pow(s, 2)))
		norm += weight
		sum += weight * source[length - 1 - i]
	sum / norm

export linreg(source, length, offset) =>
	sumX = 0.0
	sumY = 0.0
	sumXY = 0.0
	sumX2 = 0.0
	for i = 0 to length - 1
		x = float(i)
		y = source[length - 1 - i]
		sumX += x
		sumY += y
		sumXY += x * y
		sumX2 += x * x
	n = float(length)
	slope = (n * sumXY - sumX * sumY) / (n * sumX2 - sumX * sumX)
	intercept = (sumY - slope * sumX) / n
	intercept + slope * (length - 1 - offset)

export cog(source, length) =>
	sum = 0.0
	num = 0.0
	for i = 0 to length - 1
		price = source[i]
		sum += price
		num += price * (i + 1)
	-num / sum

// ---- momentum ---------------------------------------------------------------

export change(source, length = 1) =>
	source - source[length]

export mom(source, length) =>
	source - source[length]

export roc(source, length) =>
	100 * (source - source[length]) / source[length]

export rsi(source, length) =>
	up = rma(math.max(change(source), 0), length)
	down = rma(math.max(-change(source), 0), length)
	down == 0 ? 100.0 : up == 0 ? 0.0 : 100.0 - 100.0 / (1 + up / down)

export cmo(source, length) =>
	sumUp = 0.0
	sumDown = 0.0
	for i = 0 to length - 1
		delta = source[i] - source[i + 1]
		sumUp += math.max(delta, 0)
		sumDown += math.max(-delta, 0)
	100 * (sumUp - sumDown) / (sumUp + sumDown)

export tsi(source, shortLength, longLength) =>
	diff = change(source)
	100 * (ema(ema(diff, longLength), shortLength) / ema(ema(math.abs(diff), longLength), shortLength))

export stoch(source, h, l, length) =>
	lowestLow = lowest(l, length)
	100 * (source - lowestLow) / (highest(h, length) - lowestLow)

export cci(source, length) =>
	mean = sma(source, length)
	md = 0.0
	for i = 0 to length - 1
		md += math.abs(source[i] - mean)
	md /= length
	(source - mean) / (0.015 * md)

export wpr(length) =>
	upper = highest(high, length)
	lower = lowest(low, length)
	100 * (close - upper) / (upper - lower)

export mfi(source, length) =>
	upper = 0.0
	lower = 0.0
	for i = 0 to length - 1
		delta = source[i] - source[i + 1]
		flow = volume[i] * source[i]
		upper += delta > 0 ? flow : 0.0
		lower += delta < 0 ? flow : 0.0
	100.0 - 100.0 / (1.0 + upper / lower)

export macd(source, fastLength, slowLength, signalLength) =>
	fast = ema(source, fastLength)
	slow = ema(source, slowLength)
	macdLine = fast - slow
	signalLine = ema(macdLine, signalLength)
	[macdLine, signalLine, macdLine - signalLine]

export dmi(diLength, adxSmoothing) =>
	up = change(high)
	down = -change(low)
	trur = rma(tr(true), diLength)
	rawPlus = 100 * rma(up > down and up > 0 ? up : 0.0, diLength) / trur
	rawMinus = 100 * rma(down > up and down > 0 ? down : 0.0, diLength) / trur
	var float plus = na
	var float minus = na
	plus := na(rawPlus) ? plus : rawPlus
	minus := na(rawMinus) ? minus : rawMinus
	s = plus + minus
	adx = 100 * rma(math.abs(plus - minus) / (s == 0 ? 1.0 : s), adxSmoothing)
	[plus, minus, adx]

// ---- volatility and channels ------------------------------------------------

export tr(handleNa = true) =>
	prevClose = close[1]
	na(prevClose) ? (handleNa ? high - low : na) : math.max(high - low, math.abs(high - prevClose), math.abs(low - prevClose))

export atr(length) =>
	rma(tr(true), length)

export dev(source, length) =>
	mean = sma(source, length)
	sum = 0.0
	for i = 0 to length - 1
		sum += math.abs(source[i] - mean)
	sum / length

export variance(source, length, biased = true) =>
	mean = sma(source, length)
	sum = 0.0
	for i = 0 to length - 1
		diff = source[i] - mean
		sum += diff * diff
	sum / (biased ? length : length - 1)

export stdev(source, length, biased = true) =>
	math.sqrt(variance(source, length, biased))

export range(source, length) =>
	highest(source, length) - lowest(source, length)

export bb(source, length, mult) =>
	basis = sma(source, length)
	spread = mult * stdev(source, length, true)
	[basis, basis + spread, basis - spread]

export bbw(source, length, mult) =>
	basis = sma(source, length)
	2 * mult * stdev(source, length, true) / basis * 100

export kc(source, length, mult, useTrueRange = true) =>
	basis = ema(source, length)
	span = useTrueRange ? tr(true) : high - low
	spanEma = ema(span, length)
	[basis, basis + spanEma * mult, basis - spanEma * mult]

export kcw(source, length, mult, useTrueRange = true) =>
	[kcMid, kcUp, kcLow] = kc(source, length, mult, useTrueRange)
	(kcUp - kcLow) / kcMid

export supertrend(factor, atrPeriod) =>
	src = hl2
	atrValue = atr(atrPeriod)
	upperBand = src + factor * atrValue
	lowerBand = src - factor * atrValue
	prevLowerBand = nz(lowerBand[1])
	prevUpperBand = nz(upperBand[1])
	lowerBand := lowerBand > prevLowerBand or close[1] < prevLowerBand ? lowerBand : prevLowerBand
	upperBand := upperBand < prevUpperBand or close[1] > prevUpperBand ? upperBand : prevUpperBand
	var int direction = na
	var float superTrend = na
	prevSuperTrend = superTrend[1]
	if na(atrValue[1])
		direction := 1
	else if prevSuperTrend == prevUpperBand
		direction := close > upperBand ? -1 : 1
	else
		direction := close < lowerBand ? 1 : -1
	superTrend := direction == -1 ? lowerBand : upperBand
	[superTrend, direction]

export sar(start, inc, max) =>
	var float result = na
	var float maxMin = na
	var float acceleration = na
	var isBelow = false
	firstTrendBar = false
	if bar_index == 1
		if close > close[1]
			isBelow := true
			maxMin := high
			result := low[1]
		else
			isBelow := false
			maxMin := low
			result := high[1]
		firstTrendBar := true
		acceleration := start
	result := result + acceleration * (maxMin - result)
	if isBelow
		if result > low
			firstTrendBar := true
			isBelow := false
			result := math.max(high, maxMin)
			maxMin := low
			acceleration := start
	else
		if result < high
			firstTrendBar := true
			isBelow := true
			result := math.min(low, maxMin)
			maxMin := high
			acceleration := start
	if not firstTrendBar
		if isBelow
			if high > maxMin
				maxMin := high
				acceleration := math.min(acceleration + inc, max)
		else
			if low < maxMin
				maxMin := low
				acceleration := math.min(acceleration + inc, max)
	if isBelow
		result := math.min(result, low[1])
		if bar_index > 1
			result := math.min(result, low[2])
	else
		result := math.max(result, high[1])
		if bar_index > 1
			result := math.max(result, high[2])
	result

// ---- crosses and conditions -------------------------------------------------

export crossover(source1, source2) =>
	source1 > source2 and source1[1] <= source2[1]

export crossunder(source1, source2) =>
	source1 < source2 and source1[1] >= source2[1]

export cross(source1, source2) =>
	crossover(source1, source2) or crossunder(source1, source2)

export rising(source, length) =>
	result = true
	for i = 0 to length - 1
		result := result and source[i] > source[i + 1]
	result

export falling(source, length) =>
	result = true
	for i = 0 to length - 1
		result := result and source[i] < source[i + 1]
	result

export barssince(condition) =>
	var int count = na
	count := condition ? 0 : na(count) ? na : count + 1
	count

export highest(source, length) =>
	h = source
	for i = 1 to length - 1
		h := math.max(h, source[i])
	h

export lowest(source, length) =>
	l = source
	for i = 1 to length - 1
		l := math.min(l, source[i])
	l

export highestbars(source, length) =>
	best = source
	offsetBars = 0
	for i = 1 to length - 1
		value = source[i]
		if value > best
			best := value
			offsetBars := i
	-offsetBars

export lowestbars(source, length) =>
	worst = source
	offsetBars = 0
	for i = 1 to length - 1
		value = source[i]
		if value < worst
			worst := value
			offsetBars := i
	-offsetBars

export pivothigh(source, leftbars, rightbars) =>
	pivot = source[rightbars]
	confirmed = true
	for i = 0 to leftbars + rightbars
		if i != rightbars and source[i] >= pivot
			confirmed := false
	confirmed ? pivot : na

export pivotlow(source, leftbars, rightbars) =>
	pivot = source[rightbars]
	confirmed = true
	for i = 0 to leftbars + rightbars
		if i != rightbars and source[i] <= pivot
			confirmed := false
	confirmed ? pivot : na

// ---- accumulation and statistics --------------------------------------------

export cum(source) =>
	var total = 0.0
	total += source
	total

export max(source) =>
	var float m = na
	m := na(m) ? source : math.max(m, source)
	m

export min(source) =>
	var float m = na
	m := na(m) ? source : math.min(m, source)
	m

export correlation(source1, source2, length) =>
	mean1 = sma(source1, length)
	mean2 = sma(source2, length)
	cov = 0.0
	dev1 = 0.0
	dev2 = 0.0
	for i = 0 to length - 1
		d1 = source1[i] - mean1
		d2 = source2[i] - mean2
		cov += d1 * d2
		dev1 += d1 * d1
		dev2 += d2 * d2
	cov / math.sqrt(dev1 * dev2)

export percentrank(source, length) =>
	count = 0
	for i = 1 to length
		if source[i] <= source
			count += 1
	100.0 * count / length
