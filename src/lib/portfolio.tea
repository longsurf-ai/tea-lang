//@version=1
// Canonical scalar net-portfolio accounting. It consumes broker.Fill values
// but never decides whether, when, or at what price an order fills.
library("portfolio")

import broker

export interface Portfolio
	broker.Account account() const
	bool is_flat() const
	float buying_power() const
	float position_quantity() const
	float position_avg_price() const
	int apply(broker.Fill execution)
	float mark(float price)
	float cash() const
	float equity() const
	float realized_pnl() const
	float total_fees() const
	int fill_count() const
	int round_trip_count() const
	float win_rate() const
	float profit_factor() const
	float max_drawdown() const
	float total_return() const

export type NetPortfolio
	float initialCash
	int pyramiding
	float marginLong
	float marginShort
	float cashValue = 0.0
	float positionQuantityValue = 0.0
	float entryPrice = na
	float entryNotional = 0.0
	float entryFee = 0.0
	int openEntryCountValue = 0
	float realizedPnlValue = 0.0
	float totalFeesValue = 0.0
	float equityValue = 0.0
	float peakEquity = 0.0
	float maxDrawdownValue = 0.0
	int fillCountValue = 0
	int roundTripCountValue = 0
	float activeTradePnlValue = 0.0
	int winningTradeCountValue = 0
	int losingTradeCountValue = 0
	float grossProfitValue = 0.0
	float grossLossValue = 0.0
	bool targetPositionArithmetic = false

	broker.Account account() const =>
		longMarginValid = this.marginLong == 0.0 or this.marginLong == 100.0
		shortMarginValid = this.marginShort == 0.0 or this.marginShort == 100.0
		configurationValid = this.initialCash > 0.0 and this.pyramiding >= 1 and longMarginValid and shortMarginValid
		broker.Account.new(this.cashValue, this.positionQuantityValue, this.openEntryCountValue, this.pyramiding, this.marginLong, this.marginShort, configurationValid)

	bool is_flat() const =>
		this.positionQuantityValue == 0.0

	float buying_power() const =>
		this.cashValue

	float position_quantity() const =>
		this.positionQuantityValue

	float position_avg_price() const =>
		this.entryPrice

	int apply(broker.Fill execution) =>
		if not na(execution)
			quantityValid = execution.quantity > 0.0
			priceValid = execution.price > 0.0
			feeValid = execution.fee >= 0.0
			if quantityValid and priceValid and feeValid
				delta = execution.side == broker.Side.buy ? execution.quantity : -execution.quantity
				oldQuantity = this.positionQuantityValue
				oldAbsolute = math.abs(oldQuantity)
				sameDirection = oldQuantity == 0.0 or oldQuantity * delta > 0.0
				closedQuantity = sameDirection ? 0.0 : math.min(oldAbsolute, math.abs(delta))
				openedQuantity = sameDirection ? math.abs(delta) : math.max(math.abs(delta) - oldAbsolute, 0.0)
				closeFee = closedQuantity == 0.0 ? 0.0 : execution.fee * closedQuantity / execution.quantity
				openFee = execution.fee - closeFee
				newQuantity = oldQuantity + delta
				if math.abs(newQuantity) <= 0.0000001
					newQuantity := 0.0

				this.cashValue := execution.side == broker.Side.buy ? this.cashValue - execution.notional - execution.fee : this.cashValue + execution.notional - execution.fee

				if closedQuantity > 0.0
					entryFeeShare = oldAbsolute == 0.0 ? 0.0 : this.entryFee * closedQuantity / oldAbsolute
					grossPnl = closedQuantity * (execution.price - this.entryPrice) * (oldQuantity > 0.0 ? 1.0 : -1.0)
					closedPnl = grossPnl - entryFeeShare - closeFee
					if this.targetPositionArithmetic
						this.realizedPnlValue := this.realizedPnlValue + grossPnl - entryFeeShare - closeFee
					else
						tradeFees = entryFeeShare + closeFee
						this.realizedPnlValue := this.realizedPnlValue + grossPnl - tradeFees
					this.activeTradePnlValue := this.activeTradePnlValue + closedPnl
					this.entryFee := this.entryFee - entryFeeShare
					this.entryNotional := oldAbsolute == 0.0 ? 0.0 : this.entryNotional * math.max(oldAbsolute - closedQuantity, 0.0) / oldAbsolute

				closedPosition = oldQuantity != 0.0 and (newQuantity == 0.0 or oldQuantity * newQuantity < 0.0)
				if closedPosition
					this.roundTripCountValue := this.roundTripCountValue + 1
					if this.activeTradePnlValue > 0.0
						this.winningTradeCountValue := this.winningTradeCountValue + 1
						this.grossProfitValue := this.grossProfitValue + this.activeTradePnlValue
					else
						this.losingTradeCountValue := this.losingTradeCountValue + 1
						this.grossLossValue := this.grossLossValue + math.abs(this.activeTradePnlValue)
					this.activeTradePnlValue := 0.0
					this.entryPrice := na
					this.entryNotional := 0.0
					this.entryFee := 0.0
					this.openEntryCountValue := 0
					this.targetPositionArithmetic := false

				if openedQuantity > 0.0
					if sameDirection and oldQuantity != 0.0
						newAbsolute = oldAbsolute + openedQuantity
						this.entryPrice := (oldAbsolute * this.entryPrice + openedQuantity * execution.price) / newAbsolute
						this.entryNotional := this.entryNotional + execution.notional
						this.entryFee := this.entryFee + execution.fee
						if execution.commandKind != broker.CommandKind.rebalance
							this.openEntryCountValue := this.openEntryCountValue + 1
					else
						this.entryPrice := execution.price
						this.entryNotional := openedQuantity * execution.price
						this.entryFee := openFee
						this.targetPositionArithmetic := execution.commandKind == broker.CommandKind.rebalance
						this.openEntryCountValue := 1

				this.positionQuantityValue := newQuantity
				if newQuantity == 0.0
					this.entryPrice := na
					this.entryNotional := 0.0
					this.entryFee := 0.0
					this.openEntryCountValue := 0
					this.targetPositionArithmetic := false

				this.totalFeesValue := this.totalFeesValue + execution.fee
				this.fillCountValue := this.fillCountValue + 1
		this.fillCountValue

	float mark(float price) =>
		this.equityValue := this.cashValue + this.positionQuantityValue * price
		if this.equityValue > this.peakEquity
			this.peakEquity := this.equityValue
		drawdown = this.peakEquity == 0.0 ? 0.0 : (this.peakEquity - this.equityValue) / this.peakEquity
		if drawdown > this.maxDrawdownValue
			this.maxDrawdownValue := drawdown
		this.equityValue

	float cash() const =>
		this.cashValue

	float equity() const =>
		this.equityValue

	float realized_pnl() const =>
		this.realizedPnlValue

	float total_fees() const =>
		this.totalFeesValue

	int fill_count() const =>
		this.fillCountValue

	int round_trip_count() const =>
		this.roundTripCountValue

	float win_rate() const =>
		this.roundTripCountValue == 0 ? 0.0 : float(this.winningTradeCountValue) / float(this.roundTripCountValue)

	float profit_factor() const =>
		this.grossLossValue == 0.0 ? 0.0 : this.grossProfitValue / this.grossLossValue

	float max_drawdown() const =>
		this.maxDrawdownValue

	float total_return() const =>
		this.initialCash == 0.0 ? na : (this.equityValue - this.initialCash) / this.initialCash

export new(
	float initialCash = 1000000.0,
	int pyramiding = 1,
	float marginLong = 100.0,
	float marginShort = 100.0
) =>
	NetPortfolio.new(initialCash = initialCash, pyramiding = pyramiding, marginLong = marginLong, marginShort = marginShort, cashValue = initialCash, equityValue = initialCash, peakEquity = initialCash)

// Compatibility wrapper for the original flat-or-long reference account.
export basic(float initialCash) =>
	new(initialCash = initialCash, pyramiding = 1, marginLong = 100.0, marginShort = 100.0)
