{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": ["string", "comment"]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": ["string", "comment"]
    },
    {
      "open": "/*",
      "close": " */",
      "notIn": ["string"]
    }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:else\\s+)?if\\b.+|else\\b|for\\b.+|while\\b.+|switch(?:\\s+.*)?|(?:export\\s+)?(?:type|struct|interface|enum)\\s+[A-Za-z_][A-Za-z0-9_]*|.*=>)\\s*(?://.*)?$",
    "decreaseIndentPattern": "^\\s*else\\b.*$"
  },
  "folding": {
    "offSide": true
  }
}
