{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "blocked"]
    },
    "summary": {"type": "string", "minLength": 1},
    "changed_files": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "validations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": {"type": "string"},
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "not_run"]
          },
          "details": {"type": "string"}
        },
        "required": ["command", "status", "details"],
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {"type": "string"},
          "documented": {"type": "integer", "minimum": 0},
          "total": {"type": "integer", "minimum": 0}
        },
        "required": ["category", "documented", "total"],
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "remaining": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "required": [
    "status",
    "summary",
    "changed_files",
    "validations",
    "coverage",
    "decisions",
    "remaining"
  ],
  "additionalProperties": false
}
