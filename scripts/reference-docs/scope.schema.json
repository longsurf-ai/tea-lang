{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "target": {
      "type": "object",
      "properties": {
        "languageVersion": {"type": "string", "minLength": 1},
        "policy": {
          "type": "string",
          "enum": ["current", "current-plus-desired"]
        }
      },
      "required": ["languageVersion", "policy"],
      "additionalProperties": false
    },
    "currentScope": {
      "type": "object",
      "properties": {
        "categories": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "types",
              "variables",
              "constants",
              "functions",
              "keywords",
              "operators",
              "annotations"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "sourceOfTruth": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        }
      },
      "required": ["categories", "sourceOfTruth"],
      "additionalProperties": false
    },
    "desiredFeatures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "kind": {
            "type": "string",
            "enum": [
              "type",
              "variable",
              "constant",
              "function",
              "keyword",
              "operator",
              "annotation",
              "language"
            ]
          },
          "specification": {"type": "string", "minLength": 20},
          "acceptance": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1
          },
          "allowedPaths": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1
          },
          "validate": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1
          }
        },
        "required": [
          "id",
          "kind",
          "specification",
          "acceptance",
          "allowedPaths",
          "validate"
        ],
        "additionalProperties": false
      }
    },
    "publicationRules": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    },
    "excludedSymbols": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "reviewRequired": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "allowedPaths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    },
    "approvalGates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "after": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "message": {"type": "string", "minLength": 20}
        },
        "required": ["id", "after", "message"],
        "additionalProperties": false
      }
    },
    "workstreams": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "title": {"type": "string", "minLength": 1},
          "objective": {"type": "string", "minLength": 20},
          "validate": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        },
        "required": ["id", "title", "objective", "validate"],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "version",
    "name",
    "target",
    "currentScope",
    "desiredFeatures",
    "publicationRules",
    "excludedSymbols",
    "reviewRequired",
    "allowedPaths",
    "approvalGates",
    "workstreams"
  ],
  "additionalProperties": false
}
