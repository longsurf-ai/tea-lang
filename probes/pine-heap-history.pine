        writeObservation(results, 13, "map copy source [1]", observedCopyMapSource, valueAt(bar_index - 1, 75), valueAt(bar_index, 75))
        writeObservation(results, 14, "map copy target [1]", observedCopyMapTarget, valueAt(bar_index - 1, 76), valueAt(bar_index, 76))
        writeShallowCopyViewObservation(results, 15, "UDT.copy nested array", observedCopiedWrapperChild, observedOriginalWrapperChild, -1, valueAt(0, 81))
        writeShallowCopyObservation(results, 16, "UDT.copy nested UDT", observedCopiedWrapperNode, valueAt(bar_index, 85), -1)
        writeShallowCopyObservation(results, 17, "array.copy UDT child", observedCopiedArrayNode, valueAt(bar_index, 82), -1)
        writeShallowCopyObservation(results, 18, "matrix.copy UDT child", observedCopiedMatrixNode, valueAt(bar_index, 83), -1)
        writeShallowCopyObservation(results, 19, "map.copy UDT child", observedCopiedMapNode, valueAt(bar_index, 84), -1)
        writeObservation(results, 20, "alternating array ref", observedSelectedArray, valueAt(bar_index - 1, previousSelectedArrayTag), valueAt(bar_index, previousSelectedArrayTag))
        writeObservation(results, 21, "alternating matrix ref", observedSelectedMatrix, valueAt(bar_index - 1, previousSelectedMatrixTag), valueAt(bar_index, previousSelectedMatrixTag))
        writeObservation(results, 22, "alternating map ref", observedSelectedMap, valueAt(bar_index - 1, previousSelectedMapTag), valueAt(bar_index, previousSelectedMapTag))
        writeShallowCopyObservation(results, 23, "array alias owner now", observedAliasArrayOwnerCurrent, observedAliasArrayPeerCurrent, valueAt(0, 61))
        writeShallowCopyObservation(results, 24, "matrix alias owner now", observedAliasMatrixOwnerCurrent, observedAliasMatrixPeerCurrent, valueAt(0, 62))
        writeShallowCopyObservation(results, 25, "map alias owner now", observedAliasMapOwnerCurrent, observedAliasMapPeerCurrent, valueAt(0, 63))
    else if page == "Commit + Thaw"
        writeHeader(results, "COMMIT + THAW")
        writeAlternativeObservation(results, 1, "array final write [1]", observedCommitArray, valueAt(bar_index - 1, 111), valueAt(bar_index, 111), valueAt(bar_index - 1, 101), "EARLY_WRITE")
        writeAlternativeObservation(results, 2, "matrix final write [1]", observedCommitMatrix, valueAt(bar_index - 1, 112), valueAt(bar_index, 112), valueAt(bar_index - 1, 102), "EARLY_WRITE")
        writeAlternativeObservation(results, 3, "map final write [1]", observedCommitMap, valueAt(bar_index - 1, 113), valueAt(bar_index, 113), valueAt(bar_index - 1, 103), "EARLY_WRITE")
        writeAlternativeObservation(results, 4, "array history after copy mutation", observedThawArraySource, valueAt(bar_index - 1, 11), valueAt(bar_index, 11), valueAt(bar_index, 121), "ALIASED_MUTATION")
        writeObservation(results, 5, "array copy before mutation", observedThawArrayCopyBefore, valueAt(bar_index - 1, 11), valueAt(bar_index, 11))
        writeAlternativeObservation(results, 6, "array copy after mutation", observedThawArrayCopy, valueAt(bar_index - 1, 11), valueAt(bar_index, 11), valueAt(bar_index, 121), "MUTATED_COPY")
        writeAlternativeObservation(results, 7, "matrix history after copy mutation", observedThawMatrixSource, valueAt(bar_index - 1, 12), valueAt(bar_index, 12), valueAt(bar_index, 122), "ALIASED_MUTATION")
        writeObservation(results, 8, "matrix copy before mutation", observedThawMatrixCopyBefore, valueAt(bar_index - 1, 12), valueAt(bar_index, 12))
        writeAlternativeObservation(results, 9, "matrix copy after mutation", observedThawMatrixCopy, valueAt(bar_index - 1, 12), valueAt(bar_index, 12), valueAt(bar_index, 122), "MUTATED_COPY")
        writeAlternativeObservation(results, 10, "map history after copy mutation", observedThawMapSource, valueAt(bar_index - 1, 13), valueAt(bar_index, 13), valueAt(bar_index, 123), "ALIASED_MUTATION")
        writeObservation(results, 11, "map copy before mutation", observedThawMapCopyBefore, valueAt(bar_index - 1, 13), valueAt(bar_index, 13))
        writeAlternativeObservation(results, 12, "map copy after mutation", observedThawMapCopy, valueAt(bar_index - 1, 13), valueAt(bar_index, 13), valueAt(bar_index, 123), "MUTATED_COPY")
        writeObservation(results, 13, "long-retained array view", observedLongCapturedArray, valueAt(9, 11), valueAt(bar_index, 11))
        writeObservation(results, 14, "long-retained matrix view", observedLongCapturedMatrix, valueAt(9, 12), valueAt(bar_index, 12))
        writeObservation(results, 15, "long-retained map view", observedLongCapturedMap, valueAt(9, 13), valueAt(bar_index, 13))
        writeAlternativeObservation(results, 16, "UDT history after copy mutation", observedThawNodeSource, valueAt(bar_index - 1, 14), valueAt(bar_index, 14), valueAt(bar_index, 124), "ALIASED_MUTATION")
        writeObservation(results, 17, "UDT copy before mutation", observedThawNodeCopyBefore, valueAt(bar_index - 1, 14), valueAt(bar_index, 14))
        writeAlternativeObservation(results, 18, "UDT copy after mutation", observedThawNodeCopy, valueAt(bar_index - 1, 14), valueAt(bar_index, 14), valueAt(bar_index, 124), "MUTATED_COPY")
        writeObservation(results, 19, "captured UDT view", observedCapturedNode, valueAt(capturedPayloadIndex, 14), valueAt(bar_index, 14))
        writeObservation(results, 20, "long-retained UDT view", observedLongCapturedNode, valueAt(9, 14), valueAt(bar_index, 14))
    else if page == "Request"
        writeRequestHeader(results, frozenRequestParentIndex)
        writeRequestObservation(results, 1, "same-child UDT before mutation", frozenRequestedPristineMarker, valueAt(frozenRequestChildIndex, 131), valueAt(frozenRequestParentIndex, 141), valueAt(frozenRequestParentIndex - 1, 141))
        writeRequestObservation(results, 2, "same-child array before mutation", frozenRequestedPristineArray, valueAt(frozenRequestChildIndex, 132), valueAt(frozenRequestParentIndex, 142), valueAt(frozenRequestParentIndex - 1, 142))
        writeRequestObservation(results, 3, "same-child matrix before mutation", frozenRequestedPristineMatrix, valueAt(frozenRequestChildIndex, 133), valueAt(frozenRequestParentIndex, 143), valueAt(frozenRequestParentIndex - 1, 143))
        writeRequestObservation(results, 4, "same-child map before mutation", frozenRequestedPristineMap, valueAt(frozenRequestChildIndex, 134), valueAt(frozenRequestParentIndex, 144), valueAt(frozenRequestParentIndex - 1, 144))
        writeRequestObservation(results, 5, "same-child nested UDT before mutation", frozenRequestedPristineChild, valueAt(frozenRequestChildIndex, 135), valueAt(frozenRequestParentIndex, 145), valueAt(frozenRequestParentIndex - 1, 145))
        writeRequestObservation(results, 6, "local UDT after mutation", frozenRequestedParentMarker, valueAt(frozenRequestChildIndex, 131), valueAt(frozenRequestParentIndex, 141), valueAt(frozenRequestParentIndex - 1, 141))
        writeRequestObservation(results, 7, "local array after mutation", frozenRequestedParentArray, valueAt(frozenRequestChildIndex, 132), valueAt(frozenRequestParentIndex, 142), valueAt(frozenRequestParentIndex - 1, 142))
        writeRequestObservation(results, 8, "local matrix after mutation", frozenRequestedParentMatrix, valueAt(frozenRequestChildIndex, 133), valueAt(frozenRequestParentIndex, 143), valueAt(frozenRequestParentIndex - 1, 143))
        writeRequestObservation(results, 9, "local map after mutation", frozenRequestedParentMap, valueAt(frozenRequestChildIndex, 134), valueAt(frozenRequestParentIndex, 144), valueAt(frozenRequestParentIndex - 1, 144))
        writeRequestObservation(results, 10, "local nested UDT after mutation", frozenRequestedParentChild, valueAt(frozenRequestChildIndex, 135), valueAt(frozenRequestParentIndex, 145), valueAt(frozenRequestParentIndex - 1, 145))
        writeRequestObservation(results, 11, "previous parent-history UDT", frozenRequestedHistoryMarker, valueAt(frozenRequestChildIndex, 131), valueAt(frozenRequestParentIndex, 141), valueAt(frozenRequestParentIndex - 1, 141))
        writeRequestObservation(results, 12, "previous parent-history array", frozenRequestedHistoryArray, valueAt(frozenRequestChildIndex, 132), valueAt(frozenRequestParentIndex, 142), valueAt(frozenRequestParentIndex - 1, 142))
        writeRequestObservation(results, 13, "previous parent-history matrix", frozenRequestedHistoryMatrix, valueAt(frozenRequestChildIndex, 133), valueAt(frozenRequestParentIndex, 143), valueAt(frozenRequestParentIndex - 1, 143))
        writeRequestObservation(results, 14, "previous parent-history map", frozenRequestedHistoryMap, valueAt(frozenRequestChildIndex, 134), valueAt(frozenRequestParentIndex, 144), valueAt(frozenRequestParentIndex - 1, 144))
        writeRequestObservation(results, 15, "previous parent-history nested UDT", frozenRequestedHistoryChild, valueAt(frozenRequestChildIndex, 135), valueAt(frozenRequestParentIndex, 145), valueAt(frozenRequestParentIndex - 1, 145))
    else if page == "Effects"
        writeEffectHeader(results)
        writeObservation(results, 1, "persistent label ID [1] getter", observedPersistentDrawingX, bar_index - 1, bar_index)
        writeObservation(results, 2, "fresh label ID [1] getter", observedFreshDrawingX, bar_index - 1, bar_index)
        writeEffectObservation(results, 3, "assigned label.new delta", observedAssignedConstructorDelta, 1, "REGISTERED_NOW")
        writeEffectObservation(results, 4, "bare label.new delta", observedBareConstructorDelta, 1, "REGISTERED_NOW")
        writeEffectObservation(results, 5, "reassigned variable delta", observedReassignedConstructorDelta, 2, "TWO_OBJECTS")
        writeEffectObservation(results, 6, "set_x through previous label ID", observedHistoricalSetterX, bar_index + 50, "MUTATED")
        writeEffectObservation(results, 7, "delete previous label ID delta", observedHistoricalDeleteDelta, -1, "DELETED")
    else
        writeLiveHeader(results)
        writeLiveObservation(results, 1, "normal array mutation", array.get(realtimeNormalArray, 0), normalArrayFirst, normalArrayStable, realtimeTicks)
        writeLiveObservation(results, 2, "varip array mutation", array.get(realtimeIntrabarArray, 0), intrabarArrayFirst, intrabarArrayStable, realtimeTicks)
        writeLiveObservation(results, 3, "normal UDT field", realtimeFields.normal, normalFieldFirst, normalFieldStable, realtimeTicks)
        writeLiveObservation(results, 4, "varip UDT field", realtimeFields.intrabar, intrabarFieldFirst, intrabarFieldStable, realtimeTicks)
        writeLiveObservation(results, 5, "mutate through varip alias", array.get(mixedIntrabarAlias, 0), mixedNormalFirst, mixedNormalStable, realtimeTicks)
        writeLiveObservation(results, 6, "mutate through var alias", array.get(mixedNormalAlias, 0), mixedIntrabarFirst, mixedIntrabarStable, realtimeTicks)
        writeLiveObservation(results, 7, "bare label.new effect", array.size(label.all), bareLabelFirst, bareLabelStable, realtimeTicks)
