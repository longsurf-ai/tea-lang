//@version=6
// Purpose: Black-box Pine collection, UDT, alias, history, and rollback semantics.
indicator(
     "Pine heap and history conformance probe",
     overlay = true,
     max_labels_count = 500,
     dynamic_requests = true)

string page = input.string(
     "Core",
     "Results page",
     options = ["Core", "Nesting", "Views", "Alias + Copy", "Commit + Thaw", "Request", "Effects", "Realtime"])
string requestTimeframe = input.timeframe("D", "Request probe timeframe")

type Node
    int marker = -1

type Holder
    int marker
    array<int> arr
    matrix<int> mat
    map<string, int> dict
    Node child

type ArrayWrapper
    array<int> values

type NodeWrapper
    Node child

type GraphHolder
    array<Node> nodes

type RequestBundle
    int childIndex
    int marker
    array<int> values
    matrix<int> matrixValues
    map<string, int> mappedValues
    Node child

type TickFields
    int normal = 0
    varip int intrabar = 0

valueAt(int index, int tag) =>
    index * 1000 + tag

makeRequestBundle() =>
    map<string, int> mappedValues = map.new<string, int>()
    map.put(mappedValues, "k", valueAt(bar_index, 134))
    RequestBundle.new(
         bar_index,
         valueAt(bar_index, 131),
         array.from(valueAt(bar_index, 132)),
         matrix.new<int>(1, 1, valueAt(bar_index, 133)),
         mappedValues,
         Node.new(valueAt(bar_index, 135)))

readArray(array<int> source) =>
    array.get(source, 0)

readMatrix(matrix<int> source) =>
    matrix.get(source, 0, 0)

readMap(map<string, int> source) =>
    map.get(source, "k")

readNode(Node source) =>
    source.marker

observationStatus(int observed, int historical, int current) =>
    string status = "OTHER"
    if na(observed)
        status := "NA"
    else if observed == historical
        status := "HISTORICAL"
    else if observed == current
        status := "CURRENT"
    status

observationColor(int observed, int historical, int current) =>
    color result = color.orange
    if na(observed)
        result := color.gray
    else if observed == historical
        result := color.purple
    else if observed == current
        result := color.blue
    result

writeHeader(table target, string title) =>
    table.cell(target, 0, 0, title + " @" + str.tostring(bar_index), text_color = color.white, bgcolor = color.black, text_size = size.tiny)
    table.cell(target, 1, 0, "OBSERVED", text_color = color.white, bgcolor = color.black, text_size = size.tiny)
    table.cell(target, 2, 0, "HISTORICAL", text_color = color.white, bgcolor = color.black, text_size = size.tiny)
    table.cell(target, 3, 0, "CURRENT", text_color = color.white, bgcolor = color.black, text_size = size.tiny)
    table.cell(target, 4, 0, "CLASS", text_color = color.white, bgcolor = color.black, text_size = size.tiny)

writeLiveHeader(table target) =>
    table.cell(target, 0, 0, "REALTIME @" + str.tostring(bar_index), text_color = color.white, bgcolor = color.black, text_size = size.tiny)
    table.cell(target, 1, 0, "OBSERVED", text_color = color.white, bgcolor = color.black, text_size = size.tiny)
    table.cell(target, 2, 0, "FIRST TICK", text_color = color.white, bgcolor = color.black, text_size = size.tiny)
    table.cell(target, 3, 0, "TICKS", text_color = color.white, bgcolor = color.black, text_size = size.tiny)
    table.cell(target, 4, 0, "CLASS", text_color = color.white, bgcolor = color.black, text_size = size.tiny)

writeEffectHeader(table target) =>
    table.cell(target, 0, 0, "EFFECTS @" + str.tostring(bar_index), text_color = color.white, bgcolor = color.black, text_size = size.tiny)
    table.cell(target, 1, 0, "OBSERVED", text_color = color.white, bgcolor = color.black, text_size = size.tiny)
    table.cell(target, 2, 0, "PAST / EXPECTED", text_color = color.white, bgcolor = color.black, text_size = size.tiny)
    table.cell(target, 3, 0, "NOW / NONE", text_color = color.white, bgcolor = color.black, text_size = size.tiny)
    table.cell(target, 4, 0, "CLASS", text_color = color.white, bgcolor = color.black, text_size = size.tiny)

writeAliasHeader(table target) =>
    table.cell(target, 0, 0, "ALIAS + COPY @" + str.tostring(bar_index), text_color = color.white, bgcolor = color.black, text_size = size.tiny)
    table.cell(target, 1, 0, "OBSERVED", text_color = color.white, bgcolor = color.black, text_size = size.tiny)
    table.cell(target, 2, 0, "PAST / SHARED", text_color = color.white, bgcolor = color.black, text_size = size.tiny)
    table.cell(target, 3, 0, "NOW / INDEPENDENT", text_color = color.white, bgcolor = color.black, text_size = size.tiny)
    table.cell(target, 4, 0, "CLASS", text_color = color.white, bgcolor = color.black, text_size = size.tiny)

writeRequestHeader(table target, int sampleParentIndex) =>
    string title = na(sampleParentIndex) ? "REQUEST: USE 60m / D" : "REQUEST SAME-CHILD @" + str.tostring(sampleParentIndex)
    table.cell(target, 0, 0, title, text_color = color.white, bgcolor = color.black, text_size = size.tiny)
    table.cell(target, 1, 0, "OBSERVED", text_color = color.white, bgcolor = color.black, text_size = size.tiny)
    table.cell(target, 2, 0, "REQUEST VALUE", text_color = color.white, bgcolor = color.black, text_size = size.tiny)
    table.cell(target, 3, 0, "PARENT NOW / PREV", text_color = color.white, bgcolor = color.black, text_size = size.tiny)
    table.cell(target, 4, 0, "CLASS", text_color = color.white, bgcolor = color.black, text_size = size.tiny)

writeObservation(table target, int row, string name, int observed, int historical, int current) =>
    color resultColor = observationColor(observed, historical, current)
    table.cell(target, 0, row, name, text_halign = text.align_left, text_size = size.tiny)
    table.cell(target, 1, row, str.tostring(observed), text_size = size.tiny)
    table.cell(target, 2, row, str.tostring(historical), text_size = size.tiny)
    table.cell(target, 3, row, str.tostring(current), text_size = size.tiny)
    table.cell(target, 4, row, observationStatus(observed, historical, current), text_color = color.white, bgcolor = resultColor, text_size = size.tiny)

writeAlternativeObservation(table target, int row, string name, int observed, int historical, int current, int alternative, string alternativeName) =>
    string status = observationStatus(observed, historical, current)
    color resultColor = observationColor(observed, historical, current)
    if not na(observed) and observed == alternative
        status := alternativeName
        resultColor := color.teal
    table.cell(target, 0, row, name, text_halign = text.align_left, text_size = size.tiny)
    table.cell(target, 1, row, str.tostring(observed), text_size = size.tiny)
    table.cell(target, 2, row, str.tostring(historical), text_size = size.tiny)
    table.cell(target, 3, row, str.tostring(current), text_size = size.tiny)
    table.cell(target, 4, row, status, text_color = color.white, bgcolor = resultColor, text_size = size.tiny)

writeShallowCopyObservation(table target, int row, string name, int observed, int shared, int independent) =>
    string status = "OTHER"
    color resultColor = color.orange
    if na(observed)
        status := "NA"
        resultColor := color.gray
    else if observed == shared
        status := "SHARED"
        resultColor := color.purple
    else if observed == independent
        status := "INDEPENDENT"
        resultColor := color.blue
    table.cell(target, 0, row, name, text_halign = text.align_left, text_size = size.tiny)
    table.cell(target, 1, row, str.tostring(observed), text_size = size.tiny)
    table.cell(target, 2, row, str.tostring(shared), text_size = size.tiny)
    table.cell(target, 3, row, str.tostring(independent), text_size = size.tiny)
    table.cell(target, 4, row, status, text_color = color.white, bgcolor = resultColor, text_size = size.tiny)

writeShallowCopyViewObservation(table target, int row, string name, int observed, int shared, int independent, int initialView) =>
    string status = "OTHER"
    color resultColor = color.orange
    if na(observed)
        status := "NA"
        resultColor := color.gray
    else if observed == shared
        status := "SHARED"
        resultColor := color.purple
    else if observed == independent
        status := "INDEPENDENT"
        resultColor := color.blue
    else if observed == initialView
        status := "INITIAL_VIEW"
        resultColor := color.teal
    table.cell(target, 0, row, name, text_halign = text.align_left, text_size = size.tiny)
    table.cell(target, 1, row, str.tostring(observed), text_size = size.tiny)
    table.cell(target, 2, row, str.tostring(shared), text_size = size.tiny)
    table.cell(target, 3, row, str.tostring(independent), text_size = size.tiny)
    table.cell(target, 4, row, status, text_color = color.white, bgcolor = resultColor, text_size = size.tiny)

writeEffectObservation(table target, int row, string name, int observed, int expected, string expectedName) =>
    string status = "OTHER"
    color resultColor = color.orange
    if na(observed)
        status := "NA"
        resultColor := color.gray
    else if observed == expected
        status := expectedName
        resultColor := color.purple
    else if observed == 0
        status := "NO_EFFECT"
        resultColor := color.blue
    table.cell(target, 0, row, name, text_halign = text.align_left, text_size = size.tiny)
    table.cell(target, 1, row, str.tostring(observed), text_size = size.tiny)
    table.cell(target, 2, row, str.tostring(expected), text_size = size.tiny)
    table.cell(target, 3, row, "0", text_size = size.tiny)
    table.cell(target, 4, row, status, text_color = color.white, bgcolor = resultColor, text_size = size.tiny)

writeRequestObservation(table target, int row, string name, int observed, int childValue, int parentNow, int parentPrevious) =>
    string status = "OTHER"
    color resultColor = color.orange
    if na(observed)
        status := "NA"
        resultColor := color.gray
    else if observed == childValue
        status := "REQUEST_VALUE"
        resultColor := color.purple
    else if observed == parentNow
        status := "PARENT_NOW"
        resultColor := color.blue
    else if observed == parentPrevious
        status := "PARENT_PREV"
        resultColor := color.teal
    table.cell(target, 0, row, name, text_halign = text.align_left, text_size = size.tiny)
    table.cell(target, 1, row, str.tostring(observed), text_size = size.tiny)
    table.cell(target, 2, row, str.tostring(childValue), text_size = size.tiny)
    table.cell(target, 3, row, str.tostring(parentNow) + " / " + str.tostring(parentPrevious), text_size = size.tiny)
    table.cell(target, 4, row, status, text_color = color.white, bgcolor = resultColor, text_size = size.tiny)

writeLiveObservation(table target, int row, string name, int observed, int first, bool stable, int ticks) =>
    string status = "WAIT_REALTIME"
    color resultColor = color.gray
    if barstate.isrealtime
        status := "WAIT_NEXT_TICK"
        if ticks >= 2
            status := "OTHER"
            resultColor := color.orange
            if stable
                status := "ROLLBACK"
                resultColor := color.blue
            else if observed == first + ticks - 1
                status := "PERSISTS"
                resultColor := color.purple
    table.cell(target, 0, row, name, text_halign = text.align_left, text_size = size.tiny)
    table.cell(target, 1, row, str.tostring(observed), text_size = size.tiny)
    table.cell(target, 2, row, "first=" + str.tostring(first), text_size = size.tiny)
    table.cell(target, 3, row, "ticks=" + str.tostring(ticks), text_size = size.tiny)
    table.cell(target, 4, row, status, text_color = color.white, bgcolor = resultColor, text_size = size.tiny)

bool recentWindow = bar_index >= last_bar_index - 5

// Core controls and same-identity collection history.
int scalar = valueAt(bar_index, 1)
int observedScalar = scalar[1]

var array<int> coreArray = array.new<int>(1, -1)
var matrix<int> coreMatrix = matrix.new<int>(1, 1, -1)
var map<string, int> coreMap = map.new<string, int>()

array.set(coreArray, 0, valueAt(bar_index, 11))
matrix.set(coreMatrix, 0, 0, valueAt(bar_index, 12))
map.put(coreMap, "k", valueAt(bar_index, 13))

int observedCoreArray = na
int observedCoreMatrix = na
int observedCoreMap = na
int observedCoreArray2 = na
int observedCoreMatrix2 = na
int observedCoreMap2 = na

if bar_index > 0
    observedCoreArray := array.get(coreArray[1], 0)
    observedCoreMatrix := matrix.get(coreMatrix[1], 0, 0)
    observedCoreMap := map.get(coreMap[1], "k")

if bar_index > 1
    observedCoreArray2 := array.get(coreArray[2], 0)
    observedCoreMatrix2 := matrix.get(coreMatrix[2], 0, 0)
    observedCoreMap2 := map.get(coreMap[2], "k")

// Repeated same-slot writes identify which value becomes the next bar's history.
var array<int> commitArray = array.new<int>(1, -1)
var matrix<int> commitMatrix = matrix.new<int>(1, 1, -1)
var map<string, int> commitMap = map.new<string, int>()

array.set(commitArray, 0, valueAt(bar_index, 101))
matrix.set(commitMatrix, 0, 0, valueAt(bar_index, 102))
map.put(commitMap, "k", valueAt(bar_index, 103))
array.set(commitArray, 0, valueAt(bar_index, 111))
matrix.set(commitMatrix, 0, 0, valueAt(bar_index, 112))
map.put(commitMap, "k", valueAt(bar_index, 113))

int observedCommitArray = na
int observedCommitMatrix = na
int observedCommitMap = na

if bar_index > 0
    observedCommitArray := array.get(commitArray[1], 0)
    observedCommitMatrix := matrix.get(commitMatrix[1], 0, 0)
    observedCommitMap := map.get(commitMap[1], "k")

// Structural history uses bounded alternating shapes rather than unbounded growth.
var array<int> shapeArray = array.new<int>()
var matrix<int> shapeMatrix = matrix.new<int>(1, 1, -1)
var map<string, int> shapeMap = map.new<string, int>()

array.clear(shapeArray)
array.push(shapeArray, bar_index)
if bar_index % 2 == 1
    array.push(shapeArray, bar_index)

if bar_index % 2 == 0
    if matrix.columns(shapeMatrix) == 2
        matrix.remove_col(shapeMatrix, 1)
else if matrix.columns(shapeMatrix) == 1
    matrix.add_col(shapeMatrix, 1, array.from(bar_index))

map.clear(shapeMap)
string currentShapeKey = bar_index % 2 == 0 ? "even" : "odd"
string previousShapeKey = bar_index % 2 == 0 ? "odd" : "even"
map.put(shapeMap, currentShapeKey, bar_index)

int observedArrayShape = na
int observedMatrixShape = na
int observedMapShape = na

if bar_index > 0
    observedArrayShape := array.size(shapeArray[1])
    observedMatrixShape := matrix.columns(shapeMatrix[1])
    observedMapShape := map.contains(shapeMap[1], previousShapeKey) ? 1 : 0

var Node persistentNode = Node.new()
persistentNode.marker := valueAt(bar_index, 14)

int observedPersistentNode = na
if bar_index > 0
    observedPersistentNode := (persistentNode[1]).marker

Node freshNode = na
if recentWindow
    freshNode := Node.new(valueAt(bar_index, 15))

int observedFreshNode = na
if bar_index > 0 and not na(freshNode[1])
    observedFreshNode := (freshNode[1]).marker

// UDT -> persistent collections and UDT -> persistent UDT.
var array<int> holderArray = array.new<int>(1, -1)
var matrix<int> holderMatrix = matrix.new<int>(1, 1, -1)
var map<string, int> holderMap = map.new<string, int>()
var Node holderChild = Node.new()
var Holder persistentHolder = Holder.new(-1, holderArray, holderMatrix, holderMap, holderChild)

persistentHolder.marker := valueAt(bar_index, 20)
array.set(holderArray, 0, valueAt(bar_index, 21))
matrix.set(holderMatrix, 0, 0, valueAt(bar_index, 22))
map.put(holderMap, "k", valueAt(bar_index, 23))
holderChild.marker := valueAt(bar_index, 24)

int observedHolderMarker = na
int observedHolderArray = na
int observedHolderMatrix = na
int observedHolderMap = na
int observedHolderChild = na

if bar_index > 0
    observedHolderMarker := (persistentHolder[1]).marker
    observedHolderArray := array.get((persistentHolder[1]).arr, 0)
    observedHolderMatrix := matrix.get((persistentHolder[1]).mat, 0, 0)
    observedHolderMap := map.get((persistentHolder[1]).dict, "k")
    observedHolderChild := ((persistentHolder[1]).child).marker

// A fresh parent with shared children isolates whether history propagates to children.
Holder freshSharedHolder = na
if recentWindow
    freshSharedHolder := Holder.new(valueAt(bar_index, 25), holderArray, holderMatrix, holderMap, holderChild)

int observedFreshSharedMarker = na
int observedFreshSharedArray = na
int observedFreshSharedMatrix = na
int observedFreshSharedMap = na
int observedFreshSharedChild = na

if bar_index > 0 and not na(freshSharedHolder[1])
    observedFreshSharedMarker := (freshSharedHolder[1]).marker
    observedFreshSharedArray := array.get((freshSharedHolder[1]).arr, 0)
    observedFreshSharedMatrix := matrix.get((freshSharedHolder[1]).mat, 0, 0)
    observedFreshSharedMap := map.get((freshSharedHolder[1]).dict, "k")
    observedFreshSharedChild := ((freshSharedHolder[1]).child).marker

// A fresh parent with fresh children is the old-identity control.
Holder freshFreshHolder = na
if recentWindow
    array<int> freshArray = array.new<int>(1, valueAt(bar_index, 31))
    matrix<int> freshMatrix = matrix.new<int>(1, 1, valueAt(bar_index, 32))
    map<string, int> freshMap = map.new<string, int>()
    map.put(freshMap, "k", valueAt(bar_index, 33))
    Node freshChild = Node.new(valueAt(bar_index, 34))
    freshFreshHolder := Holder.new(valueAt(bar_index, 30), freshArray, freshMatrix, freshMap, freshChild)

int observedFreshFreshArray = na
int observedFreshFreshMatrix = na
int observedFreshFreshMap = na
int observedFreshFreshChild = na

if bar_index > 0 and not na(freshFreshHolder[1])
    observedFreshFreshArray := array.get((freshFreshHolder[1]).arr, 0)
    observedFreshFreshMatrix := matrix.get((freshFreshHolder[1]).mat, 0, 0)
    observedFreshFreshMap := map.get((freshFreshHolder[1]).dict, "k")
    observedFreshFreshChild := ((freshFreshHolder[1]).child).marker

// Collection -> persistent UDT tests whether frozen collection history is shallow.
var Node collectionNode = Node.new()
var array<Node> nodeArray = array.new<Node>(1, collectionNode)
var matrix<Node> nodeMatrix = matrix.new<Node>(1, 1, collectionNode)
var map<string, Node> nodeMap = map.new<string, Node>()

if barstate.isfirst
    map.put(nodeMap, "k", collectionNode)

collectionNode.marker := valueAt(bar_index, 41)

int observedArrayNode = na
int observedMatrixNode = na
int observedMapNode = na

if bar_index > 0
    observedArrayNode := (array.get(nodeArray[1], 0)).marker
    observedMatrixNode := (matrix.get(nodeMatrix[1], 0, 0)).marker
    observedMapNode := (map.get(nodeMap[1], "k")).marker

// A two-edge path checks whether historical context composes across the object graph.
GraphHolder freshGraphHolder = na
if recentWindow
    freshGraphHolder := GraphHolder.new(nodeArray)

int observedFreshGraphNode = na
if bar_index > 0 and not na(freshGraphHolder[1])
    observedFreshGraphNode := (array.get((freshGraphHolder[1]).nodes, 0)).marker

// Replacing the collection element each bar proves whether the old slot ID is frozen.
var array<Node> replacedNodeArray = array.new<Node>(1, collectionNode)
var matrix<Node> replacedNodeMatrix = matrix.new<Node>(1, 1, collectionNode)
var map<string, Node> replacedNodeMap = map.new<string, Node>()

if barstate.isfirst
    map.put(replacedNodeMap, "k", collectionNode)

Node replacementNode = na
if recentWindow
    replacementNode := Node.new(valueAt(bar_index, 42))
    array.set(replacedNodeArray, 0, replacementNode)
    matrix.set(replacedNodeMatrix, 0, 0, replacementNode)
    map.put(replacedNodeMap, "k", replacementNode)

int observedReplacedArrayNode = na
int observedReplacedMatrixNode = na
int observedReplacedMapNode = na

if bar_index > 0
    observedReplacedArrayNode := (array.get(replacedNodeArray[1], 0)).marker
    observedReplacedMatrixNode := (matrix.get(replacedNodeMatrix[1], 0, 0)).marker
    observedReplacedMapNode := (map.get(replacedNodeMap[1], "k")).marker

// Historical view assignment, function transport, second-order history, and escape.
array<int> assignedPastArray = coreArray[1]
matrix<int> assignedPastMatrix = coreMatrix[1]
map<string, int> assignedPastMap = coreMap[1]
Node assignedPastNode = persistentNode[1]

int observedAssignedArray = na
int observedAssignedMatrix = na
int observedAssignedMap = na
int observedFunctionArray = na
int observedFunctionMatrix = na
int observedFunctionMap = na
int observedAssignedNode = na
int observedFunctionNode = na

if bar_index > 0
    observedAssignedArray := array.get(assignedPastArray, 0)
    observedAssignedMatrix := matrix.get(assignedPastMatrix, 0, 0)
    observedAssignedMap := map.get(assignedPastMap, "k")
    observedFunctionArray := readArray(coreArray[1])
    observedFunctionMatrix := readMatrix(coreMatrix[1])
    observedFunctionMap := readMap(coreMap[1])
    observedAssignedNode := assignedPastNode.marker
    observedFunctionNode := readNode(persistentNode[1])

array<int> oneBackArray = coreArray[1]
matrix<int> oneBackMatrix = coreMatrix[1]
map<string, int> oneBackMap = coreMap[1]
array<int> twoBackArray = oneBackArray[1]
matrix<int> twoBackMatrix = oneBackMatrix[1]
map<string, int> twoBackMap = oneBackMap[1]

int observedTwoBackArray = na
int observedTwoBackMatrix = na
int observedTwoBackMap = na

if bar_index > 1
    observedTwoBackArray := array.get(twoBackArray, 0)
    observedTwoBackMatrix := matrix.get(twoBackMatrix, 0, 0)
    observedTwoBackMap := map.get(twoBackMap, "k")

var array<int> capturedArray = na
var matrix<int> capturedMatrix = na
var map<string, int> capturedMap = na
var Node capturedNode = na
var int capturedPayloadIndex = na

if bar_index == last_bar_index - 2
    capturedArray := coreArray[1]
    capturedMatrix := coreMatrix[1]
    capturedMap := coreMap[1]
    capturedNode := persistentNode[1]
    capturedPayloadIndex := bar_index - 1

int observedCapturedArray = na
int observedCapturedMatrix = na
int observedCapturedMap = na
int observedCapturedNode = na

if not na(capturedArray)
    observedCapturedArray := array.get(capturedArray, 0)
    observedCapturedMatrix := matrix.get(capturedMatrix, 0, 0)
    observedCapturedMap := map.get(capturedMap, "k")
    observedCapturedNode := capturedNode.marker

// Keep a much older escaped view separately so retention limits cannot confound escape.
var array<int> longCapturedArray = na
var matrix<int> longCapturedMatrix = na
var map<string, int> longCapturedMap = na
var Node longCapturedNode = na

if bar_index == 10
    longCapturedArray := coreArray[1]
    longCapturedMatrix := coreMatrix[1]
    longCapturedMap := coreMap[1]
    longCapturedNode := persistentNode[1]

int observedLongCapturedArray = na
int observedLongCapturedMatrix = na
int observedLongCapturedMap = na
int observedLongCapturedNode = na

if not na(longCapturedArray)
    observedLongCapturedArray := array.get(longCapturedArray, 0)
    observedLongCapturedMatrix := matrix.get(longCapturedMatrix, 0, 0)
    observedLongCapturedMap := map.get(longCapturedMap, "k")
    observedLongCapturedNode := longCapturedNode.marker

Node temporaryArrayNode = na
int observedTemporaryArrayNode = na
int observedFunctionArrayNode = na

if bar_index > 0
    temporaryArrayNode := array.get(nodeArray[1], 0)
    observedTemporaryArrayNode := temporaryArrayNode.marker
    observedFunctionArrayNode := readNode(array.get(nodeArray[1], 0))

// The documented writable path is to copy a historical view, then mutate the copy.
array<int> thawSourceArray = coreArray[1]
matrix<int> thawSourceMatrix = coreMatrix[1]
map<string, int> thawSourceMap = coreMap[1]
Node thawSourceNode = persistentNode[1]

int observedThawArraySource = na
int observedThawArrayCopyBefore = na
int observedThawArrayCopy = na
int observedThawMatrixSource = na
int observedThawMatrixCopyBefore = na
int observedThawMatrixCopy = na
int observedThawMapSource = na
int observedThawMapCopyBefore = na
int observedThawMapCopy = na
int observedThawNodeSource = na
int observedThawNodeCopyBefore = na
int observedThawNodeCopy = na

if bar_index > 0 and recentWindow
    array<int> thawArrayCopy = array.copy(thawSourceArray)
    matrix<int> thawMatrixCopy = matrix.copy(thawSourceMatrix)
    map<string, int> thawMapCopy = map.copy(thawSourceMap)
    Node thawNodeCopy = thawSourceNode.copy()
    observedThawArrayCopyBefore := array.get(thawArrayCopy, 0)
    observedThawMatrixCopyBefore := matrix.get(thawMatrixCopy, 0, 0)
    observedThawMapCopyBefore := map.get(thawMapCopy, "k")
    observedThawNodeCopyBefore := thawNodeCopy.marker
    array.set(thawArrayCopy, 0, valueAt(bar_index, 121))
    matrix.set(thawMatrixCopy, 0, 0, valueAt(bar_index, 122))
    map.put(thawMapCopy, "k", valueAt(bar_index, 123))
    thawNodeCopy.marker := valueAt(bar_index, 124)
    observedThawArraySource := array.get(thawSourceArray, 0)
    observedThawArrayCopy := array.get(thawArrayCopy, 0)
    observedThawMatrixSource := matrix.get(thawSourceMatrix, 0, 0)
    observedThawMatrixCopy := matrix.get(thawMatrixCopy, 0, 0)
