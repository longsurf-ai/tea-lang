// Realtime rollback and varip persistence. Rows self-label until two live ticks arrive.
varip int realtimeTicks = 0

var array<int> realtimeNormalArray = array.new<int>(1, 0)
varip array<int> realtimeIntrabarArray = array.new<int>(1, 0)
var TickFields realtimeFields = TickFields.new()

var array<int> mixedNormalRoot = array.new<int>(1, 0)
varip array<int> mixedIntrabarAlias = mixedNormalRoot
varip array<int> mixedIntrabarRoot = array.new<int>(1, 0)
var array<int> mixedNormalAlias = mixedIntrabarRoot

varip int normalArrayFirst = na
varip int intrabarArrayFirst = na
varip int normalFieldFirst = na
varip int intrabarFieldFirst = na
varip int mixedNormalFirst = na
varip int mixedIntrabarFirst = na
varip int bareLabelFirst = na

varip bool normalArrayStable = true
varip bool intrabarArrayStable = true
varip bool normalFieldStable = true
varip bool intrabarFieldStable = true
varip bool mixedNormalStable = true
varip bool mixedIntrabarStable = true
varip bool bareLabelStable = true

if barstate.isnew
    realtimeTicks := 0
    normalArrayFirst := na
    intrabarArrayFirst := na
    normalFieldFirst := na
    intrabarFieldFirst := na
    mixedNormalFirst := na
    mixedIntrabarFirst := na
    bareLabelFirst := na
    normalArrayStable := true
    intrabarArrayStable := true
    normalFieldStable := true
    intrabarFieldStable := true
    mixedNormalStable := true
    mixedIntrabarStable := true
    bareLabelStable := true

if page == "Realtime" and barstate.isrealtime
    realtimeTicks += 1
    array.set(realtimeNormalArray, 0, array.get(realtimeNormalArray, 0) + 1)
    array.set(realtimeIntrabarArray, 0, array.get(realtimeIntrabarArray, 0) + 1)
    realtimeFields.normal += 1
    realtimeFields.intrabar += 1
    array.set(mixedIntrabarAlias, 0, array.get(mixedIntrabarAlias, 0) + 1)
    array.set(mixedNormalAlias, 0, array.get(mixedNormalAlias, 0) + 1)
    label.new(bar_index, high, ".", style = label.style_none)

    int normalArrayNow = array.get(realtimeNormalArray, 0)
    int intrabarArrayNow = array.get(realtimeIntrabarArray, 0)
    int normalFieldNow = realtimeFields.normal
    int intrabarFieldNow = realtimeFields.intrabar
    int mixedNormalNow = array.get(mixedIntrabarAlias, 0)
    int mixedIntrabarNow = array.get(mixedNormalAlias, 0)
    int bareLabelNow = array.size(label.all)

    if na(normalArrayFirst)
        normalArrayFirst := normalArrayNow
        intrabarArrayFirst := intrabarArrayNow
        normalFieldFirst := normalFieldNow
        intrabarFieldFirst := intrabarFieldNow
        mixedNormalFirst := mixedNormalNow
        mixedIntrabarFirst := mixedIntrabarNow
        bareLabelFirst := bareLabelNow
    else
        normalArrayStable := normalArrayStable and normalArrayNow == normalArrayFirst
        intrabarArrayStable := intrabarArrayStable and intrabarArrayNow == intrabarArrayFirst
        normalFieldStable := normalFieldStable and normalFieldNow == normalFieldFirst
        intrabarFieldStable := intrabarFieldStable and intrabarFieldNow == intrabarFieldFirst
        mixedNormalStable := mixedNormalStable and mixedNormalNow == mixedNormalFirst
        mixedIntrabarStable := mixedIntrabarStable and mixedIntrabarNow == mixedIntrabarFirst
        bareLabelStable := bareLabelStable and bareLabelNow == bareLabelFirst

