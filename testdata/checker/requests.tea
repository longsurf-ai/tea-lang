//@version=1
indicator("requests")

len = input.int(9)

d1 = request.security("AAPL", "D", close)
d2 = request.security(syminfo.tickerid, "W", ta.ema(close, len), gaps=barmerge.gaps_on)
plot(d1 - d2)

x = close * 2
bad = request.security("A", "D", x) // ERROR request expressions cannot reference script variable 'x'

ctx() =>
	close * 2

viaFunction = request.security("A", "D", ctx())

capturesRoot() =>
	x

bad2 = request.security("A", "D", capturesRoot()) // ERROR reads script variable 'x'

bad3 = request.security("A", "D", plot(close)) // ERROR 'plot' can only be called at the top level
