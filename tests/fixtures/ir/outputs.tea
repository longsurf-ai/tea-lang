//@version=1


p1 = plot("output0", high, "High")
p2 = plot("output1", low, "Low")
fill("output2", p1, p2, color=color.new(color.blue, 90))

hline("output3", 0, "Zero", linestyle=hline.style_dashed)

mid = math.avg(high, low)
plotshape("output4", close > mid, style=shape.triangleup, location=location.abovebar)
