Program version=1
param lookback: int title="Lookback" default=20 depth=none
series close: series float depth=bound
  depth.expr: CallNative math.max pure: input int
    Const 0: const int
    CallNative $historyDepth pure: input int
      Read param:lookback: input int
    Const 3: const int
series open: series float depth=capped
  depth.cap: Const 500: const int
series high: series float depth=none
series low: series float depth=none
builtin bar.bar_index: series int depth=none
output[0] "output0" set: float @ depth.tea:11:1
name a: perBar series float depth=none
name b: perBar series float depth=none
name c: perBar series float depth=none
name hl: perBar series float depth=const(2)
name d: perBar series float depth=none
body:
  Assign
    target: Read name:a: series float
    value: HistRead series:close: series float
      offset: Const 3: const int
  Assign
    target: Read name:b: series float
    value: HistRead series:close: series float
      offset: Read param:lookback: input int
  Assign
    target: Read name:c: series float
    value: HistRead series:open: series float
      offset: Binary Mod: series int
        Read builtin:bar.bar_index: series int
        Const 5: const int
  Assign
    target: Read name:hl: series float
    value: Binary Add: series float
      Read series:high: series float
      Read series:low: series float
  Assign
    target: Read name:d: series float
    value: HistRead name:hl: series float
      offset: Const 2: const int
  Emit output[0]
    value: Binary Add: series float
      Binary Add: series float
        Binary Add: series float
          Read name:a: series float
          Read name:b: series float
        Read name:c: series float
      Read name:d: series float
