//@version=1


import broker
import portfolio
import trade

var strat = trade.nextOpen(
	broker = broker.basic(0.1, 0.1),
	portfolio = portfolio.basic(121.0)
)

strat.begin_bar(open, bar_index)

if bar_index == 0
	strat.entry("Long", trade.Direction.long)
if bar_index == 1
	strat.close("Long")
if bar_index == 2
	strat.entry("Long", trade.Direction.long)

strat.end_bar(close, false)
metrics = strat.snapshot()

emit "output0" strat.cash()
emit "output1" strat.position_quantity()
emit "output2" metrics.equity
emit "output3" metrics.realizedPnl
emit "output4" metrics.totalFees
emit "output5" metrics.fillCount
emit "output6" metrics.roundTripCount
emit "output7" metrics.maxDrawdown
