//@version=6
indicator(
     title            = 's',
     shorttitle       = 'LH-VD',
     overlay          = true,
     max_labels_count = 500,
     max_boxes_count  = 500,
     max_lines_count  = 500
 )
i_lookback   = input.int  (200,  's',   minval = 10,  maxval = 5000, group = g_core)
i_numBins    = input.int  (50,   'Price Bins',        minval = 10,  maxval = 150,  group = g_core,
                            tooltip = 's')
g_tf = 's'
tf2_enabled = input.bool     (true,  'TF 2',  group = g_tf, inline = 'tf2')
tf3_enabled = input.bool     (true,  'TF 3',  group = g_tf, inline = 'tf3')
tf3         = input.timeframe('60',  '',      group = g_tf, inline = 'tf3')
tf4         = input.timeframe('240', '',      group = g_tf, inline = 'tf4')
g_vis = 's'
i_maxWidth   = input.int   (30,    's',         minval = 10, maxval = 120, group = g_vis)
i_volCutoff  = input.float (5.0,   's', minval = 0.0, maxval = 30.0, step = 1.0, group = g_vis,
                             tooltip = 's')
i_showDPoC   = input.bool  (true,  's',    group = g_vis)
i_showZones  = input.bool  (true,  's',  group = g_vis)
i_showDash   = input.bool  (true,  's',          group = g_vis)
i_dashPos    = input.string('Top Right', 's',
                             options = ['Top Right', 'Bottom Right', 'Top Left', 'Bottom Left'],
                             group = g_vis)
i_tolerance = input.float(0.15, 's', minval = 0.01, maxval = 2.0, step = 0.01, group = g_conf)
type HeatBin
    float price     = na
    float cumVol    = 0.0
    float cumDelta  = 0.0
tfToString(simple string tf) =>
    result = switch tf
        '1'   => '1m'
        '3'   => '3m'
        '5'   => '5m'
        '15'  => '15m'
        '30'  => '30m'
        '45'  => '45m'
        '60'  => '1H'
        '120' => '2H'
        '240' => '4H'
        '360' => '6H'
        '480' => '8H'
        '720' => '12H'
        'D'   => '1D'
        'W'   => '1W'
        'M'   => '1M'
        =>       tf
    result
getDashPosition(simple string pos) =>
    result = switch pos
        'Top Right'    => position.top_right
        'Bottom Right' => position.bottom_right
        'Top Left'     => position.top_left
        'Bottom Left'  => position.bottom_left
        =>               position.top_right
    result
[tf1_rLow, tf1_rHigh, tf1_vArr, tf1_dArr] = computeBinData(i_lookback, i_numBins)
[tf2_rLow, tf2_rHigh, tf2_vArr, tf2_dArr] = request.security(
     syminfo.tickerid, tf2, computeBinData(i_lookback, i_numBins),
     gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[tf4_rLow, tf4_rHigh, tf4_vArr, tf4_dArr] = request.security(
     syminfo.tickerid, tf4, computeBinData(i_lookback, i_numBins),
     gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
var MTFState tf1State = MTFState.new(array.new<HeatBin>(0), na, na, false, -1, -1, 0.0, 'Chart')
var MTFState tf3State = MTFState.new(array.new<HeatBin>(0), na, na, false, -1, -1, 0.0, tfToString(tf3))
var MTFState tf4State = MTFState.new(array.new<HeatBin>(0), na, na, false, -1, -1, 0.0, tfToString(tf4))
var array<line>  gLines  = array.new<line>(0)
var array<label> gLabels = array.new<label>(0)
var array<float> compVol    = array.new_float(0)
var array<float> compDelta  = array.new_float(0)
var float prevTF1Poc = na
populateState(MTFState st, float rL, float rH, array<float> vA, array<float> dA, simple int nB, string lbl) =>
    if na(rL) or na(rH) or rH <= rL or vA.size() != nB
        st
    else
        st.bins.clear()
        float binSz = (rH - rL) / nB
        float maxV = 0.0
        float maxDA = 0.0
        int pI = 0
        int dpI = 0
        float pDS = st.prevDSign
        for i = 0 to nB - 1
            float mp = rL + (i + 0.5) * binSz
            float cv = vA.get(i)
            float cd = dA.get(i)
            st.bins.push(HeatBin.new(mp, cv, cd))
            if cv > maxV
                maxV := cv
                pI   := i
            if math.abs(cd) > maxDA
                maxDA := math.abs(cd)
                dpI   := i
        st.pocIdx  := pI
        st.dPocIdx := dpI
        st.pocPrice      := st.bins.get(pI).price
        st.deltaPocPrice := st.bins.get(dpI).price
        st.tfLabel       := lbl
        float cSign = st.bins.get(dpI).cumDelta > 0.0 ? 1.0 : st.bins.get(dpI).cumDelta < 0.0 ? -1.0 : 0.0
        st.pocFlipped    := pDS != 0.0 and cSign != 0.0 and cSign != pDS
        st.prevDSign     := cSign
        st
bool pocBreakoutLong  = not na(tf1State.pocPrice) and not na(prevTF1Poc) and
     close > tf1State.pocPrice and close[1] <= prevTF1Poc
bool pocBreakoutShort = not na(tf1State.pocPrice) and not na(prevTF1Poc) and
     close < tf1State.pocPrice and close[1] >= prevTF1Poc
bool deltaRevBear = tf1State.pocFlipped and tf1State.bins.size() > 0 and
     tf1State.dPocIdx >= 0 and tf1State.dPocIdx < tf1State.bins.size() and
     tf1State.bins.get(tf1State.dPocIdx).cumDelta < 0.0
bool sigPocBrk   = pocBreakoutLong or pocBreakoutShort
if barstate.islast
    int nB = math.max(i_numBins, 10)
    tf1State := populateState(tf1State, tf1_rLow, tf1_rHigh, tf1_vArr, tf1_dArr, nB, 'Chart')
    if tf2_enabled
        tf2State := populateState(tf2State, tf2_rLow, tf2_rHigh, tf2_vArr, tf2_dArr, nB, tfToString(tf2))
    if tf3_enabled
        tf3State := populateState(tf3State, tf3_rLow, tf3_rHigh, tf3_vArr, tf3_dArr, nB, tfToString(tf3))
    if tf4_enabled
        tf4State := populateState(tf4State, tf4_rLow, tf4_rHigh, tf4_vArr, tf4_dArr, nB, tfToString(tf4))
    prevTF1Poc := tf1State.pocPrice
    compPrice.clear()
    compVol.clear()
    compDelta.clear()
    compTFHits.clear()
    if tf1State.bins.size() > 0
        for b in tf1State.bins
            compPrice.push(b.price)
            compVol.push(b.cumVol)
            compDelta.push(b.cumDelta)
            compTFHits.push(b.cumVol > 0.0 ? 1 : 0)
    if tf2_enabled and tf2State.bins.size() > 0
        mergeStateIntoComposite(tf2State)
    if tf3_enabled and tf3State.bins.size() > 0
        mergeStateIntoComposite(tf3State)
    if tf4_enabled and tf4State.bins.size() > 0
        mergeStateIntoComposite(tf4State)
    for b in gBoxes
        box.delete(b)
    gBoxes.clear()
    for l in gLines
        line.delete(l)
    gLines.clear()
    for lb in gLabels
        label.delete(lb)
    gLabels.clear()
    float peakVol = 0.0
    int   pocCompIdx = 0
    float peakAbsDelta = 0.0
    int   dPocCompIdx = 0
    if compVol.size() > 0
        for i = 0 to compVol.size() - 1
            if compVol.get(i) > peakVol
                peakVol    := compVol.get(i)
                pocCompIdx := i
            if math.abs(compDelta.get(i)) > peakAbsDelta
                peakAbsDelta := math.abs(compDelta.get(i))
                dPocCompIdx  := i
    int zCount = math.max(1, int(compVol.size() * i_zoneThresh / 100.0))
    array<float> srtPos = array.new_float(0)
    array<float> srtNeg = array.new_float(0)
    if compDelta.size() > 0
        for i = 0 to compDelta.size() - 1
            float d = compDelta.get(i)
            if d > 0.0
                srtPos.push(d)
            else if d < 0.0
                srtNeg.push(d)
    srtPos.sort(order.descending)
    srtNeg.sort(order.ascending)
    float accThresh  = srtPos.size() >= zCount ? srtPos.get(zCount - 1) : 1e18
    float distThresh = srtNeg.size() >= zCount ? srtNeg.get(zCount - 1) : -1e18
    float binH = compPrice.size() > 1
         ? (compPrice.get(compPrice.size() - 1) - compPrice.get(0)) / (compPrice.size() - 1)
         : syminfo.mintick
    float cutoff = peakVol * i_volCutoff / 100.0
    int xBase = bar_index + i_offset
    if compPrice.size() > 0 and peakVol > 0.0
        for i = 0 to compPrice.size() - 1
            float cv = compVol.get(i)
            float cd = compDelta.get(i)
            float cp = compPrice.get(i)
            int   tf = compTFHits.get(i)
            if cv < cutoff
                continue
            float intensity = math.min(cv / peakVol, 1.0)
            int barWidth = math.max(1, int(intensity * i_maxWidth))
            float top = cp + binH * 0.45
            float bot = cp - binH * 0.45
            int baseTransp = int(80 - intensity * 55)
            baseTransp := math.max(baseTransp, 15)
            color fillCol = cd >= 0.0 ? color.new(#EF5350, baseTransp) : color.new(#42A5F5, baseTransp)
            bool isAcc  = i_showZones and cd >= accThresh  and cd > 0.0
            bool isDist = i_showZones and cd <= distThresh and cd < 0.0
            if isAcc
                fillCol := color.new(#00E676, math.max(baseTransp - 15, 10))
            else if isDist
                fillCol := color.new(#CE93D8, math.max(baseTransp - 15, 10))
            color borderCol = color.new(color.black, 100)
            int   borderW   = 0
            if i_showConf and tf >= 2
                borderCol := switch tf
                    2 => color.new(#FFC107, 40)
                    3 => color.new(#FF9800, 15)
                    4 => color.new(#FF1744,  0)
                    =>   color.new(#FFC107, 40)
                borderW := tf >= 3 ? 2 : 1
            bx = box.new(xBase, top, xBase + barWidth, bot,
                 border_color = borderCol,
                 border_width = borderW,
                 bgcolor      = fillCol)
            gBoxes.push(bx)
        if i_showPoC and pocCompIdx < compPrice.size()
            float pocP = compPrice.get(pocCompIdx)
            pocLine = line.new(bar_index - 20, pocP, xBase + i_maxWidth + 3, pocP,
                 color = color.new(#FFD700, 10),
                 width = 2,
                 style = line.style_solid)
            gLines.push(pocLine)
            pocLbl = label.new(xBase + i_maxWidth + 4, pocP, 'PoC',
                 style     = label.style_label_left,
                 color     = color.new(#FFD700, 20),
                 textcolor = color.black,
                 size      = size.tiny)
            gLabels.push(pocLbl)
        if i_showDPoC and dPocCompIdx < compPrice.size()
            float dPocP = compPrice.get(dPocCompIdx)
            dPocLine = line.new(bar_index - 20, dPocP, xBase + i_maxWidth + 3, dPocP,
                 color = color.new(#00E5FF, 20),
                 width = 1,
                 style = line.style_dashed)
            gLines.push(dPocLine)
            dPocLbl = label.new(xBase + i_maxWidth + 4, dPocP, 'ΔPoC',
                 style     = label.style_label_left,
                 color     = color.new(#00E5FF, 30),
                 textcolor = color.white,
                 size      = size.tiny)
            gLabels.push(dPocLbl)
        string compLabel = 'Composite'
        if tf2_enabled
            compLabel := compLabel + ' + ' + tfToString(tf2)
        if tf3_enabled
            compLabel := compLabel + ' + ' + tfToString(tf3)
        if tf4_enabled
            compLabel := compLabel + ' + ' + tfToString(tf4)
        if compPrice.size() > 0
            cLbl = label.new(
                 xBase + int(i_maxWidth / 2),
                 compPrice.get(0) - binH * 3.0,
                 compLabel,
                 style     = label.style_label_up,
                 color     = color.new(#1A1A2E, 20),
                 textcolor = color.new(color.white, 20),
                 size      = size.tiny)
            gLabels.push(cLbl)
var array<label> sigLabels = array.new<label>(0)
sigLabels.clear()
if pocBreakoutLong
    sigLabels.push(label.new(bar_index, low - syminfo.mintick * 3, '▲ PoC',
         style = label.style_label_up, color = color.new(#00E676, 20),
         textcolor = color.white, size = size.small))
if deltaRevBull
    sigLabels.push(label.new(bar_index, low - syminfo.mintick * 6, 'Δ↑',
         style = label.style_label_up, color = color.new(#00BCD4, 20),
         textcolor = color.white, size = size.small))
if deltaRevBear
    sigLabels.push(label.new(bar_index, high + syminfo.mintick * 6, 'Δ↓',
         style = label.style_label_down, color = color.new(#AA00FF, 20),
         textcolor = color.white, size = size.small))
plot(tf1State.pocPrice,      'Chart PoC',       color = color.new(color.orange, 100), display = display.data_window)
plot(tf1State.deltaPocPrice, 'Chart ΔPoC',      color = color.new(color.aqua,   100), display = display.data_window)
plot(pocBreakoutLong  ? 1 : 0, 'PoC Break L',  color = color.new(color.green,  100), display = display.data_window)
plot(pocBreakoutShort ? 1 : 0, 'PoC Break S',  color = color.new(color.red,    100), display = display.data_window)
alertcondition(
     pocBreakoutLong,
     title   = 's',
     message = 's')
alertcondition(
     pocBreakoutShort,
     title   = 's',
     message = 's')
alertcondition(
     deltaRevBear,
     title   = 's',
     message = 's')
alertcondition(
     pocBreakoutLong or deltaRevBull,
     title   = 's',
     message = 's')
