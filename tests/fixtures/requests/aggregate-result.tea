// Purpose: Checker-rejection fixture for a Heap-backed request result that cannot cross an isolated child-Heap boundary.

//@version=1


type ChildSnapshot
    array<int> values
    int childRow

snapshot = request.security("X", "D", ChildSnapshot.new(array.from(bar_index, bar_index + 100), bar_index))

currentValue = if bar_index > 0
    snapshot.values.get(1)
else
    -1

historicalValue = if bar_index > 1
    snapshot[1].values.get(1)
else
    -1

currentChildRow = if bar_index > 0
    snapshot.childRow
else
    -1

historicalChildRow = if bar_index > 1
    snapshot[1].childRow
else
    -1

emit "output0" currentValue
emit "output1" historicalValue
emit "output2" currentChildRow
emit "output3" historicalChildRow
