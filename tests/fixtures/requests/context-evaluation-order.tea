// Purpose: Rejected fixture — named request context arguments depend on mutable per-row state and must fail before lowering.

//@version=1
indicator("request context evaluation order", dynamic_requests = true)

type ContextOrder
    int calls
    string next(string first, string second) =>
        selected = if this.calls == 0
            first
        else
            second
        this.calls := this.calls + 1
        selected

order = ContextOrder.new(0)
requested = request.security(
    timeframe = order.next("D", "X"),
    expression = close,
    symbol = order.next("D", "X"))

plot(requested, "requested value")
plot(order.calls, "parent context calls")
