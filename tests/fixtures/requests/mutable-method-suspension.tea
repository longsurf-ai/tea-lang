// Purpose: A mutable method that suspends after changing this must roll back its in-place receiver mutation and publish it only after a completed transaction.

//@version=1
indicator("mutable method suspension", dynamic_requests = true)

struct Counter
    int value
    int advance(string symbol) =>
        this.value := this.value + 1
        ignored = request.security(symbol, "D", close)
        this.value

// varip retains completed same-row candidates, so a leaked suspended transaction
// would make the retry increment twice and fail the caller-value assertion.
varip Counter counter = Counter.new(0)
returned = counter.advance(close > 3 ? "X" : "Y")

plot(counter.value, "caller value")
plot(returned, "method result")
