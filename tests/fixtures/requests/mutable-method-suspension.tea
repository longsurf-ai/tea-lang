// Purpose: Rejected fixture — a function-local series request context must fail before runtime mutation or suspension is possible.

//@version=1
indicator("mutable method suspension", dynamic_requests = true)

struct Counter
    int value
    int advance(string symbol) =>
        this.value := this.value + 1
        ignored = request.security(symbol, "D", close)
        this.value

varip Counter counter = Counter.new(0)
returned = counter.advance(close > 3 ? "X" : "Y")

plot(counter.value, "caller value")
plot(returned, "method result")
