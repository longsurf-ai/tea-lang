//@version=1
indicator("qualifiers")

[a, b] = [close, open]

sum2 = a + b

type Point
	float x
	float y = 0.0

pt = Point.new(close)
px = pt.x
pt.y := close

enum Dir
	up = "Up"
	down

d = Dir.up
isup = d == Dir.up

flag = input.bool(false, "Flag")
base = 0.0
if flag
	base := 1.0

s3 = base + 1

[c1, c2] = close // ERROR tuple declaration requires a tuple initializer

e1 = Dir.sideways // ERROR enum 'Dir' has no member 'sideways'

e2 = pt.z // ERROR Point has no field 'z'

pt.x += 1 // ERROR compound assignment to a field is not supported
