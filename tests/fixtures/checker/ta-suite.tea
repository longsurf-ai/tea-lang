//@version=1


len = input.int(14, "Length")

emit "output0" ta.sma(close, len)
emit "output1" ta.ema(close, len)
emit "output2" ta.rma(close, len)
emit "output3" ta.wma(close, len)
emit "output4" ta.hma(close, len)
emit "output5" ta.vwma(close, len)
emit "output6" ta.swma(close)
emit "output7" ta.alma(close, 9, 0.85, 6.0)
emit "output8" ta.linreg(close, len, 0)
emit "output9" ta.cog(close, len)

emit "output10" ta.change(close)
emit "output11" ta.change(close, 2)
emit "output12" ta.mom(close, len)
emit "output13" ta.roc(close, len)
emit "output14" ta.rsi(close, len)
emit "output15" ta.cmo(close, len)
emit "output16" ta.tsi(close, 13, 25)
emit "output17" ta.stoch(close, high, low, len)
emit "output18" ta.cci(close, len)
emit "output19" ta.wpr(len)
emit "output20" ta.mfi(hlc3, len)

[macdLine, signalLine, histLine] = ta.macd(close, 12, 26, 9)
emit "output21" macdLine + signalLine + histLine
[diPlus, diMinus, adx] = ta.dmi(14, 14)
emit "output22" diPlus + diMinus + adx

emit "output23" ta.tr(true)
emit "output24" ta.tr(false)
emit "output25" ta.atr(len)
emit "output26" ta.dev(close, len)
emit "output27" ta.variance(close, len)
emit "output28" ta.stdev(close, len, false)
emit "output29" ta.range(close, len)
[bbMid, bbUp, bbLow] = ta.bb(close, 20, 2.0)
emit "output30" bbMid + bbUp + bbLow
emit "output31" ta.bbw(close, 20, 2.0)
[kcMid, kcUp, kcLow] = ta.kc(close, 20, 1.5)
emit "output32" kcMid + kcUp + kcLow
emit "output33" ta.kcw(close, 20, 1.5, false)
[st, stDir] = ta.supertrend(3.0, 10)
emit "output34" st + stDir
emit "output35" ta.sar(0.02, 0.02, 0.2)

plotshape("output36", ta.crossover(close, open))
plotshape("output37", ta.crossunder(close, open))
plotshape("output38", ta.cross(close, open))
plotshape("output39", ta.rising(close, 3))
plotshape("output40", ta.falling(close, 3))
emit "output41" ta.barssince(close > open)
emit "output42" ta.highest(close, len)
emit "output43" ta.lowest(close, len)
emit "output44" ta.highestbars(close, len)
emit "output45" ta.lowestbars(close, len)
emit "output46" ta.pivothigh(high, 2, 2)
emit "output47" ta.pivotlow(low, 2, 2)

emit "output48" ta.cum(volume)
emit "output49" ta.max(close)
emit "output50" ta.min(close)
emit "output51" ta.correlation(close, open, len)
emit "output52" ta.percentrank(close, len)
