//@version=1
indicator("ta suite")

len = input.int(14, "Length")

plot(ta.sma(close, len))
plot(ta.ema(close, len))
plot(ta.rma(close, len))
plot(ta.wma(close, len))
plot(ta.hma(close, len))
plot(ta.vwma(close, len))
plot(ta.swma(close))
plot(ta.alma(close, 9, 0.85, 6.0))
plot(ta.linreg(close, len, 0))
plot(ta.cog(close, len))

plot(ta.change(close))
plot(ta.change(close, 2))
plot(ta.mom(close, len))
plot(ta.roc(close, len))
plot(ta.rsi(close, len))
plot(ta.cmo(close, len))
plot(ta.tsi(close, 13, 25))
plot(ta.stoch(close, high, low, len))
plot(ta.cci(close, len))
plot(ta.wpr(len))
plot(ta.mfi(hlc3, len))

[macdLine, signalLine, histLine] = ta.macd(close, 12, 26, 9)
plot(macdLine + signalLine + histLine)
[diPlus, diMinus, adx] = ta.dmi(14, 14)
plot(diPlus + diMinus + adx)

plot(ta.tr(true))
plot(ta.tr(false))
plot(ta.atr(len))
plot(ta.dev(close, len))
plot(ta.variance(close, len))
plot(ta.stdev(close, len, false))
plot(ta.range(close, len))
[bbMid, bbUp, bbLow] = ta.bb(close, 20, 2.0)
plot(bbMid + bbUp + bbLow)
plot(ta.bbw(close, 20, 2.0))
[kcMid, kcUp, kcLow] = ta.kc(close, 20, 1.5)
plot(kcMid + kcUp + kcLow)
plot(ta.kcw(close, 20, 1.5, false))
[st, stDir] = ta.supertrend(3.0, 10)
plot(st + stDir)
plot(ta.sar(0.02, 0.02, 0.2))

plotshape(ta.crossover(close, open))
plotshape(ta.crossunder(close, open))
plotshape(ta.cross(close, open))
plotshape(ta.rising(close, 3))
plotshape(ta.falling(close, 3))
plot(ta.barssince(close > open))
plot(ta.highest(close, len))
plot(ta.lowest(close, len))
plot(ta.highestbars(close, len))
plot(ta.lowestbars(close, len))
plot(ta.pivothigh(high, 2, 2))
plot(ta.pivotlow(low, 2, 2))

plot(ta.cum(volume))
plot(ta.max(close))
plot(ta.min(close))
plot(ta.correlation(close, open, len))
plot(ta.percentrank(close, len))
