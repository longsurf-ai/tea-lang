//@version=1


len = input.int(9)

d1 = request.security("AAPL", "D", close)
d2 = request.security(syminfo.tickerid, "W", ta.ema(close, len), fill="sparse")
emit "output0" d1 - d2

x = close * 2
bad = request.security("A", "D", x) // ERROR request expressions cannot reference script variable 'x'

ctx() =>
	close * 2

viaFunction = request.security("A", "D", ctx())

capturesRoot() =>
	x

bad2 = request.security("A", "D", capturesRoot()) // ERROR reads script variable 'x'

bad3 = request.security("A", "D", plot("output1", close)) // ERROR cannot call 'emit' inside a request expression
