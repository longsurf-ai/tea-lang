//@version=1


len = input.int(14, "Length")

emit "output0" ta.sma(close, len)
emit "output1" ta.ema(close, len)
emit "output2" ta.rma(close, len)
emit "output3" ta.wma(close, len)
emit "output4" ta.vwma(close, len)
emit "output5" ta.swma(close)
emit "output6" ta.alma(close, 9, 0.85, 6.0)
emit "output7" ta.linreg(close, len, 0)
emit "output8" ta.cog(close, len)
emit "output9" ta.change(close)
emit "output10" ta.mom(close, 5)
emit "output11" ta.roc(close, 5)
emit "output12" ta.rsi(close, len)
emit "output13" ta.cmo(close, len)
emit "output14" ta.tsi(close, 5, 8)
emit "output15" ta.stoch(close, high, low, len)
emit "output16" ta.cci(close, len)
emit "output17" ta.wpr(len)
emit "output18" ta.mfi(hlc3, len)
[macdLine, signalLine, histLine] = ta.macd(close, 5, 8, 3)
emit "output19" macdLine
emit "output20" signalLine
emit "output21" histLine
[diPlus, diMinus, adx] = ta.dmi(len, len)
emit "output22" diPlus
emit "output23" diMinus
emit "output24" adx
emit "output25" ta.tr(true)
emit "output26" ta.atr(len)
emit "output27" ta.dev(close, len)
emit "output28" ta.variance(close, len)
emit "output29" ta.stdev(close, len, false)
emit "output30" ta.range(close, len)
[bbMid, bbUp, bbLow] = ta.bb(close, len, 2.0)
emit "output31" bbMid + bbUp + bbLow
emit "output32" ta.bbw(close, len, 2.0)
[kcMid, kcUp, kcLow] = ta.kc(close, len, 1.5)
emit "output33" kcMid + kcUp + kcLow
emit "output34" ta.kcw(close, len, 1.5, false)
[st, stDir] = ta.supertrend(3.0, 10)
emit "output35" st
emit "output36" stDir
emit "output37" ta.sar(0.02, 0.02, 0.2)
plotshape("output38", ta.crossover(close, open), "crossover")
plotshape("output39", ta.crossunder(close, open), "crossunder")
plotshape("output40", ta.cross(close, open), "cross")
plotshape("output41", ta.rising(close, 3), "rising")
plotshape("output42", ta.falling(close, 3), "falling")
emit "output43" ta.barssince(close > open)
emit "output44" ta.highest(close, len)
emit "output45" ta.lowest(close, len)
emit "output46" ta.highestbars(close, len)
emit "output47" ta.lowestbars(close, len)
emit "output48" ta.pivothigh(high, 2, 2)
emit "output49" ta.pivotlow(low, 2, 2)
emit "output50" ta.cum(volume)
emit "output51" ta.max(close)
emit "output52" ta.min(close)
emit "output53" ta.correlation(close, open, len)
emit "output54" ta.percentrank(close, len)
