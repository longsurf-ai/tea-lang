//@version=1
indicator("ta coverage")

len = input.int(14, "Length")

plot(ta.sma(close, len), "sma")
plot(ta.ema(close, len), "ema")
plot(ta.rma(close, len), "rma")
plot(ta.wma(close, len), "wma")
plot(ta.vwma(close, len), "vwma")
plot(ta.swma(close), "swma")
plot(ta.alma(close, 9, 0.85, 6.0), "alma")
plot(ta.linreg(close, len, 0), "linreg")
plot(ta.cog(close, len), "cog")
plot(ta.change(close), "change")
plot(ta.mom(close, 5), "mom")
plot(ta.roc(close, 5), "roc")
plot(ta.rsi(close, len), "rsi")
plot(ta.cmo(close, len), "cmo")
plot(ta.tsi(close, 5, 8), "tsi")
plot(ta.stoch(close, high, low, len), "stoch")
plot(ta.cci(close, len), "cci")
plot(ta.wpr(len), "wpr")
plot(ta.mfi(hlc3, len), "mfi")
[macdLine, signalLine, histLine] = ta.macd(close, 5, 8, 3)
plot(macdLine, "macd")
plot(signalLine, "signal")
plot(histLine, "hist")
[diPlus, diMinus, adx] = ta.dmi(len, len)
plot(diPlus, "diPlus")
plot(diMinus, "diMinus")
plot(adx, "adx")
plot(ta.tr(true), "tr")
plot(ta.atr(len), "atr")
plot(ta.dev(close, len), "dev")
plot(ta.variance(close, len), "variance")
plot(ta.stdev(close, len, false), "stdev")
plot(ta.range(close, len), "range")
[bbMid, bbUp, bbLow] = ta.bb(close, len, 2.0)
plot(bbMid + bbUp + bbLow, "bb")
plot(ta.bbw(close, len, 2.0), "bbw")
[kcMid, kcUp, kcLow] = ta.kc(close, len, 1.5)
plot(kcMid + kcUp + kcLow, "kc")
plot(ta.kcw(close, len, 1.5, false), "kcw")
[st, stDir] = ta.supertrend(3.0, 10)
plot(st, "supertrend")
plot(stDir, "stDir")
plot(ta.sar(0.02, 0.02, 0.2), "sar")
plotshape(ta.crossover(close, open), "crossover")
plotshape(ta.crossunder(close, open), "crossunder")
plotshape(ta.cross(close, open), "cross")
plotshape(ta.rising(close, 3), "rising")
plotshape(ta.falling(close, 3), "falling")
plot(ta.barssince(close > open), "barssince")
plot(ta.highest(close, len), "highest")
plot(ta.lowest(close, len), "lowest")
plot(ta.highestbars(close, len), "highestbars")
plot(ta.lowestbars(close, len), "lowestbars")
plot(ta.pivothigh(high, 2, 2), "pivothigh")
plot(ta.pivotlow(low, 2, 2), "pivotlow")
plot(ta.cum(volume), "cum")
plot(ta.max(close), "max")
plot(ta.min(close), "min")
plot(ta.correlation(close, open, len), "correlation")
plot(ta.percentrank(close, len), "percentrank")
